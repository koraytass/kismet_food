# Monitor — Environment Variables
# Copy this to .env and fill in your values

# ─── Database ───────────────────────────────
# Get from https://neon.tech (free tier, no credit card)
DATABASE_URL=postgresql+asyncpg://user:password@host/monitor

# ─── Anthropic ──────────────────────────────
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ─── Security ───────────────────────────────
# Change this to something memorable — it's your dashboard login password
DASHBOARD_PASSWORD=your-private-password-here
APP_SECRET_KEY=change-this-random-string

# ─── Optional tuning ────────────────────────
DEBUG=false

# Alert thresholds (DIS score 0-100)
ALERT_THRESHOLD_DIS=55
CRITICAL_THRESHOLD_DIS=75

# Scraper intervals in minutes
INTERVAL_NEWS=120      # RSS feeds: every 2 hours
INTERVAL_WEATHER=60    # Weather: every hour
INTERVAL_REPORTS=360   # Web scraping: every 6 hours
INTERVAL_SYNTHESIS=360 # AI briefs: every 6 hours
