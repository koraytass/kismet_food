---
/**
 * CorpNav — LDC-grade fixed top nav.
 * Beyaz/transparan, scroll'da solid; logo + 7 link + dil + Quote CTA.
 * Mobilde sade slide-in panel.
 */
import type { Locale } from '@/i18n';
import { localePath, locales, localeConfig } from '@/i18n';

interface Props {
  locale: Locale;
  currentPath?: string;
}

const { locale, currentPath = '/' } = Astro.props;

const links = [
  { label: { tr: 'Hakkımızda', en: 'About', ar: 'من نحن' },           href: localePath('/about/', locale) },
  { label: { tr: 'Ürünler',    en: 'Products', ar: 'المنتجات' },     href: localePath('/products/', locale) },
  { label: { tr: 'Menşe',      en: 'Origins', ar: 'المنشأ' },         href: localePath('/origins/', locale) },
  { label: { tr: 'Tedarik',    en: 'Supply', ar: 'التوريد' },         href: localePath('/supply-chain/', locale) },
  { label: { tr: 'Sürdürülebilirlik', en: 'Sustainability', ar: 'الاستدامة' }, href: localePath('/sustainability/', locale) },
  { label: { tr: 'Analizler',  en: 'Insights', ar: 'تحليلات' },      href: localePath('/insights/', locale) },
  { label: { tr: 'Kariyer',    en: 'Careers', ar: 'الوظائف' },        href: localePath('/careers/', locale) },
];

const segments = currentPath.split('/').filter(Boolean);
const baseSeg = (locales as readonly string[]).includes(segments[0]) ? '/' + segments.slice(1).join('/') : currentPath;
const basePath = baseSeg.endsWith('/') ? baseSeg : baseSeg + '/';

const ctaLabel = { tr: 'Teklif Al', en: 'Request a Quote', ar: 'طلب عرض' }[locale];
const menuLabel = { tr: 'Menü', en: 'Menu', ar: 'قائمة' }[locale];
const closeLabel = { tr: 'Kapat', en: 'Close', ar: 'إغلاق' }[locale];
---

<header class="co-nav" id="coNav">
  <div class="co-nav__bar">
    <a href={localePath('/', locale)} class="co-nav__brand" aria-label="Kismet Foods">
      <img src="/logos/logo-teal.svg" alt="" width="44" height="44" class="co-nav__logo" />
      <span class="co-nav__brand-text">
        <span class="co-nav__name">Kismet Foods</span>
        <span class="co-nav__sub">Global Commodity Merchant</span>
      </span>
    </a>

    <nav class="co-nav__center" aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label[locale]}</a>)}
    </nav>

    <div class="co-nav__right">
      <div class="co-nav__lang" aria-label="Language">
        {locales.map((lc, i) => (
          <>
            {i > 0 && <span class="co-nav__lang-sep">·</span>}
            <a href={localePath(basePath, lc)} hreflang={localeConfig[lc].hreflang} class:list={['co-nav__lang-item', lc === locale && 'is-active']}>{lc.toUpperCase()}</a>
          </>
        ))}
      </div>
      <a href={localePath('/contact/request-quote/', locale)} class="co-btn co-btn--amber co-nav__cta">{ctaLabel}</a>
      <button id="coMenuOpen" type="button" class="co-nav__hamburger" aria-label={menuLabel}>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="co-mobile" id="coMobileMenu" aria-hidden="true">
  <div class="co-mobile__head">
    <span class="co-eyebrow co-eyebrow--ink">{menuLabel}</span>
    <button id="coMenuClose" type="button" class="co-mobile__close" aria-label={closeLabel}>{closeLabel} ×</button>
  </div>
  <nav class="co-mobile__list" aria-label="Mobile">
    {links.map((l) => <a href={l.href}>{l.label[locale]}</a>)}
  </nav>
  <div class="co-mobile__foot">
    <a href={localePath('/contact/request-quote/', locale)} class="co-btn co-btn--amber">{ctaLabel}</a>
    <div class="co-nav__lang">
      {locales.map((lc, i) => (
        <>
          {i > 0 && <span class="co-nav__lang-sep">·</span>}
          <a href={localePath(basePath, lc)} class:list={['co-nav__lang-item', lc === locale && 'is-active']}>{lc.toUpperCase()}</a>
        </>
      ))}
    </div>
  </div>
</div>

<style>
  .co-nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 60;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: saturate(140%) blur(8px);
    border-bottom: 1px solid transparent;
    transition: border-color 220ms ease, background 220ms ease, padding 220ms ease;
  }
  .co-nav.is-scrolled {
    border-bottom-color: var(--co-line);
    background: var(--co-white);
  }
  .co-nav__bar {
    max-width: var(--co-col);
    margin: 0 auto;
    padding: 16px var(--co-gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    transition: padding 220ms ease;
  }
  .co-nav.is-scrolled .co-nav__bar { padding-block: 12px; }

  .co-nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--co-ink);
    text-decoration: none;
    transition: opacity 220ms ease;
  }
  .co-nav__brand:hover { opacity: 0.8; }
  .co-nav__logo {
    width: 38px;
    height: auto;
    display: block;
    transition: width 220ms ease;
  }
  .co-nav.is-scrolled .co-nav__logo { width: 32px; }
  .co-nav__brand-text { display: flex; flex-direction: column; line-height: 1; }
  .co-nav__name {
    font-family: var(--co-sans);
    font-weight: 700;
    font-size: 17px;
    letter-spacing: -0.015em;
    color: var(--co-navy);
  }
  .co-nav__sub {
    font-family: var(--co-sans);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--co-mute);
    margin-top: 4px;
  }

  .co-nav__center {
    display: none;
    gap: 28px;
    font-family: var(--co-sans);
    font-size: 14px;
    font-weight: 500;
  }
  .co-nav__center a {
    color: var(--co-text);
    text-decoration: none;
    padding-block: 4px;
    border-bottom: 2px solid transparent;
    transition: color 200ms ease, border-color 200ms ease;
  }
  .co-nav__center a:hover {
    color: var(--co-navy);
    border-bottom-color: var(--co-amber);
  }

  .co-nav__right {
    display: inline-flex;
    align-items: center;
    gap: 16px;
  }
  .co-nav__lang {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--co-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--co-mute);
  }
  .co-nav__lang-item {
    color: inherit;
    text-decoration: none;
    transition: color 200ms ease;
  }
  .co-nav__lang-item.is-active, .co-nav__lang-item:hover { color: var(--co-navy); }
  .co-nav__lang-sep { color: var(--co-mute-2); }

  .co-nav__cta { display: none !important; padding: 10px 18px !important; font-size: 12px !important; }
  .co-nav__hamburger {
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
    width: 22px;
    background: transparent;
    border: 0;
    padding: 8px 0;
    cursor: pointer;
  }
  .co-nav__hamburger span {
    display: block;
    height: 2px;
    background: var(--co-ink);
    width: 100%;
  }
  .co-nav__hamburger span:nth-child(2) { width: 70%; }

  @media (min-width: 1080px) {
    .co-nav__center { display: inline-flex; }
    .co-nav__cta { display: inline-flex !important; }
    .co-nav__hamburger { display: none; }
  }

  /* Mobile overlay */
  .co-mobile {
    position: fixed;
    inset: 0;
    z-index: 70;
    background: var(--co-white);
    transform: translateX(100%);
    transition: transform 320ms cubic-bezier(0.22, 0.72, 0.22, 1);
    display: flex;
    flex-direction: column;
    padding: 20px var(--co-gutter);
  }
  .co-mobile.is-open { transform: translateX(0); }
  .co-mobile__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--co-line);
  }
  .co-mobile__close {
    background: transparent;
    border: 0;
    font-family: var(--co-sans);
    font-size: 13px;
    font-weight: 600;
    color: var(--co-ink);
    cursor: pointer;
  }
  .co-mobile__list {
    display: flex;
    flex-direction: column;
    margin-top: 24px;
  }
  .co-mobile__list a {
    padding: 18px 0;
    font-family: var(--co-sans);
    font-size: 28px;
    font-weight: 600;
    color: var(--co-ink);
    letter-spacing: -0.02em;
    text-decoration: none;
    border-bottom: 1px solid var(--co-line);
  }
  .co-mobile__foot {
    margin-top: auto;
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
</style>

<script is:inline>
  (function () {
    const nav = document.getElementById('coNav');
    if (nav) {
      const onScroll = () => nav.classList.toggle('is-scrolled', window.scrollY > 12);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }
    const m = document.getElementById('coMobileMenu');
    const open = document.getElementById('coMenuOpen');
    const close = document.getElementById('coMenuClose');
    if (m && open && close) {
      open.addEventListener('click', () => {
        m.classList.add('is-open');
        m.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      });
      const closeFn = () => {
        m.classList.remove('is-open');
        m.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      };
      close.addEventListener('click', closeFn);
      m.querySelectorAll('a').forEach(a => a.addEventListener('click', closeFn));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeFn(); });
    }
  })();
</script>
