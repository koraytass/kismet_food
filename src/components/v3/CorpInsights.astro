---
/**
 * CorpInsights — 3 article kart + arşiv linki.
 * Annual-report magazin görünümü; her kart küçük foto + tarih + başlık + ledge.
 */
import type { Locale } from '@/i18n';
import { localePath } from '@/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;

const ui = {
  tr: {
    eyebrow: 'GÖRÜŞ & PİYASA',
    title: 'Editör masamızdan.',
    lede: 'Aylık piyasa raporları, çiftçi portreleri ve regülasyon yorumları. Yatırımcı ve alıcı tarafına aynı veri.',
    cta: 'Tüm yayınları gör',
    items: [
      { date: '04 May 2026', cat: 'Piyasa Raporu', t: 'Arabica fiyatlarında 18 aylık zirve: 2026 hasat sezonu.', read: '12 dk' },
      { date: '21 Nis 2026', cat: 'Saha',           t: 'Antep’te üç nesil: bir fıstık ailesinin portresi.',     read: '8 dk' },
      { date: '15 Nis 2026', cat: 'Regülasyon',    t: 'EU EUDR Aralık 2024 sonrası: ilk altı ayın bilançosu.', read: '14 dk' },
    ],
  },
  en: {
    eyebrow: 'INSIGHTS & MARKETS',
    title: 'From the editor’s desk.',
    lede: 'Monthly market reports, farmer portraits and regulation commentary. The same data set for investors and buyers.',
    cta: 'View all publications',
    items: [
      { date: '04 May 2026', cat: 'Market Report', t: '18-month high in arabica prices: 2026 harvest outlook.', read: '12 min' },
      { date: '21 Apr 2026', cat: 'Field',         t: 'Three generations in Antep: portrait of a pistachio family.', read: '8 min' },
      { date: '15 Apr 2026', cat: 'Regulation',    t: 'After EU EUDR Dec 2024: a six-month balance sheet.', read: '14 min' },
    ],
  },
  ar: {
    eyebrow: 'تحليلات وأسواق',
    title: 'من مكتب التحرير.',
    lede: 'تقارير سوقية شهرية وصور للمزارعين وتعليقات تنظيمية. نفس البيانات للمستثمرين والمشترين.',
    cta: 'كل المنشورات',
    items: [
      { date: '٠٤ مايو ٢٠٢٦', cat: 'تقرير سوق', t: 'أعلى مستوى لأسعار العربيكا منذ ١٨ شهراً: توقعات حصاد ٢٠٢٦.', read: '١٢ د' },
      { date: '٢١ أبريل ٢٠٢٦', cat: 'ميدان',     t: 'ثلاثة أجيال في عنتاب: صورة لعائلة فستق.', read: '٨ د' },
      { date: '١٥ أبريل ٢٠٢٦', cat: 'تنظيم',     t: 'بعد EU EUDR ديسمبر ٢٠٢٤: حصاد ستة أشهر.', read: '١٤ د' },
    ],
  },
}[locale];

const photos = [
  'https://images.unsplash.com/photo-1495774472287-4d71bcdd2085?auto=format&fit=crop&w=1200&q=80',
  'https://images.unsplash.com/photo-1599639957043-f3aa5c986398?auto=format&fit=crop&w=1200&q=80',
  'https://images.unsplash.com/photo-1481070414801-51fd732d7184?auto=format&fit=crop&w=1200&q=80',
];
---

<section class="co-section co-ins" id="insights">
  <div class="co-wrap">
    <header class="co-ins__head">
      <div>
        <span class="co-eyebrow">{ui.eyebrow}</span>
        <h2 class="co-h-display">{ui.title}</h2>
      </div>
      <p class="co-lede co-ins__lede">{ui.lede}</p>
    </header>

    <div class="co-ins__grid">
      {ui.items.map((it, i) => (
        <a class="co-ins__card" href={localePath('/insights/', locale)}>
          <figure class="co-ins__img">
            <img src={photos[i]} alt={it.t} loading="lazy" decoding="async" />
          </figure>
          <div class="co-ins__copy">
            <div class="co-ins__meta">
              <span class="co-eyebrow co-eyebrow--ink">{it.cat}</span>
              <span class="co-ins__date">{it.date} · {it.read}</span>
            </div>
            <h3 class="co-h3 co-ins__t">{it.t}</h3>
            <span class="co-link">
              <span>{ui.cta.replace('Tüm yayınları gör', 'Devamı').replace('View all publications', 'Read').replace('كل المنشورات', 'اقرأ')}</span>
              <span class="co-link__arrow" aria-hidden="true">→</span>
            </span>
          </div>
        </a>
      ))}
    </div>

    <div class="co-ins__foot">
      <a href={localePath('/insights/', locale)} class="co-btn co-btn--primary">
        {ui.cta} <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .co-ins__head {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    margin-bottom: 56px;
  }
  @media (min-width: 1024px) {
    .co-ins__head {
      grid-template-columns: 1.4fr 1fr;
      gap: 80px;
      align-items: end;
    }
  }
  .co-ins__lede { padding-bottom: 4px; }

  .co-ins__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  @media (min-width: 760px) { .co-ins__grid { grid-template-columns: repeat(3, 1fr); } }

  .co-ins__card {
    display: flex;
    flex-direction: column;
    background: var(--co-white);
    border: 1px solid var(--co-line);
    text-decoration: none;
    color: var(--co-text);
    transition: border-color 220ms ease, box-shadow 220ms ease, transform 220ms ease;
  }
  .co-ins__card:hover {
    border-color: var(--co-navy);
    box-shadow: 0 32px 56px -28px rgba(12, 37, 69, 0.18);
    transform: translateY(-2px);
  }
  .co-ins__img { margin: 0; aspect-ratio: 16 / 10; overflow: hidden; background: var(--co-stone); }
  .co-ins__img img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 700ms cubic-bezier(0.22, 0.72, 0.22, 1);
  }
  .co-ins__card:hover .co-ins__img img { transform: scale(1.04); }

  .co-ins__copy { padding: 24px; display: flex; flex-direction: column; gap: 14px; }
  .co-ins__meta { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .co-ins__date {
    font-family: var(--co-sans);
    font-size: 12px;
    font-weight: 500;
    color: var(--co-mute);
  }
  .co-ins__t { color: var(--co-ink); font-size: 22px; line-height: 1.25; }

  .co-ins__foot { margin-top: 56px; display: flex; justify-content: center; }
</style>
