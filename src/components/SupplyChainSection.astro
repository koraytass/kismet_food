---
/**
 * SupplyChainSection — Logistics integrity with stat card + checklist.
 * Uses surface-mid background to define region via color shift (No-Line rule).
 */
import type { Locale } from '@/i18n';
import { t } from '@/i18n';
import { stockImages } from '@/lib/images';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
const img = stockImages.supply;
---

<section id="supply" class="overflow-hidden bg-surface-mid py-24 md:py-32">
  <div class="mx-auto max-w-7xl px-6 md:px-8">
    <div class="grid grid-cols-1 items-center gap-16 lg:grid-cols-2 lg:gap-20">
      {/* Map / visual */}
      <div class="relative">
        <div
          class="relative flex aspect-square items-center justify-center rounded-full bg-outline/20 p-8"
        >
          <img
            src={img.src}
            alt={img.alt[locale]}
            class="h-full w-full rounded-full object-cover opacity-80 mix-blend-multiply"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
            <span class="absolute inline-flex h-4 w-4 animate-ping rounded-full bg-teal opacity-70"></span>
            <span class="inline-flex h-4 w-4 rounded-full bg-teal"></span>
          </div>
        </div>

        {/* Stats floating card */}
        <div
          class="shadow-editorial absolute bottom-8 end-0 max-w-xs rounded-2xl border border-white bg-white/90 p-8 backdrop-blur-xl md:end-6"
        >
          <div class="serif-display mb-2 text-4xl font-bold text-teal-dark">
            {tr.supply.statValue}
          </div>
          <p class="eyebrow mb-3 text-on-surface-subtle">
            {tr.supply.statLabel}
          </p>
          <p class="text-xs leading-relaxed text-on-surface-subtle">
            {tr.supply.statNote}
          </p>
        </div>
      </div>

      {/* Copy + list */}
      <div>
        <span class="eyebrow mb-6 block text-teal-dark">
          {tr.supply.eyebrow}
        </span>
        <h2 class="serif-display mb-8 text-4xl font-bold leading-tight text-on-surface md:text-5xl">
          {tr.supply.headline}
        </h2>
        <p class="mb-10 text-lg leading-relaxed text-on-surface-muted">
          {tr.supply.body}
        </p>

        <ul class="space-y-6">
          <li class="flex items-start">
            <div
              class="me-4 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-md bg-teal/10 text-teal-dark"
            >
              <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z"
                  clip-rule="evenodd"
                ></path>
              </svg>
            </div>
            <div>
              <h4 class="font-bold text-on-surface">{tr.supply.point1Title}</h4>
              <p class="text-sm text-on-surface-subtle">{tr.supply.point1Body}</p>
            </div>
          </li>
          <li class="flex items-start">
            <div
              class="me-4 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-md bg-teal/10 text-teal-dark"
            >
              <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path d="M10 2a1 1 0 0 1 1 1v1.07a6.002 6.002 0 0 1 4.93 4.93H17a1 1 0 1 1 0 2h-1.07a6.002 6.002 0 0 1-4.93 4.93V17a1 1 0 1 1-2 0v-1.07a6.002 6.002 0 0 1-4.93-4.93H3a1 1 0 0 1 0-2h1.07A6.002 6.002 0 0 1 9 4.07V3a1 1 0 0 1 1-1Zm0 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z"></path>
              </svg>
            </div>
            <div>
              <h4 class="font-bold text-on-surface">{tr.supply.point2Title}</h4>
              <p class="text-sm text-on-surface-subtle">{tr.supply.point2Body}</p>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
