---
/**
 * TradeFloorOrigins — Mission control map.
 * Carbon dotted-grid world canvas + origin pins (+ shape) + side panel
 * with last-shipment + harvest status + price sparkline.
 *
 * Pin data shared with marka, kategori filter chips lazy-render.
 */
import type { Locale } from '@/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;

type Cat = 'coffee' | 'cocoa' | 'nuts' | 'spices' | 'ingredients';

interface Pin {
  id: string;
  name: string;
  country: string;
  region: string;
  lat: number;
  lon: number;
  cat: Cat;
  season: string;
  spec: string;
  port: string;
  lastShipment: string;
  pxKey: string;
}

const PINS: Pin[] = [
  { id: 'p01', name: 'Yirgacheffe', country: 'Ethiopia',     region: 'SNNP',          lat: 6.16, lon: 38.20, cat: 'coffee',      season: 'Sep–Dec',  spec: 'G1 · Cup 86–92 · washed', port: 'Djibouti', lastShipment: '18 days ago', pxKey: 'arabica' },
  { id: 'p02', name: 'Huila',       country: 'Colombia',     region: 'Andean',        lat: 2.93, lon: -75.30, cat: 'coffee',      season: 'Mar–Jun',  spec: 'Excelso · Cup 84–88',     port: 'Buenaventura', lastShipment: '6 days ago',  pxKey: 'arabica' },
  { id: 'p03', name: 'Lam Dong',    country: 'Vietnam',      region: 'Central HL',    lat: 11.94, lon: 108.43, cat: 'coffee',      season: 'Oct–Feb',  spec: 'Robusta G1 · Screen 18+', port: 'Cat Lai', lastShipment: '3 days ago',  pxKey: 'robusta' },
