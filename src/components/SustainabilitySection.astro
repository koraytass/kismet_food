---
/**
 * SustainabilitySection — Dark editorial section with testimonial.
 * Uses surface-deep background with plantation image at low opacity.
 */
import type { Locale } from '@/i18n';
import { t } from '@/i18n';
import { stockImages } from '@/lib/images';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
const bg = stockImages.plantation;
const farmer = stockImages.farmer;
---

<section id="sustainability" class="relative overflow-hidden bg-surface-deep py-28 text-white md:py-32">
  <div class="absolute inset-0 opacity-25" aria-hidden="true">
    <img
      src={bg.src}
      alt=""
      class="h-full w-full object-cover"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="relative z-10 mx-auto grid max-w-7xl grid-cols-1 gap-16 px-6 md:px-8 lg:grid-cols-2">
    <div>
      <span class="eyebrow mb-6 block text-orange">{tr.sustainability.eyebrow}</span>
      <h2 class="serif-display mb-8 text-4xl font-bold leading-tight md:text-5xl">
        {tr.sustainability.headline}
      </h2>
      <p class="mb-12 text-xl font-light leading-relaxed text-white/80">
        {tr.sustainability.body}
      </p>
      <div class="grid grid-cols-2 gap-8">
        <div>
          <div class="serif-display mb-2 text-3xl font-bold text-orange">
            {tr.sustainability.stat1Value}
          </div>
          <p class="eyebrow text-white/60">{tr.sustainability.stat1Label}</p>
        </div>
        <div>
          <div class="serif-display mb-2 text-3xl font-bold text-orange">
            {tr.sustainability.stat2Value}
          </div>
          <p class="eyebrow text-white/60">{tr.sustainability.stat2Label}</p>
        </div>
      </div>
    </div>

    <div
      class="flex flex-col justify-center rounded-2xl border border-white/10 bg-white/5 p-10 backdrop-blur-lg"
    >
      <svg class="mb-6 h-8 w-8 text-orange/70" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M4.583 17.321C3.553 16.227 3 15 3 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 0 1-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179Zm10 0C13.553 16.227 13 15 13 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 0 1-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179Z"></path>
      </svg>
      <blockquote class="serif-display mb-8 text-2xl italic leading-relaxed">
        {tr.sustainability.quote}
      </blockquote>
      <div class="flex items-center">
        <div class="me-4 h-12 w-12 overflow-hidden rounded-full">
          <img
            src={farmer.src}
            alt={farmer.alt[locale]}
            class="h-full w-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div>
          <div class="font-bold">{tr.sustainability.quoteName}</div>
          <div class="eyebrow text-white/60">{tr.sustainability.quoteRole}</div>
        </div>
      </div>
    </div>
  </div>
</section>
