---
/**
 * OriginsMap — Interactive world map with hover/tap-driven origin info card.
 *
 * Behavior:
 *   - Desktop: hovering a marker reveals a side info card (top-right of map);
 *     leaving the marker fades it out after a short grace, unless the cursor
 *     moves onto the card (which keeps it open).
 *   - Mobile / touch: tapping a marker pins the card as a bottom sheet with
 *     an explicit close button; tapping outside dismisses.
 *   - Keyboard: tab through markers, focus opens the card, Esc closes it.
 *
 * Editorial styling: minimal Carto Positron tiles, small ringed-dot markers
 * in Kismet brand colors, custom HTML card (no Leaflet popups).
 */
export type OriginMarker = {
  k: string;
  name: string;
  region: string;
  products: string[];
  lat: number;
  lng: number;
  href?: string;
  category: 'coffee' | 'cocoa' | 'nuts' | 'spices' | 'mixed';
};

interface Props {
  markers: OriginMarker[];
  labels: {
    viewDetail: string;
    mapAria: string;
    panelHint?: string;
    closeLabel?: string;
  };
  height?: string; // legacy single-value fallback (used as desktop height)
}

const { markers, labels, height = '560px' } = Astro.props;

/* Category → color mapping (Kismet brand-adjacent) */
const categoryColor: Record<OriginMarker['category'], string> = {
  coffee: '#9b451c',
  cocoa: '#5c403a',
  nuts: '#f68b5c',
  spices: '#ca2030',
  mixed: '#00696b',
};
---

<div class="kismet-map-wrap relative">
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
    crossorigin=""
  />

  <div
    id="origins-map"
    role="region"
    aria-label={labels.mapAria}
    tabindex="0"
    class="shadow-editorial relative w-full overflow-hidden rounded-lg bg-surface-low"
    style={`height: clamp(320px, 48vh, ${height});`}
  ></div>

  {/* Idle hint — fades out on first marker interaction */}
  {labels.panelHint && (
    <div
      id="origins-map-hint"
      class="pointer-events-none absolute bottom-3 left-1/2 z-[400] -translate-x-1/2 whitespace-nowrap rounded-full bg-white/85 px-4 py-1.5 text-[10px] font-bold uppercase tracking-[0.22em] text-on-surface-muted shadow backdrop-blur transition-opacity duration-300 md:text-[11px]"
    >
      {labels.panelHint}
    </div>
  )}

  {/* Info card — bottom sheet on mobile, floating top-right card on md+ */}
  <aside
    id="origins-map-panel"
    role="dialog"
    aria-live="polite"
    aria-label="Origin detail"
    class="kismet-map-panel pointer-events-none absolute bottom-3 left-3 right-3 z-[500] opacity-0 invisible transition-all duration-300 md:bottom-auto md:left-auto md:right-3 md:top-3 md:w-[300px] lg:right-4 lg:top-4 lg:w-[320px]"
  >
    <div class="relative rounded-xl bg-white/95 p-5 shadow-2xl ring-1 ring-black/5 backdrop-blur-sm">
      <button
        id="origins-map-panel-close"
        type="button"
        class="absolute right-3 top-3 inline-flex h-7 w-7 items-center justify-center rounded-full text-on-surface-subtle transition hover:bg-black/5 md:hidden"
        aria-label={labels.closeLabel ?? 'Close'}
      >
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </button>
      <span id="origins-map-panel-region" class="block text-[10px] font-bold uppercase tracking-[0.22em] text-orange"></span>
      <h4 id="origins-map-panel-name" class="serif-display mt-1 pr-7 text-[1.4rem] font-bold leading-tight text-teal md:text-[1.5rem]"></h4>
      <p id="origins-map-panel-products" class="mt-2 text-sm leading-relaxed text-on-surface-muted"></p>
      <a
        id="origins-map-panel-link"
        class="mt-4 hidden items-center gap-1 text-[11px] font-bold uppercase tracking-[0.18em] text-teal transition hover:text-orange"
        href="#"
      >
        <span id="origins-map-panel-link-label"></span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </aside>
</div>

{/* Legend */}
<ul class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-xs text-on-surface-subtle">
  {Object.entries(categoryColor).map(([cat, color]) => (
    <li class="flex items-center gap-2">
      <span aria-hidden="true" class="inline-block h-2.5 w-2.5 rounded-full ring-2 ring-white" style={`background:${color}`}></span>
      <span class="eyebrow text-[10px]">
        {cat === 'coffee' && 'KAHVE / COFFEE / قهوة'}
        {cat === 'cocoa' && 'KAKAO / COCOA / كاكاو'}
        {cat === 'nuts' && 'KURUYEMİŞ / NUTS / مكسرات'}
        {cat === 'spices' && 'BAHARAT / SPICES / توابل'}
        {cat === 'mixed' && 'KARIŞIK / MIXED / مختلط'}
      </span>
    </li>
  ))}
</ul>

<style is:global>
  /* Tile / chrome restyles */
  .leaflet-container {
    background: #f4f3f2;
    font-family: inherit;
  }
  .leaflet-control-zoom a {
    background: #ffffff !important;
    color: #00696b !important;
    border-color: rgba(187, 201, 201, 0.5) !important;
  }
  .leaflet-control-zoom a:hover {
    background: #00acaf !important;
    color: #ffffff !important;
  }
  .leaflet-control-attribution {
    font-size: 10px;
    background: rgba(255, 255, 255, 0.75) !important;
  }

  /* Ring-dot marker (uses currentColor → category fill) */
  .kismet-dot {
    position: relative;
    display: block;
    width: 18px;
    height: 18px;
    cursor: pointer;
    color: inherit;
  }
  .kismet-dot__ring,
  .kismet-dot__core {
    position: absolute;
    border-radius: 50%;
  }
  .kismet-dot__ring {
    inset: -4px;
    border: 1.5px solid currentColor;
    opacity: 0.35;
    transition:
      transform 240ms cubic-bezier(0.22, 0.72, 0.22, 1),
      opacity 240ms;
  }
  .kismet-dot__core {
    inset: 4px;
    background: currentColor;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
    transition: transform 240ms cubic-bezier(0.22, 0.72, 0.22, 1);
  }
  .kismet-dot:hover .kismet-dot__ring,
  .kismet-dot:focus-visible .kismet-dot__ring,
  .kismet-dot.is-active .kismet-dot__ring {
    transform: scale(1.45);
    opacity: 0.6;
  }
  .kismet-dot:hover .kismet-dot__core,
  .kismet-dot:focus-visible .kismet-dot__core,
  .kismet-dot.is-active .kismet-dot__core {
    transform: scale(1.2);
  }

  /* Featured anchor — Türkiye gets a soft pulse */
  .kismet-dot--featured {
    width: 22px;
    height: 22px;
  }
  .kismet-dot--featured .kismet-dot__ring {
    inset: -6px;
    border-width: 2px;
    opacity: 0.5;
  }
  .kismet-dot--featured .kismet-dot__core {
    box-shadow:
      0 2px 6px rgba(0, 0, 0, 0.25),
      0 0 0 2px rgba(255, 255, 255, 0.9);
  }
  @keyframes kismet-pulse {
    0%   { transform: scale(1);   opacity: 0.45; }
    60%  { transform: scale(1.6); opacity: 0.18; }
    100% { transform: scale(2.2); opacity: 0;    }
  }
  .kismet-dot--featured::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid currentColor;
    pointer-events: none;
    animation: kismet-pulse 2.6s ease-out infinite;
  }

  /* Panel transitions */
  .kismet-map-panel {
    transform: translateY(8px);
  }
  .kismet-map-panel.is-open {
    pointer-events: auto;
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .kismet-dot--featured::after { animation: none; opacity: 0; }
    .kismet-dot__ring,
    .kismet-dot__core,
    .kismet-map-panel { transition: none !important; }
  }
</style>

<script is:inline define:vars={{ markers, categoryColor, viewDetailLabel: labels.viewDetail }}>
  (function () {
    function load() {
      if (typeof window === 'undefined') return;
      if (!window.L) {
        var s = document.createElement('script');
        s.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
        s.integrity = 'sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=';
        s.crossOrigin = '';
        s.onload = init;
        document.head.appendChild(s);
      } else {
        init();
      }
    }

    function init() {
      var el = document.getElementById('origins-map');
      if (!el || el.dataset.initialized) return;
      el.dataset.initialized = 'true';

      var panel = document.getElementById('origins-map-panel');
      var panelRegion = document.getElementById('origins-map-panel-region');
      var panelName = document.getElementById('origins-map-panel-name');
      var panelProducts = document.getElementById('origins-map-panel-products');
      var panelLink = document.getElementById('origins-map-panel-link');
      var panelLinkLabel = document.getElementById('origins-map-panel-link-label');
      var panelClose = document.getElementById('origins-map-panel-close');
      var hint = document.getElementById('origins-map-hint');

      var hideTimer = null;
      var pinned = false; // touch / click locks the panel open

      function clearActiveDots() {
        var dots = document.querySelectorAll('.kismet-dot.is-active');
        for (var i = 0; i < dots.length; i++) dots[i].classList.remove('is-active');
      }

      function setActive(marker) {
        clearActiveDots();
        var elDot = marker.getElement() && marker.getElement().querySelector('.kismet-dot');
        if (elDot) elDot.classList.add('is-active');
      }

      function showPanel(m) {
        if (!panel) return;
        if (hideTimer) { clearTimeout(hideTimer); hideTimer = null; }
        panelRegion.textContent = m.region || '';
        panelName.textContent = m.name || '';
        panelProducts.textContent = (m.products || []).join(' · ');
        if (m.href && panelLink) {
          panelLink.href = m.href;
          panelLink.classList.remove('hidden');
          panelLink.classList.add('inline-flex');
          panelLinkLabel.textContent = viewDetailLabel;
        } else if (panelLink) {
          panelLink.classList.add('hidden');
          panelLink.classList.remove('inline-flex');
        }
        panel.classList.add('is-open');
        if (hint) hint.style.opacity = '0';
      }

      function hidePanel() {
        if (!panel) return;
        panel.classList.remove('is-open');
        clearActiveDots();
        pinned = false;
      }

      function scheduleHide() {
        if (pinned) return;
        if (hideTimer) clearTimeout(hideTimer);
        hideTimer = setTimeout(hidePanel, 280);
      }

      function cancelHide() {
        if (hideTimer) { clearTimeout(hideTimer); hideTimer = null; }
      }

      if (panel) {
        panel.addEventListener('mouseenter', cancelHide);
        panel.addEventListener('mouseleave', function () {
          if (!pinned) scheduleHide();
        });
      }
      if (panelClose) {
        panelClose.addEventListener('click', function (e) {
          e.stopPropagation();
          hidePanel();
        });
      }

      // Esc closes
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && panel && panel.classList.contains('is-open')) {
          hidePanel();
        }
      });

      var map = L.map(el, {
        center: [22, 18],
        zoom: 2,
        minZoom: 2,
        maxZoom: 6,
        worldCopyJump: true,
        scrollWheelZoom: false,
        keyboard: true,
        attributionControl: true,
      });

      L.tileLayer(
        'https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png',
        {
          subdomains: 'abcd',
          maxZoom: 19,
          attribution:
            '&copy; <a href="https://openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
        },
      ).addTo(map);

      // Tapping the bare map (not a marker / not the panel) closes the pinned card.
      map.on('click', function () {
        if (pinned) hidePanel();
        map.scrollWheelZoom.enable();
      });
      map.on('mouseout', function () {
        map.scrollWheelZoom.disable();
      });

      markers.forEach(function (m) {
        var color = categoryColor[m.category] || '#00696b';
        var featured = m.k === 'turkiye';
        var nameEsc = (m.name || '').replace(/"/g, '&quot;');
        var html =
          '<span class="kismet-dot' + (featured ? ' kismet-dot--featured' : '') +
          '" style="color:' + color + '" tabindex="0" role="button" aria-label="' + nameEsc + '">' +
            '<span class="kismet-dot__ring"></span>' +
            '<span class="kismet-dot__core"></span>' +
          '</span>';

        var size = featured ? 22 : 18;
        var icon = L.divIcon({
          className: '',
          html: html,
          iconSize: [size, size],
          iconAnchor: [size / 2, size / 2],
        });

        var marker = L.marker([m.lat, m.lng], { icon: icon, title: m.name, alt: m.name }).addTo(map);

        marker.on('mouseover', function () {
          if (pinned) return;
          setActive(marker);
          showPanel(m);
        });
        marker.on('mouseout', function () {
          if (!pinned) scheduleHide();
        });
        // Click / tap pins the panel
        marker.on('click', function (e) {
          if (e && e.originalEvent && e.originalEvent.stopPropagation) {
            e.originalEvent.stopPropagation();
          }
          setActive(marker);
          showPanel(m);
          pinned = true;
        });
        marker.on('focus', function () {
          if (pinned) return;
          setActive(marker);
          showPanel(m);
        });
        marker.on('blur', function () {
          if (!pinned) scheduleHide();
        });
      });

      // Hide hint after first user motion over the map
      el.addEventListener('mousemove', function () {
        if (hint) hint.style.opacity = '0';
      }, { once: true, passive: true });
      el.addEventListener('touchstart', function () {
        if (hint) hint.style.opacity = '0';
      }, { once: true, passive: true });

      // Re-flow tiles after font/layout settle (Astro hydration race-safe)
      setTimeout(function () { try { map.invalidateSize(); } catch (_) {} }, 60);
      window.addEventListener('resize', function () {
        try { map.invalidateSize(); } catch (_) {}
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', load);
    } else {
      load();
    }
  })();
</script>
