---
/**
 * SiteHeader — v2 (Trade Floor).
 * Eski "ledger" navigasyonu emekliye ayrıldı; mevcut tüm sayfalar bu dosya
 * üzerinden TradeFloorNav + TradeFloorMenu kombinasyonunu otomatik alır.
 */
import type { Locale } from '@/i18n';
import TradeFloorNav from './v2/TradeFloorNav.astro';
import TradeFloorMenu from './v2/TradeFloorMenu.astro';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
---

<TradeFloorNav locale={locale} currentPath={currentPath} />
<TradeFloorMenu locale={locale} />
