---
/**
 * DetailPage — v3 corporate.
 * Dynamic [locale]/[group]/[slug] sayfaları için kurumsal sunum.
 * Mevcut DetailCopy data sözleşmesi (eyebrow/title/lead/notes/factSheet/sections) korundu.
 */
import type { Locale } from '@/i18n';
import { localePath } from '@/i18n';
import type { DetailCopy } from '@/lib/detail-pages';
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
import CorpPageHero from '../v3/CorpPageHero.astro';
import CorpSection from '../v3/CorpSection.astro';

interface Props {
  locale: Locale;
  currentPath: string;
  parentPath: string;
  page: DetailCopy;
}

const { locale, currentPath, parentPath, page } = Astro.props;
void currentPath;

const resolvedLinks = page.links?.map((link) => ({
  ...link,
  href: link.href.startsWith(`/${locale}/`) ? link.href : localePath(link.href, locale),
})) ?? [];

const meta: { label: string; value: string }[] = [];
if (page.stat && page.statLabel) meta.push({ label: page.statLabel, value: page.stat });
meta.push({ label: 'Section', value: page.parentLabel });

const notesLabel = locale === 'tr' ? 'OKUMA NOTU' : locale === 'ar' ? 'ملاحظات قراءة' : 'READING NOTES';
const factsLabel = locale === 'tr' ? 'TİCARİ ÇERÇEVE' : locale === 'ar' ? 'الإطار التجاري' : 'COMMERCIAL FRAME';
const sectionsLabel = locale === 'tr' ? 'BÖLÜMLER' : locale === 'ar' ? 'الأقسام' : 'SECTIONS';
const backLabel = locale === 'tr' ? 'Üst sayfaya dön' : locale === 'ar' ? 'العودة' : 'Back to parent';
---

<SiteHeader locale={locale} currentPath={parentPath} />

<main id="main">
  <CorpPageHero
    locale={locale}
    eyebrow={page.eyebrow}
    title={page.title}
    lede={page.lead}
    background={page.image}
    parent={{ label: page.parentLabel, href: parentPath }}
    meta={meta}
  />

  {page.notes && page.notes.length > 0 && (
    <CorpSection variant="white" eyebrow={notesLabel} title={page.title} compact>
      <div class="dt-notes">
        {page.notes.map((n) => <p>{n}</p>)}
      </div>
    </CorpSection>
  )}

  {page.factSheet && page.factSheet.length > 0 && (
    <CorpSection variant="snow" eyebrow={factsLabel} title="Ticari" italic="çerçeve.">
      <div class="dt-facts">
        {page.factSheet.map((it) => (
          <article class="dt-fact">
            <span class="co-eyebrow co-eyebrow--ink">{it.label}</span>
            <h3 class="co-h3">{it.title}</h3>
            <p>{it.body}</p>
          </article>
        ))}
      </div>
    </CorpSection>
  )}

  <CorpSection variant="white" eyebrow={sectionsLabel} title="Detay" italic="bölümler.">
    <div class="dt-sections">
      {page.sections.map((s, i) => (
        <article class="dt-sec">
          <span class="co-num dt-sec__num">{String(i + 1).padStart(2, '0')}</span>
          <span class="co-eyebrow co-eyebrow--ink">{s.label}</span>
          <h3 class="co-h3">{s.title}</h3>
          <p>{s.body}</p>
        </article>
      ))}
    </div>
  </CorpSection>

  {resolvedLinks.length > 0 && (
    <CorpSection variant="navy" compact>
      <div class="dt-cta">
        <h2 class="co-h2">{resolvedLinks[0].label}</h2>
        <div class="dt-cta__row">
          <a href={resolvedLinks[0].href} class="co-btn co-btn--amber">{resolvedLinks[0].label} <span aria-hidden="true">→</span></a>
          {resolvedLinks.slice(1).map((l) => (
            <a href={l.href} class="dt-cta__link">{l.label} →</a>
          ))}
          <a href={parentPath} class="dt-cta__link">{backLabel}</a>
        </div>
      </div>
    </CorpSection>
  )}
</main>

<SiteFooter locale={locale} />

<style>
  .dt-notes { display: flex; flex-direction: column; gap: 22px; max-width: 70ch; }
  .dt-notes p { font-family: var(--co-sans); font-size: 17px; line-height: 1.7; color: var(--co-text); margin: 0; }

  .dt-facts { display: grid; grid-template-columns: 1fr; gap: 1px; background: var(--co-line); border: 1px solid var(--co-line); }
  @media (min-width: 720px) { .dt-facts { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1080px) { .dt-facts { grid-template-columns: repeat(4, 1fr); } }
  .dt-fact { background: var(--co-white); padding: 24px; display: flex; flex-direction: column; gap: 10px; transition: background 200ms ease; }
  .dt-fact:hover { background: var(--co-snow); }
  .dt-fact h3 { color: var(--co-ink); margin: 0; font-size: 18px; }
  .dt-fact p { font-family: var(--co-sans); font-size: 13px; color: var(--co-mute); margin: 0; line-height: 1.6; }

  .dt-sections { display: grid; grid-template-columns: 1fr; gap: 28px; }
  @media (min-width: 720px) { .dt-sections { grid-template-columns: repeat(2, 1fr); gap: 32px; } }
  @media (min-width: 1080px) { .dt-sections { grid-template-columns: repeat(3, 1fr); } }
  .dt-sec { padding-top: 24px; border-top: 2px solid var(--co-amber); display: flex; flex-direction: column; gap: 8px; }
  .dt-sec__num { font-size: 24px; color: var(--co-amber); line-height: 1; }
  .dt-sec h3 { color: var(--co-ink); margin: 0; }
  .dt-sec p { font-family: var(--co-sans); font-size: 14px; color: var(--co-mute); margin: 0; line-height: 1.65; }

  .dt-cta { display: flex; flex-direction: column; gap: 18px; max-width: 800px; }
  .dt-cta h2 { color: var(--co-white); }
  .dt-cta__row { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; }
  .dt-cta__link { font-family: var(--co-sans); font-size: 13px; font-weight: 600; color: rgba(255,255,255,0.78); text-decoration: none; padding-bottom: 4px; border-bottom: 1px solid rgba(255,255,255,0.3); transition: color 200ms ease, border-color 200ms ease; }
  .dt-cta__link:hover { color: var(--co-amber); border-color: var(--co-amber); }
</style>
