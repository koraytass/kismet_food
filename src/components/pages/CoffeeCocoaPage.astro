---
import type { Locale } from '@/i18n';
import { localePath } from '@/i18n';
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
import CorpPageHero from '../v3/CorpPageHero.astro';
import CorpSection from '../v3/CorpSection.astro';

interface Props { locale: Locale; currentPath: string }
const { locale, currentPath } = Astro.props;

const copy = {
  tr: {
    eyebrow: 'ÜRÜN KATEGORİSİ · DOĞRUDAN TİCARET',
    heroTitle: 'Kahve & Kakao',
    heroLead: 'Dünyanın en prestijli ekvator kuşağından etik ve hassas derecelendirilmiş ham maddeler. Küçük ölçekli çiftçiler ile küresel üretim arasındaki köprüyü doğrudan ticaret ilişkileriyle kuruyoruz.',
    originEyebrow: 'KÜRASYON · MENŞE SEÇKİSİ', originTitle: 'Terruvarın', originItalic: 'mirası.',
    originLead: 'Küresel ağımız iki kıtada sınırlı hasat partilerine ve endüstriyel ölçekli standartlara kesintisiz erişim sağlar.',
    origins: [
      { badge: 'Heirloom Arabica', name: 'Etiyopya Sidamo', body: 'Çiçeksi, narenciye tonlu asiditesi ve çay gibi gövdesiyle tanınır. 1.500 m+ rakımda hasat. Cup score 85-92.', linkLabel: 'Profili İncele', href: localePath('/origins/ethiopia/', locale) },
      { badge: 'Bulk & Spesiyalite', name: 'Gana Forastero', body: 'Endüstriyel kakaonun altın standardı. Derin çikolata notaları, %52-56 yağ. EUDR uyumlu CMS izlenebilirlik.', linkLabel: 'Teknik Özellikler', href: '#specs' },
    ],
    gradingTitle: 'Hassas derecelendirme', gradingItalic: 'standartları.',
    gradingLead: 'Çekirdek sınıflandırmasında tam şeffaflık. Artisan mikrolot’tan endüstriyel hacme kadar üretim hattınıza tam istediğinizi teslim ederiz.',
    grades: [
      { title: 'Spesiyalite (80+ SCA)', body: 'Sıfır birincil kusur. Kavurma homojenliği ve kompleks aroma için elde ayıklanır.' },
      { title: 'Premium', body: 'Cup 80-84. Specialty harmanların tabanı ve direct-trade hatlar için.' },
      { title: 'Endüstriyel', body: 'Yüksek verimli işleme; instant, çözünür ve kitle pazar harmanları.' },
    ],
    specEyebrow: 'TEKNİK BELGE', specTitle: 'Standart spesifikasyonlar',
    specHeaders: ['Metrik', 'Kahve (Yeşil Arabica)', 'Kakao (Kuru Çekirdek)', 'Test Yöntemi'],
    specRows: [
      ['Nem İçeriği', '%9,0 – %12,0', '%6,5 – %7,5', 'ISO 6673 / 2291'],
      ['Elek / Çekirdek', 'Screen 15+ (≥%90)', '90-100 çekirdek/100g', 'Manuel ayıklama'],
      ['Defekt Toleransı', '< 5 ikincil', '< %3 küflü/çürük', 'Görsel analiz'],
      ['Kafein / Yağ', '%1,2 – %1,5', '%52 – %56 yağ', 'HPLC / Soxhlet'],
      ['Cup Score', '80-92 SCA', 'Cut test ≥%75 brown', 'Q Grader / sensory'],
    ],
    specNote: '*Özel karışımlar için talebe göre özelleştirilmiş spesifikasyonlar sunulur.',
    supplyEyebrow: 'KÜRESEL VARLIK', supplyTitle: 'Ekvatoryal', supplyItalic: 'tedarik zinciri.',
    supplyBody: 'Tedarik ofislerimiz, sahada kalite kontrolü ve çiftçi kooperatifleriyle doğrudan ilişkiler için stratejik olarak Coffee Belt’te konumlanmıştır.',
    supplyPoints: [
      { h: 'Doğu Afrika', l: 'Addis Ababa, Etiyopya · YCFCU & SCFCU' },
      { h: 'Batı Afrika', l: 'Tema, Gana · COCOBOD ortak' },
      { h: 'Latin Amerika', l: 'Bogotá, Kolombiya · FNC ağı' },
      { h: 'Asya', l: 'Ho Chi Minh, Vietnam · Trung Nguyen ihracat' },
      { h: 'Lojistik', l: 'Rotterdam · Antwerp transit hub' },
    ],
    ctaTitle: 'Kahve ve kakao için özel teklif alın.',
    ctaLead: 'Tek bir konteyner ya da yıllık tedarik sözleşmesi — ticaret masamız hacim ve sevkiyat hedefinize göre özel fiyat matrisi hazırlar.',
    ctaBtn: 'Teklif Al',
  },
  en: {
    eyebrow: 'PRODUCT CATEGORY · DIRECT TRADE',
    heroTitle: 'Coffee & Cocoa',
    heroLead: 'Ethically sourced, precision-graded raw materials from the world\'s most prestigious equatorial belts. We bridge smallhold farmers with global manufacturing through direct-trade relationships.',
    originEyebrow: 'CURATION · ORIGIN SELECT', originTitle: 'The heritage of', originItalic: 'terroir.',
    originLead: 'Our global network ensures access to limited-run harvests and industrial staples across two continents.',
    origins: [
      { badge: 'Heirloom Arabica', name: 'Ethiopian Sidamo', body: 'Floral, citrusy acidity and tea-like body. Harvested at 1,500m+. Cup score 85-92.', linkLabel: 'Explore Profile', href: localePath('/origins/ethiopia/', locale) },
      { badge: 'Bulk & Specialty', name: 'Ghanaian Forastero', body: 'Gold standard for industrial cocoa. Deep chocolate base, 52-56% fat. EUDR-compliant CMS traceability.', linkLabel: 'Technical Specs', href: '#specs' },
    ],
    gradingTitle: 'Precision grading', gradingItalic: 'standards.',
    gradingLead: 'Full transparency on bean classification — from artisan microlots to high-volume industrial batches, your line gets exactly what it needs.',
    grades: [
      { title: 'Specialty (80+ SCA)', body: 'Zero primary defects. Hand-sorted for roast uniformity and complex sensory profiles.' },
      { title: 'Premium', body: 'Cup 80-84. Foundation for specialty blends and direct-trade lines.' },
      { title: 'Industrial', body: 'High-efficiency processing for instant, soluble and mass-market blends.' },
    ],
    specEyebrow: 'TECHNICAL DOC', specTitle: 'Standard specifications',
    specHeaders: ['Metric', 'Coffee (Green Arabica)', 'Cocoa (Dried Beans)', 'Testing Method'],
    specRows: [
      ['Moisture', '9.0% – 12.0%', '6.5% – 7.5%', 'ISO 6673 / 2291'],
      ['Screen / Bean', 'Screen 15+ (≥90%)', '90-100 beans/100g', 'Manual sorting'],
      ['Defect Tolerance', '< 5 secondary', '< 3% slaty / mouldy', 'Visual analysis'],
      ['Caffeine / Fat', '1.2% – 1.5%', '52% – 56% fat', 'HPLC / Soxhlet'],
      ['Cup Score', '80-92 SCA', 'Cut test ≥75% brown', 'Q Grader / sensory'],
    ],
    specNote: '*Custom specs available on request for proprietary blends.',
    supplyEyebrow: 'GLOBAL PRESENCE', supplyTitle: 'Equatorial', supplyItalic: 'supply chain.',
    supplyBody: 'Procurement offices strategically located in the Coffee Belt for boots-on-the-ground QC and direct cooperative relationships.',
    supplyPoints: [
      { h: 'East Africa', l: 'Addis Ababa, Ethiopia · YCFCU & SCFCU' },
      { h: 'West Africa', l: 'Tema, Ghana · COCOBOD partner' },
      { h: 'Latin America', l: 'Bogotá, Colombia · FNC network' },
      { h: 'Asia', l: 'Ho Chi Minh, Vietnam · Trung Nguyen export' },
      { h: 'Logistics', l: 'Rotterdam · Antwerp transit hub' },
    ],
    ctaTitle: 'Request a coffee & cocoa quote.',
    ctaLead: 'A single container or yearly supply contract — our trade desk returns a custom pricing matrix tailored to your volume and destination.',
    ctaBtn: 'Request Quote',
  },
  ar: {
    eyebrow: 'فئة المنتج · تجارة مباشرة',
    heroTitle: 'القهوة والكاكاو',
    heroLead: 'مواد خام مصنفة بدقة ومصدرها أخلاقي من أكثر الأحزمة الاستوائية تميزاً.',
    originEyebrow: 'تنسيق · منشأ منتقى', originTitle: 'إرث', originItalic: 'الترّوار.',
    originLead: 'شبكتنا العالمية تضمن الوصول إلى دفعات محدودة ومعايير صناعية في قارتين.',
    origins: [
      { badge: 'أرابيكا تراثية', name: 'سيدامو إثيوبيا', body: 'حموضة زهرية وقوام كالشاي. حصاد ١٥٠٠+ م. كأس ٨٥-٩٢.', linkLabel: 'استكشف الملف', href: localePath('/origins/ethiopia/', locale) },
      { badge: 'حجم وخاص', name: 'فوراستيرو غانا', body: 'المعيار الذهبي للكاكاو الصناعي. شوكولاتة عميقة، دهن ٥٢-٥٦٪. CMS متوافق EUDR.', linkLabel: 'المواصفات الفنية', href: '#specs' },
    ],
    gradingTitle: 'معايير الفرز', gradingItalic: 'الدقيقة.',
    gradingLead: 'شفافية كاملة في التصنيف — من المايكرولوت إلى الدفعات الصناعية الكبيرة.',
    grades: [
      { title: 'مختصة (٨٠+ SCA)', body: 'صفر عيوب أولية. فرز يدوي.' },
      { title: 'فاخر', body: 'كأس ٨٠-٨٤. أساس الخلطات المختصة.' },
      { title: 'صناعي', body: 'معالجة عالية الكفاءة للإنستانت والخلطات الجماهيرية.' },
    ],
    specEyebrow: 'وثيقة تقنية', specTitle: 'المواصفات القياسية',
    specHeaders: ['المقياس', 'قهوة', 'كاكاو', 'طريقة الاختبار'],
    specRows: [
      ['الرطوبة', '٩-١٢٪', '٦٫٥-٧٫٥٪', 'ISO 6673 / 2291'],
      ['الغربال / الحبة', 'Screen 15+', '٩٠-١٠٠/١٠٠غ', 'فرز يدوي'],
      ['تسامح العيوب', '< ٥ ثانوي', '< ٣٪', 'تحليل بصري'],
      ['كافيين / دهن', '١٫٢-١٫٥٪', '٥٢-٥٦٪', 'HPLC / Soxhlet'],
      ['كأس', '٨٠-٩٢ SCA', 'Cut test ≥٧٥٪', 'Q Grader'],
    ],
    specNote: '*مواصفات مخصصة متاحة عند الطلب.',
    supplyEyebrow: 'حضور عالمي', supplyTitle: 'سلسلة', supplyItalic: 'استوائية.',
    supplyBody: 'مكاتب توريد متمركزة في حزام القهوة لرقابة جودة ميدانية وعلاقات تعاونية مباشرة.',
    supplyPoints: [
      { h: 'شرق أفريقيا', l: 'أديس أبابا · YCFCU & SCFCU' },
      { h: 'غرب أفريقيا', l: 'تيما · COCOBOD' },
      { h: 'أمريكا اللاتينية', l: 'بوغوتا · FNC' },
      { h: 'آسيا', l: 'هو تشي مينه · Trung Nguyen' },
      { h: 'لوجستيات', l: 'روتردام · أنتويرب' },
    ],
    ctaTitle: 'اطلب عرض قهوة وكاكاو.',
    ctaLead: 'حاوية أو عقد سنوي — يجهز مكتبنا مصفوفة تسعير مخصصة.',
    ctaBtn: 'طلب عرض',
  },
}[locale];

const heroBg = 'https://images.unsplash.com/photo-1442550528053-c431ecb55509?auto=format&fit=crop&w=2400&q=80';
---

<SiteHeader locale={locale} currentPath={currentPath} />

<main id="main">
  <CorpPageHero
    locale={locale}
    eyebrow={copy.eyebrow}
    title={copy.heroTitle}
    lede={copy.heroLead}
    background={heroBg}
    parent={{ label: locale === 'tr' ? 'Ürünler' : locale === 'ar' ? 'المنتجات' : 'Products', href: localePath('/products/', locale) }}
    meta={[
      { label: 'Bench', value: 'ICE NY-C · LIFFE · NY-K' },
      { label: 'Origins', value: 'Ethiopia · Ghana · Colombia · Vietnam' },
      { label: 'EUDR', value: 'compliant' },
    ]}
  />

  <CorpSection variant="white" eyebrow={copy.originEyebrow} title={copy.originTitle} italic={copy.originItalic} lede={copy.originLead}>
    <div class="cc-origins">
      {copy.origins.map((o) => (
        <article class="cc-origin">
          <span class="co-eyebrow co-eyebrow--ink">{o.badge}</span>
          <h3 class="co-h2">{o.name}</h3>
          <p>{o.body}</p>
          <a href={o.href} class="co-link"><span>{o.linkLabel}</span><span class="co-link__arrow" aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
  </CorpSection>

  <CorpSection variant="snow" eyebrow="STANDART" title={copy.gradingTitle} italic={copy.gradingItalic} lede={copy.gradingLead}>
    <div class="cc-grades">
      {copy.grades.map((g, i) => (
        <article class="cc-grade">
          <span class="co-num cc-grade__num">0{i + 1}</span>
          <h3 class="co-h3">{g.title}</h3>
          <p>{g.body}</p>
        </article>
      ))}
    </div>
  </CorpSection>

  <section id="specs" class="cc-specs co-sec--white" style="padding-block: clamp(80px, 10vw, 160px); scroll-margin-top: 100px;">
    <div class="co-wrap">
      <header class="co-sec__head">
        <div>
          <span class="co-eyebrow">{copy.specEyebrow}</span>
          <h2 class="co-h-display">{copy.specTitle}</h2>
        </div>
        <p class="co-lede">{copy.specNote}</p>
      </header>
      <div class="cc-table-wrap">
        <table class="cc-table">
          <thead>
            <tr>
              {copy.specHeaders.map((h) => <th>{h}</th>)}
            </tr>
          </thead>
          <tbody>
            {copy.specRows.map((row) => (
              <tr>
                {row.map((cell, i) => <td class:list={[i === 0 && 'cc-table__metric']}>{cell}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <CorpSection variant="navy" eyebrow={copy.supplyEyebrow} title={copy.supplyTitle} italic={copy.supplyItalic} lede={copy.supplyBody}>
    <div class="cc-supply">
      {copy.supplyPoints.map((p, i) => (
        <article class="cc-supply__hub">
          <span class="co-num">0{i + 1}</span>
          <h3 class="co-h3">{p.h}</h3>
          <p>{p.l}</p>
        </article>
      ))}
    </div>
  </CorpSection>

  <CorpSection variant="snow" compact>
    <div class="cc-cta">
      <h2 class="co-h2">{copy.ctaTitle}</h2>
      <p>{copy.ctaLead}</p>
      <a href={localePath('/contact/request-quote/', locale)} class="co-btn co-btn--primary">{copy.ctaBtn} <span aria-hidden="true">→</span></a>
    </div>
  </CorpSection>
</main>

<SiteFooter locale={locale} />

<style>
  .cc-origins { display: grid; grid-template-columns: 1fr; gap: 24px; }
  @media (min-width: 880px) { .cc-origins { grid-template-columns: 1fr 1fr; gap: 32px; } }
  .cc-origin { background: var(--co-snow); border: 1px solid var(--co-line); border-top: 4px solid var(--co-amber); padding: 32px; display: flex; flex-direction: column; gap: 14px; transition: border-color 220ms ease, box-shadow 220ms ease; }
  .cc-origin:hover { border-color: var(--co-navy); border-top-color: var(--co-amber); box-shadow: 0 32px 56px -32px rgba(12,37,69,0.22); }
  .cc-origin h3 { color: var(--co-ink); margin: 0; }
  .cc-origin p { font-family: var(--co-sans); font-size: 15px; color: var(--co-mute); margin: 0; line-height: 1.65; }
  .cc-origin .co-link { align-self: flex-start; margin-top: 8px; }

  .cc-grades { display: grid; grid-template-columns: 1fr; gap: 28px; }
  @media (min-width: 880px) { .cc-grades { grid-template-columns: repeat(3, 1fr); } }
  .cc-grade { padding-top: 24px; border-top: 2px solid var(--co-amber); display: flex; flex-direction: column; gap: 10px; }
  .cc-grade__num { font-size: 32px; color: var(--co-amber); line-height: 1; }
  .cc-grade h3 { color: var(--co-ink); margin: 0; }
  .cc-grade p { font-family: var(--co-sans); font-size: 14px; color: var(--co-mute); margin: 0; line-height: 1.6; }

  .cc-table-wrap { overflow-x: auto; border: 1px solid var(--co-line); }
  .cc-table { width: 100%; min-width: 720px; border-collapse: collapse; }
  .cc-table th { background: var(--co-stone); text-align: start; padding: 18px 20px; font-family: var(--co-sans); font-size: 12px; font-weight: 600; letter-spacing: 0.06em; color: var(--co-ink); text-transform: uppercase; border-bottom: 1px solid var(--co-line); }
  .cc-table td { padding: 18px 20px; font-family: var(--co-sans); font-size: 14px; color: var(--co-text); border-bottom: 1px solid var(--co-line); }
  .cc-table__metric { font-weight: 600; color: var(--co-navy); }
  .cc-table tbody tr:hover { background: var(--co-snow); }

  .cc-supply { display: grid; grid-template-columns: 1fr; gap: 24px; }
  @media (min-width: 880px) { .cc-supply { grid-template-columns: repeat(5, 1fr); gap: 12px; } }
  .cc-supply__hub { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.12); padding: 22px; display: flex; flex-direction: column; gap: 8px; }
  .cc-supply__hub .co-num { font-size: 22px; color: var(--co-amber); line-height: 1; }
  .cc-supply__hub h3 { color: var(--co-white); margin: 0; font-size: 15px; }
  .cc-supply__hub p { font-family: var(--co-sans); font-size: 12px; color: rgba(255,255,255,0.7); margin: 0; line-height: 1.5; }

  .cc-cta { display: flex; flex-direction: column; gap: 18px; align-items: flex-start; max-width: 60ch; }
  .cc-cta h2 { color: var(--co-ink); }
  .cc-cta p { font-family: var(--co-sans); font-size: 17px; color: var(--co-mute); margin: 0; line-height: 1.65; }
</style>
