      </div>
    </div>
  </section>

  {/* Precision grading */}
  <section class="bg-surface-low px-4 py-20 md:px-8 md:py-24">
    <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <h2 class="serif-display mb-6 text-3xl font-bold leading-snug text-on-surface md:text-4xl lg:text-5xl">
          {copy.gradingTitle}
        </h2>
        <p class="mb-10 text-lg leading-relaxed text-on-surface-muted">{copy.gradingLead}</p>
        <div class="space-y-5">
          {copy.grades.map((g, idx) => (
            <div
              class:list={[
                'rounded-lg border-s-4 bg-surface-lowest p-6 shadow-editorial',
                idx === 0 ? 'border-orange' : 'border-teal',
              ]}
            >
              <h3 class="serif-display mb-2 text-xl font-bold text-on-surface">{g.title}</h3>
              <p class="text-sm leading-relaxed text-on-surface-muted">{g.body}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <img
          src={imgLab}
          alt={labAlt}
          width="600"
          height="800"
          class="mt-12 aspect-[3/4] w-full rounded-lg object-cover shadow-editorial"
          loading="lazy"
          decoding="async"
        />
        <img
          src={imgRoast}
          alt={roastAlt}
          width="600"
          height="800"
          class="aspect-[3/4] w-full rounded-lg object-cover shadow-editorial"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  {/* Specifications */}
  <section class="px-4 py-20 md:px-8 md:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="mb-12">
        <span class="eyebrow mb-2 block text-teal-dark">{copy.specEyebrow}</span>
        <h2 class="serif-display text-3xl font-bold text-on-surface md:text-4xl lg:text-5xl">
          {copy.specTitle}
        </h2>
      </div>
      <div class="overflow-x-auto rounded-lg border border-outline/40 bg-surface-lowest">
        <table class="w-full min-w-[640px] text-start">
          <thead>
            <tr class="bg-surface-mid">
              {copy.specHeaders.map((h) => (
                <th
                  scope="col"
                  class="eyebrow px-6 py-5 text-start text-on-surface-muted md:px-8 md:py-6"
                >
                  {h}
                </th>
              ))}
            </tr>
          </thead>
          <tbody class="divide-y divide-outline/30">
            {copy.specRows.map((row) => (
              <tr class="transition-colors hover:bg-surface-low">
                <th
                  scope="row"
                  class="px-6 py-5 text-start font-bold text-on-surface md:px-8 md:py-6"
                >
                  {row[0]}
                </th>
                <td class="px-6 py-5 text-on-surface-muted md:px-8 md:py-6">{row[1]}</td>
                <td class="px-6 py-5 text-on-surface-muted md:px-8 md:py-6">{row[2]}</td>
                <td class="px-6 py-5 text-xs italic text-orange-dark md:px-8 md:py-6">
                  {row[3]}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-6 text-xs italic text-on-surface-subtle">{copy.specNote}</p>
    </div>
  </section>

  {/* Equatorial supply chain */}
  <section class="bg-surface-deep px-4 py-20 text-white md:px-8 md:py-24">
    <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-12 md:grid-cols-2 md:gap-16">
      <div>
        <span class="eyebrow mb-2 block text-orange/90">{copy.supplyEyebrow}</span>
        <h2 class="serif-display mb-6 text-3xl font-bold md:text-4xl lg:text-5xl">
          {copy.supplyTitle}
        </h2>
        <p class="mb-8 text-lg leading-relaxed text-white/80">{copy.supplyBody}</p>
        <ul class="space-y-4">
          {copy.supplyPoints.map((p, idx) => (
            <li class="flex items-center gap-3">
              <span
                class:list={[
                  'inline-block h-2 w-2 rounded-full',
                  idx === 2 ? 'bg-orange' : 'bg-teal',
                ]}
                aria-hidden="true"
              ></span>
              <span class="text-white/90">{p}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="relative aspect-video overflow-hidden rounded-lg border border-white/10 bg-black/40">
        <img
          src={imgMap}
          alt={mapAlt}
          width="1200"
          height="675"
          class="h-full w-full object-cover opacity-50 mix-blend-luminosity"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  {/* CTA */}
  <section class="cta-gradient px-4 py-20 text-white md:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <h2 class="serif-display mb-4 text-3xl font-bold md:text-4xl">{copy.ctaTitle}</h2>
      <p class="mb-8 text-lg leading-relaxed text-white/85">{copy.ctaLead}</p>
      <a
        href={contactHref}
        class="inline-block rounded-md bg-orange px-8 py-4 text-xs font-bold uppercase tracking-widest text-white shadow-lg shadow-orange/20 transition-colors hover:bg-orange-dark"
      >
        {copy.ctaBtn}
      </a>
    </div>
  </section>
</main>

<SiteFooter locale={locale} />
