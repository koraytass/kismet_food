              <span class="eyebrow mb-3 inline-block bg-teal px-3 py-1 text-white">
                {copy.origins[1].badge}
              </span>
              <h3 class="serif-display mb-3 text-2xl font-bold md:text-4xl">
                {copy.origins[1].name}
              </h3>
