---

<SiteHeader locale={locale} currentPath={currentPath} />

<Breadcrumb
  locale={locale}
  items={[
    { name: tr.nav.products, href: productsHref },
    { name: copy.heroTitle },
  ]}
/>

<main id="main" class="bg-surface">
  {/* Editorial hero */}
  <section class="relative overflow-hidden">
    <div class="absolute inset-0">
      <img
        src={imgHero}
        alt={heroImgAlt}
        width="1920"
        height="1080"
        class="h-full w-full object-cover"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="absolute inset-0 bg-surface-deep/55"></div>
    </div>
    <div class="relative z-10 px-4 pb-24 pt-16 md:px-8 md:pb-32 md:pt-24">
      <div class="mx-auto max-w-7xl">
        <span class="eyebrow mb-4 block text-orange/90">{copy.eyebrow}</span>
        <h1 class="serif-display mb-8 max-w-4xl text-5xl font-bold leading-none tracking-tight text-white md:text-7xl lg:text-8xl">
          {copy.heroTitle}
        </h1>
        <div class="flex flex-col items-start gap-8 md:flex-row">
          <p class="max-w-xl text-lg leading-relaxed text-white/85">{copy.heroLead}</p>
          <div class="glass-dark rounded-lg border border-white/10 p-6 text-white md:max-w-sm">
            <p class="eyebrow mb-2 text-orange/90">{copy.verifiedTitle}</p>
            <p class="text-sm leading-relaxed text-white/85">{copy.verifiedBody}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Origins bento */}
  <section class="px-4 py-20 md:px-8 md:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="mb-12 flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
        <div>
          <span class="eyebrow mb-2 block text-teal-dark">{copy.originEyebrow}</span>
          <h2 class="serif-display text-3xl font-bold text-on-surface md:text-4xl lg:text-5xl">
            {copy.originTitle}
          </h2>
        </div>
        <p class="max-w-md text-on-surface-muted">{copy.originLead}</p>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-12 md:gap-10">
        <article class="group md:col-span-7">
          <div class="shadow-editorial relative overflow-hidden rounded-lg bg-surface-mid">
            <img
              src={imgEthiopia}
              alt={ethiopiaAlt}
              width="1200"
              height="900"
              class="aspect-[4/3] h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-surface-deep/70 via-surface-deep/10 to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 p-6 text-white md:p-10">
              <span class="eyebrow mb-3 inline-block bg-orange/90 px-3 py-1 text-white">
                {copy.origins[0].badge}
              </span>
              <h3 class="serif-display mb-3 text-2xl font-bold md:text-4xl">
                {copy.origins[0].name}
              </h3>
              <p class="max-w-md text-sm leading-relaxed text-white/85 md:text-base">
                {copy.origins[0].body}
              </p>
              <span class="mt-4 inline-block border-b-2 border-orange pb-1 text-xs font-bold uppercase tracking-widest">
                {copy.origins[0].link}
              </span>
            </div>
          </div>
        </article>

        <article class="group md:col-span-5">
