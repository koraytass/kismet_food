      <span class="eyebrow mb-6 block text-orange-dark">{copy.eyebrow}</span>
      <h1 class="serif-display mb-8 text-4xl font-bold leading-tight text-on-surface md:text-5xl lg:text-6xl">
        {copy.heroTitle}
      </h1>
      <p class="mb-6 text-lg leading-relaxed text-on-surface-muted md:text-xl">
        {copy.heroLead}
      </p>
      <p class="eyebrow text-on-surface-subtle">{copy.updated}</p>
    </div>
  </section>

  {/* Body */}
  <section class="px-4 pb-24 md:px-8">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-12 md:grid-cols-12 md:gap-16">
      {/* Sidebar TOC */}
      <aside class="md:col-span-3">
        <div class="md:sticky md:top-28 space-y-10">
          <nav aria-label={copy.tocTitle}>
            <h2 class="eyebrow mb-4 text-orange-dark">{copy.tocTitle}</h2>
            <ul class="space-y-3">
              {copy.toc.map((item) => (
                <li>
                  <a
                    href={`#${item.id}`}
                    class="block text-sm text-on-surface-muted hover:text-teal-dark"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <div class="rounded-lg bg-surface-low p-6">
            <h3 class="eyebrow mb-3 text-on-surface-subtle">{copy.legalAsideTitle}</h3>
            <p class="mb-4 text-sm leading-relaxed text-on-surface-muted">
              {copy.legalAsideBody}
            </p>
            <a
              href={`mailto:${copy.legalEmail}`}
              class="text-sm font-bold text-teal-dark underline-offset-4 hover:underline"
            >
              {copy.legalEmail}
            </a>
          </div>
        </div>
      </aside>

      {/* Document body */}
      <article class="md:col-span-9 max-w-3xl">
        <div class="space-y-14">
          {copy.sections.map((s) => (
            <>
              <section id={s.id} class="scroll-mt-32">
                <div class="mb-6 flex items-baseline gap-4">
                  <span class="serif-display text-2xl italic text-orange-dark">{s.n}</span>
                  <h2 class="serif-display text-2xl font-bold text-on-surface md:text-3xl">{s.h}</h2>
                </div>
                <div class="space-y-5 leading-relaxed text-on-surface-muted">
                  {s.p.map((para) => <p>{para}</p>)}
                </div>
              </section>

              {/* Decorative asymmetric image + aside, between "How We Use" (03) and "Sharing" (04) */}
              {s.id === 'use' && (
                <div class="relative py-6">
                  <div class="grid grid-cols-1 items-center gap-10 md:grid-cols-[1fr_1fr]">
                    <div class="shadow-editorial overflow-hidden rounded-xl">
                      <img
                        src={mapImg}
                        alt=""
                        class="h-64 w-full object-cover"
                        loading="lazy"
                        decoding="async"
                        width="800"
                        height="500"
                      />
                    </div>
                    <div>
                      <h3 class="serif-display mb-3 text-2xl italic text-on-surface">
                        {copy.securityTitle}
                      </h3>
                      <p class="text-sm leading-relaxed text-on-surface-muted">
                        {copy.securityBody}
                      </p>
                    </div>
                  </div>
                </div>
              )}
            </>
          ))}
        </div>
      </article>
    </div>
  </section>
</main>

<SiteFooter locale={locale} />
