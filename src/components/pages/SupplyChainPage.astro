---
import type { Locale } from '@/i18n';
import { localePath } from '@/i18n';
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
import CorpPageHero from '../v3/CorpPageHero.astro';
import CorpSection from '../v3/CorpSection.astro';

interface Props { locale: Locale; currentPath: string }
const { locale, currentPath } = Astro.props;

const copy = {
  tr: {
    eyebrow: 'TEDARİK ZİNCİRİ · UÇTAN UCA',
    heroTitle: 'Disiplin, sevkiyat takvimini korur.',
    heroLead: 'Kalite, lojistik ve evrak — üç disiplini tek operasyon olarak yönetiyoruz. Numune doğrulamasından gümrük çıkışına, her sevkiyatın 14 kontrol noktası var.',
    qualityEyebrow: 'KALİTE KONTROL', qualityTitle: 'Lab + Saha', qualityItalic: 'eşlemesi.',
    qualityLead: 'Eurofins, SGS, Bureau Veritas akredite üçüncü-taraf laboratuvar parti bazında. Saha numunesi, transit numune ve kabul numunesi karşılaştırılır.',
    qualityPoints: [
      { h: 'Aflatoksin', d: 'AB toplam 10 ppb / B1 5 ppb (HPLC)' },
      { h: 'Pestisit MRL', d: 'EU Reg 396/2005 · GC-MS/LC-MS 200+ analit' },
      { h: 'Mikrobiyoloji', d: 'Salmonella negatif /25g · E. coli <10²' },
      { h: 'Ağır Metal', d: 'Pb 2.0 ppm · Cd 0.20 · As 1.0 · Hg 0.10' },
      { h: 'Nem', d: 'Karl Fischer veya halojen lamba' },
      { h: 'Kalibre', d: 'Optik + manuel ayıklama' },
    ],
    logEyebrow: 'LOJİSTİK', logTitle: 'Liman ve transit', logItalic: 'haritası.',
    logLead: 'Ana çıkış limanları ve transit pencereleri. FOB, CIF, CFR, DDP teslim akışları alıcı operasyonuna göre eşleştirilir.',
    ports: [
      { h: 'Mersin / İskenderun', d: 'Türkiye ana çıkış · Avrupa transit 8-12 gün' },
      { h: 'Ambarlı (İstanbul)', d: 'Akdeniz + Karadeniz · MENA transit 5-9 gün' },
      { h: 'Cıbuti / Doraleh', d: 'Etiyopya kahve · Türkiye transit 18-25 gün' },
      { h: 'Tema (Accra)', d: 'Gana kakao · Avrupa transit 18-22 gün' },
      { h: 'Cat Lai (HCMC)', d: 'Vietnam kahve & kaju · Türkiye 30-35 gün' },
      { h: 'Cochin / Tuticorin', d: 'Hindistan baharat · Türkiye 22-28 gün' },
    ],
    procEyebrow: 'B2B SÜREÇ', procTitle: '4 adımda', procItalic: 'partner olun.',
    steps: [
      { n: '01', h: 'Brief & Spec', d: 'İhtiyaç (ürün, hacim, kalite spec, teslim) ve risk takvimi paylaşılır. 24 saat içinde ön değerlendirme.' },
      { n: '02', h: 'Numune & Onay', d: 'Menşeden 50-500g numune (3-5 iş günü express). Lab analizi + duyusal değerlendirme.' },
      { n: '03', h: 'Sözleşme & Hasat', d: 'Yıllık formula sözleşme veya spot kontrat. Çiftçi/kooperatif ile yıllık taahhüt.' },
      { n: '04', h: 'Sevkiyat & İzlenebilirlik', d: 'FOB/CIF/CFR/DDP. Her parti lot bazlı izlenebilirlik sertifikası + EUDR geo-trace.' },
    ],
    ctaTitle: 'Kendi tedarik akışınızı tasarlayın.',
    ctaLead: 'Tek konteyner ya da yıllık formula — masamız 24 saat içinde brief\'i değerlendirir, numune sevkiyat planını başlatır.',
    ctaBtn: 'Tedarik Talebi',
  },
  en: {
    eyebrow: 'SUPPLY CHAIN · END-TO-END',
    heroTitle: 'Discipline protects the shipping calendar.',
    heroLead: 'Quality, logistics and documentation — three disciplines run as one operation. From sample validation to customs clearance, every shipment has 14 control points.',
    qualityEyebrow: 'QUALITY CONTROL', qualityTitle: 'Lab + Field', qualityItalic: 'mapping.',
    qualityLead: 'Eurofins, SGS, Bureau Veritas accredited third-party labs per batch. Field, transit and acceptance samples are cross-checked.',
    qualityPoints: [
      { h: 'Aflatoxin', d: 'EU total 10 ppb / B1 5 ppb (HPLC)' },
      { h: 'Pesticide MRL', d: 'EU Reg 396/2005 · GC-MS/LC-MS 200+ analytes' },
      { h: 'Microbiology', d: 'Salmonella negative /25g · E. coli <10²' },
      { h: 'Heavy Metals', d: 'Pb 2.0 ppm · Cd 0.20 · As 1.0 · Hg 0.10' },
      { h: 'Moisture', d: 'Karl Fischer or halogen meter' },
      { h: 'Calibration', d: 'Optical + manual sorting' },
    ],
    logEyebrow: 'LOGISTICS', logTitle: 'Port and transit', logItalic: 'map.',
    logLead: 'Principal departure ports and transit windows. FOB, CIF, CFR, DDP flows matched to buyer operations.',
    ports: [
      { h: 'Mersin / İskenderun', d: 'Türkiye main exit · EU transit 8-12 days' },
      { h: 'Ambarlı (Istanbul)', d: 'Med + Black Sea · MENA transit 5-9 days' },
      { h: 'Djibouti / Doraleh', d: 'Ethiopia coffee · Türkiye transit 18-25 days' },
      { h: 'Tema (Accra)', d: 'Ghana cocoa · EU transit 18-22 days' },
      { h: 'Cat Lai (HCMC)', d: 'Vietnam coffee & cashew · Türkiye 30-35 days' },
      { h: 'Cochin / Tuticorin', d: 'India spices · Türkiye 22-28 days' },
    ],
    procEyebrow: 'B2B PROCESS', procTitle: 'Become a partner', procItalic: 'in 4 steps.',
    steps: [
      { n: '01', h: 'Brief & Spec', d: 'Need (product, volume, quality spec, delivery) and risk calendar shared. Pre-assessment in 24 hours.' },
      { n: '02', h: 'Sample & Approval', d: '50-500g sample from origin (3-5 working days express). Lab analysis + sensory evaluation.' },
      { n: '03', h: 'Contract & Harvest', d: 'Annual formula contract or spot. Farmer/cooperative annual commitment.' },
      { n: '04', h: 'Shipment & Traceability', d: 'FOB/CIF/CFR/DDP. Lot-level traceability certificate + EUDR geo-trace.' },
    ],
    ctaTitle: 'Design your supply flow.',
    ctaLead: 'A single container or annual formula — our desk evaluates the brief in 24 hours and triggers sample shipment.',
    ctaBtn: 'Request Supply',
  },
  ar: {
    eyebrow: 'سلسلة التوريد · شاملة',
    heroTitle: 'الانضباط يحمي تقويم الشحن.',
    heroLead: 'الجودة واللوجستيات والوثائق — ثلاث ضوابط كعملية واحدة. من تحقق العينة إلى التخليص، ١٤ نقطة تحكم لكل شحنة.',
    qualityEyebrow: 'ضبط الجودة', qualityTitle: 'مختبر + ميدان', qualityItalic: 'متطابق.',
    qualityLead: 'Eurofins وSGS وBV — مختبرات طرف ثالث معتمدة لكل دفعة.',
    qualityPoints: [
      { h: 'الأفلاتوكسين', d: 'EU ١٠ ppb / B1 ٥ ppb' },
      { h: 'المبيدات', d: 'EU Reg 396/2005 · ٢٠٠+ مادة' },
      { h: 'الميكروبيولوجيا', d: 'سالمونيلا سلبي · إي كولاي <١٠²' },
      { h: 'المعادن الثقيلة', d: 'Pb ٢٫٠ · Cd ٠٫٢٠ · As ١٫٠' },
      { h: 'الرطوبة', d: 'Karl Fischer أو هالوجين' },
      { h: 'المعايرة', d: 'بصري + يدوي' },
    ],
    logEyebrow: 'لوجستيات', logTitle: 'خريطة الموانئ', logItalic: 'والعبور.',
    logLead: 'الموانئ الرئيسية ونوافذ العبور. تدفقات FOB/CIF/CFR/DDP حسب عملية المشتري.',
    ports: [
      { h: 'مرسين / إسكندرون', d: 'مخرج تركيا الرئيسي · عبور أوروبا ٨-١٢ يوم' },
      { h: 'أمبارلي (إسطنبول)', d: 'متوسط + بحر أسود · MENA ٥-٩ يوم' },
      { h: 'جيبوتي / Doraleh', d: 'قهوة إثيوبيا · تركيا ١٨-٢٥ يوم' },
      { h: 'تيما (أكرا)', d: 'كاكاو غانا · أوروبا ١٨-٢٢ يوم' },
      { h: 'Cat Lai', d: 'فيتنام · تركيا ٣٠-٣٥ يوم' },
      { h: 'كوتشي', d: 'الهند توابل · تركيا ٢٢-٢٨ يوم' },
    ],
    procEyebrow: 'مسار B2B', procTitle: 'كن شريكاً', procItalic: 'في ٤ خطوات.',
    steps: [
      { n: '٠١', h: 'الموجز والمواصفات', d: 'الحاجة وتقويم المخاطر. تقييم أولي خلال ٢٤ ساعة.' },
      { n: '٠٢', h: 'العينة والاعتماد', d: '٥٠-٥٠٠ غ من المنشأ. تحليل + تقييم حسي.' },
      { n: '٠٣', h: 'العقد والحصاد', d: 'عقد سنوي أو فوري. التزام مع المزارع/التعاونية.' },
      { n: '٠٤', h: 'الشحن والتتبع', d: 'FOB/CIF/CFR/DDP. شهادة تتبع لكل دفعة + EUDR.' },
    ],
    ctaTitle: 'صمم تدفق توريدك.',
    ctaLead: 'حاوية أو صيغة سنوية — يقيّم مكتبنا خلال ٢٤ ساعة ويبدأ شحن العينة.',
    ctaBtn: 'طلب توريد',
  },
}[locale];

const heroBg = 'https://images.unsplash.com/photo-1494412519320-aa613dfb7738?auto=format&fit=crop&w=2400&q=80';
---

<SiteHeader locale={locale} currentPath={currentPath} />

<main id="main">
  <CorpPageHero
    locale={locale}
    eyebrow={copy.eyebrow}
    title={copy.heroTitle}
    lede={copy.heroLead}
    background={heroBg}
    meta={[
      { label: 'Control points', value: '14 / shipment' },
      { label: 'On-time', value: '99.8%' },
      { label: 'Audit', value: '3rd-party batch' },
      { label: 'EUDR', value: 'compliant' },
    ]}
  />

  <CorpSection variant="white" id="quality" eyebrow={copy.qualityEyebrow} title={copy.qualityTitle} italic={copy.qualityItalic} lede={copy.qualityLead}>
    <div class="sc-grid">
      {copy.qualityPoints.map((p, i) => (
        <article class="sc-card">
          <span class="co-num sc-card__num">0{i + 1}</span>
          <h3 class="co-h3">{p.h}</h3>
          <p>{p.d}</p>
        </article>
      ))}
    </div>
  </CorpSection>

  <CorpSection variant="snow" eyebrow={copy.logEyebrow} title={copy.logTitle} italic={copy.logItalic} lede={copy.logLead}>
    <div class="sc-ports">
      {copy.ports.map((p) => (
        <article class="sc-port">
          <h3 class="co-h3">{p.h}</h3>
          <p>{p.d}</p>
        </article>
      ))}
    </div>
  </CorpSection>

  <CorpSection variant="navy" id="process" eyebrow={copy.procEyebrow} title={copy.procTitle} italic={copy.procItalic}>
    <ol class="sc-steps">
      {copy.steps.map((s) => (
        <li>
          <span class="co-num sc-step__num">{s.n}</span>
          <div>
            <h3 class="co-h3">{s.h}</h3>
            <p>{s.d}</p>
          </div>
        </li>
      ))}
    </ol>
  </CorpSection>

  <CorpSection variant="snow" compact>
    <div class="sc-cta">
      <h2 class="co-h2">{copy.ctaTitle}</h2>
      <p>{copy.ctaLead}</p>
      <a href={localePath('/contact/request-quote/', locale)} class="co-btn co-btn--primary">{copy.ctaBtn} <span aria-hidden="true">→</span></a>
    </div>
  </CorpSection>
</main>

<SiteFooter locale={locale} />

<style>
  .sc-grid { display: grid; grid-template-columns: 1fr; gap: 16px; }
  @media (min-width: 720px) { .sc-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; } }
  @media (min-width: 1080px) { .sc-grid { grid-template-columns: repeat(3, 1fr); } }
  .sc-card { background: var(--co-snow); border: 1px solid var(--co-line); padding: 24px; display: flex; flex-direction: column; gap: 10px; }
  .sc-card__num { font-size: 24px; color: var(--co-amber); line-height: 1; }
  .sc-card h3 { color: var(--co-ink); margin: 0; }
  .sc-card p { font-family: var(--co-sans); font-size: 14px; color: var(--co-mute); margin: 0; line-height: 1.6; }

  .sc-ports { display: grid; grid-template-columns: 1fr; gap: 0; border-top: 1px solid var(--co-line); }
  @media (min-width: 720px) { .sc-ports { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1080px) { .sc-ports { grid-template-columns: repeat(3, 1fr); } }
  .sc-port { padding: 24px; border-bottom: 1px solid var(--co-line); border-right: 1px solid var(--co-line); transition: background 200ms ease; }
  .sc-port:hover { background: var(--co-white); }
  .sc-port h3 { color: var(--co-navy); margin: 0 0 8px; font-size: 18px; }
  .sc-port p { font-family: var(--co-sans); font-size: 13px; color: var(--co-mute); margin: 0; line-height: 1.55; }

  .sc-steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: 1px; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.12); }
  @media (min-width: 880px) { .sc-steps { grid-template-columns: repeat(4, 1fr); } }
  .sc-steps li { background: rgba(255,255,255,0.02); padding: 28px 24px; display: flex; flex-direction: column; gap: 12px; }
  .sc-step__num { font-size: 28px; color: var(--co-amber); line-height: 1; }
  .sc-steps h3 { color: var(--co-white); margin: 0; font-size: 17px; }
  .sc-steps p { font-family: var(--co-sans); font-size: 13px; color: rgba(255,255,255,0.7); margin: 0; line-height: 1.55; }

  .sc-cta { display: flex; flex-direction: column; gap: 18px; align-items: flex-start; max-width: 60ch; }
  .sc-cta h2 { color: var(--co-ink); }
  .sc-cta p { font-family: var(--co-sans); font-size: 17px; color: var(--co-mute); margin: 0; line-height: 1.65; }
</style>
