---

<SiteHeader locale={locale} currentPath={currentPath} />

<Breadcrumb
  locale={locale}
  items={[{ name: tr.nav.supply }]}
/>

<main id="main" class="bg-surface">
  {/* Hero */}
  <section class="relative overflow-hidden bg-surface-low">
    <div class="absolute inset-0 z-0">
      <img
        src={heroImg}
        alt=""
        width="1920"
        height="1080"
        class="h-full w-full object-cover opacity-70"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-surface via-surface/50 to-transparent"></div>
    </div>
    <div class="relative z-10 mx-auto max-w-7xl px-4 py-24 md:px-8 md:py-32 lg:py-40">
      <div class="max-w-2xl">
        <span class="eyebrow mb-6 block text-orange-dark">{copy.eyebrow}</span>
        <h1 class="serif-display mb-8 text-4xl font-bold leading-tight text-on-surface md:text-5xl lg:text-7xl">
          {copy.heroTitle}<br />
          <span class="italic font-normal text-teal-dark">{copy.heroTitleItalic}</span>
        </h1>
        <p class="mb-10 max-w-xl text-lg leading-relaxed text-on-surface-muted md:text-xl">
          {copy.heroLead}
        </p>
        <div class="flex items-center gap-4">
          <span class="h-px w-12 bg-outline"></span>
          <p class="eyebrow text-on-surface">{copy.heroTag}</p>
        </div>
      </div>
    </div>
  </section>

  {/* Traceability */}
  <section class="px-4 py-20 md:px-8 md:py-24">
    <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <span class="eyebrow mb-4 block text-teal-dark">{copy.traceEyebrow}</span>
        <h2 class="serif-display mb-6 text-3xl font-bold text-on-surface md:text-4xl lg:text-5xl">
          {copy.traceTitle}
        </h2>
        <p class="mb-10 max-w-xl text-lg leading-relaxed text-on-surface-muted">
          {copy.traceLead}
        </p>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          {copy.traceCards.map((c) => (
            <article class="rounded-lg bg-surface-low p-6">
              <h3 class="serif-display mb-2 text-lg font-bold text-on-surface">{c.t}</h3>
              <p class="text-sm leading-relaxed text-on-surface-muted">{c.d}</p>
            </article>
          ))}
        </div>
      </div>
      <div class="relative">
        <img
          src={traceImg}
          alt=""
          width="1000"
          height="1250"
          class="shadow-editorial aspect-[4/5] w-full rounded-lg object-cover"
          loading="lazy"
          decoding="async"
        />
        <div class="shadow-editorial absolute -bottom-8 -start-6 max-w-xs rounded-lg bg-teal p-8 text-white md:-start-12 md:-bottom-12">
          <p class="serif-display mb-2 text-xl italic leading-snug md:text-2xl">
            {copy.traceQuote}
          </p>
          <p class="eyebrow text-[10px] text-white/80">{copy.traceBatch}</p>
        </div>
      </div>
    </div>
  </section>

  {/* QC Protocol */}
  <section class="bg-surface-low px-4 py-20 md:px-8 md:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="mb-12 flex flex-col items-start justify-between gap-8 md:flex-row md:items-end">
        <div class="max-w-2xl">
          <span class="eyebrow mb-4 block text-orange-dark">{copy.qcEyebrow}</span>
          <h2 class="serif-display text-3xl font-bold text-on-surface md:text-4xl lg:text-5xl">
            {copy.qcTitle}
          </h2>
        </div>
        <div class="flex flex-wrap gap-3">
          {copy.qcBadges.map((b) => (
            <span class="flex items-center gap-2 rounded-full border border-outline/30 bg-surface-lowest px-5 py-2 text-[11px] font-semibold uppercase tracking-widest text-on-surface">
              <span class="h-2 w-2 rounded-full bg-orange"></span>
              {b}
            </span>
          ))}
        </div>
      </div>
      <div class="grid grid-cols-1 gap-px overflow-hidden rounded-xl bg-outline/20 md:grid-cols-3">
        {copy.qc.map((item, i) => (
          <article class="bg-surface p-10 transition-colors hover:bg-surface-mid">
            <svg class="mb-6 h-10 w-10 text-teal-dark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={qcIcons[i]} />
            </svg>
            <h3 class="serif-display mb-3 text-xl font-bold text-on-surface md:text-2xl">{item.t}</h3>
            <p class="leading-relaxed text-on-surface-muted">{item.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* Turkish Ports */}
  <section class="px-4 py-20 md:px-8 md:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="mb-12 max-w-3xl">
        <span class="eyebrow mb-4 block text-teal-dark">{copy.portsEyebrow}</span>
        <h2 class="serif-display mb-6 text-3xl font-bold text-on-surface md:text-4xl lg:text-5xl">
          {copy.portsTitle}
        </h2>
        <p class="text-lg leading-relaxed text-on-surface-muted">{copy.portsLead}</p>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {copy.ports.map((p) => (
          <article class="rounded-lg border border-outline/20 bg-surface-lowest p-8">
            <h3 class="serif-display mb-3 text-2xl font-bold text-teal-dark">{p.t}</h3>
            <p class="leading-relaxed text-on-surface-muted">{p.d}</p>
          </article>
        ))}
      </div>
      <div class="mt-10 rounded-lg bg-surface-mid p-8 md:p-10">
        <span class="eyebrow mb-2 block text-orange-dark">{copy.incotermsEyebrow}</span>
        <h3 class="serif-display mb-3 text-2xl font-bold text-on-surface md:text-3xl">{copy.incotermsTitle}</h3>
        <p class="max-w-3xl leading-relaxed text-on-surface-muted">{copy.incotermsLead}</p>
      </div>
    </div>
  </section>

  {/* Global Transit Network */}
  <section class="bg-surface-deep px-4 py-20 text-white md:px-8 md:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="mb-12 text-center">
        <span class="eyebrow mb-4 block text-orange">{copy.networkEyebrow}</span>
        <h2 class="serif-display mb-6 text-3xl font-bold md:text-4xl lg:text-5xl">
          {copy.networkTitle}
        </h2>
        <p class="mx-auto max-w-2xl text-white/70">{copy.networkLead}</p>
      </div>
      <div class="relative overflow-hidden rounded-xl border border-white/10 bg-white/5">
        <img
          src={mapImg}
          alt=""
          width="1800"
          height="900"
          class="aspect-video w-full object-cover opacity-30"
          loading="lazy"
          decoding="async"
        />
        <div class="absolute inset-0 grid grid-cols-2 gap-6 p-6 md:grid-cols-4 md:gap-8 md:p-10">
          {copy.networkHubs.map((h, i) => (
            <div class={['rounded-lg border-s backdrop-blur-sm bg-black/20 p-4', i % 2 === 0 ? 'border-teal/60' : 'border-orange/60'].join(' ')}>
              <span class="serif-display block text-xl font-bold text-white md:text-2xl">{h.t}</span>
              <p class="mt-2 text-[11px] uppercase tracking-widest text-white/60">{h.d}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* Partnering Process */}
  <section class="bg-surface px-4 py-20 md:px-8 md:py-24">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-12 md:grid-cols-3 md:gap-16">
      <div>
        <span class="eyebrow mb-4 block text-orange-dark">{copy.processEyebrow}</span>
        <h2 class="serif-display mb-6 text-3xl font-bold text-on-surface md:text-4xl lg:text-5xl">
          {copy.processTitle}
        </h2>
        <p class="mb-8 leading-relaxed text-on-surface-muted">{copy.processLead}</p>
        <a href={contactHref} class="group inline-flex items-center gap-4">
          <span class="text-xs font-bold uppercase tracking-widest text-on-surface">{copy.processBtn}</span>
          <span class="h-[2px] w-10 bg-orange transition-all duration-300 group-hover:w-16"></span>
        </a>
      </div>
      <ol class="md:col-span-2 grid grid-cols-1 gap-10 md:grid-cols-2 md:gap-12">
        {copy.process.map((p) => (
          <li class="flex gap-6">
            <span class="serif-display text-4xl italic font-bold text-outline/40">{p.n}</span>
            <div>
              <h3 class="serif-display mb-3 text-xl font-bold text-on-surface">{p.t}</h3>
              <p class="text-sm leading-relaxed text-on-surface-muted">{p.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* CTA */}
  <section class="cta-gradient px-4 py-20 text-white md:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <h2 class="serif-display mb-4 text-3xl font-bold md:text-4xl">{copy.ctaTitle}</h2>
      <p class="mb-8 text-lg leading-relaxed text-white/85">{copy.ctaLead}</p>
      <a
        href={contactHref}
        class="inline-block rounded-md bg-orange px-8 py-4 text-xs font-bold uppercase tracking-widest text-white shadow-lg shadow-orange/20 transition-colors hover:bg-orange-dark"
      >
        {copy.ctaBtn}
      </a>
    </div>
  </section>
</main>

<SiteFooter locale={locale} />
