---

<SiteHeader locale={locale} currentPath={currentPath} />

<Breadcrumb locale={locale} items={[{ name: tr.nav.about }]} />

<main id="main" class="bg-surface">
  {/* ========== 1. HERO — editorial with side image ========== */}
  <section class="relative overflow-hidden px-4 py-16 md:px-8 md:py-24 lg:py-28">
    {/* Side image (desktop: right 3/5, mobile: full behind) */}
    <div class="absolute inset-y-0 end-0 z-0 w-full md:w-3/5">
      <img
        src={heroImg}
        alt=""
        class="h-full w-full object-cover opacity-40 md:opacity-100"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width="1200"
        height="1500"
      />
    </div>

    <div class="relative z-10 mx-auto max-w-7xl">
      <div class="max-w-3xl">
        <span class="eyebrow mb-6 block text-orange-dark">{copy.eyebrow}</span>
        <h1 class="serif-display mb-10 text-5xl font-bold leading-[0.95] tracking-tight text-on-surface md:text-7xl lg:text-8xl">
          {copy.heroTitle1}
          <br />
          <span class="ms-12 italic md:ms-24">{copy.heroTitleItalic}</span>
        </h1>
        <div class="shadow-editorial ms-0 max-w-xl border-s-4 border-teal-dark bg-surface/95 p-8 backdrop-blur-sm md:ms-12 md:p-10">
          <p class="text-lg font-light leading-relaxed text-on-surface-muted">
            {copy.heroLead}
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ========== 2. VISION & VALUES ========== */}
  <section class="px-4 py-20 md:px-8 md:py-28">
    <div class="mx-auto w-full max-w-7xl">
      <div class="grid grid-cols-1 items-end gap-10 md:grid-cols-[5fr_7fr] md:gap-16">
        <div>
          <span class="eyebrow mb-4 block text-orange-dark">{copy.visionEyebrow}</span>
          <h2 class="serif-display mb-6 text-4xl font-bold text-on-surface md:text-5xl">
            {copy.visionTitle}
          </h2>
          <p class="text-lg leading-relaxed text-on-surface-muted">{copy.visionLead}</p>
        </div>
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2">
          <article class="space-y-4 bg-surface-low p-8 transition-colors duration-500 hover:bg-surface-mid">
            <svg class="h-10 w-10 text-teal-dark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2l8 4v6c0 5-3.4 9.3-8 10-4.6-.7-8-5-8-10V6l8-4zm-1 13.4l6-6-1.4-1.4-4.6 4.6-2.6-2.6L7 11.4l4 4z"></path>
            </svg>
            <h3 class="serif-display text-xl font-bold text-on-surface">{copy.valueA.t}</h3>
            <p class="text-sm leading-relaxed text-on-surface-muted">{copy.valueA.d}</p>
          </article>
          <article class="mt-0 space-y-4 bg-surface-low p-8 transition-colors duration-500 hover:bg-surface-mid sm:mt-8">
            <svg class="h-10 w-10 text-teal-dark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2a10 10 0 100 20 10 10 0 000-20zm6.93 9h-3a15.7 15.7 0 00-1.38-5.58A8 8 0 0118.93 11zM12 4.1c.8 1.1 1.8 3.3 2 6.9h-4c.2-3.6 1.2-5.8 2-6.9zM4.26 14A8 8 0 014 12c0-.7.1-1.4.26-2h3.4c-.1.7-.1 1.3-.1 2s0 1.3.1 2h-3.4zm.82 2h3a15.7 15.7 0 001.38 5.58A8 8 0 015.08 16zM11 16h2a14 14 0 01-1 5.5 14 14 0 01-1-5.5zm0-4a26 26 0 010-4h2a26 26 0 010 4h-2zm3.55 10.58A15.7 15.7 0 0016 16h3a8 8 0 01-4.45 5.58zM19.74 14h-3.4c.1-.7.1-1.3.1-2s0-1.3-.1-2h3.4c.16.6.26 1.3.26 2s-.1 1.4-.26 2z"></path>
            </svg>
            <h3 class="serif-display text-xl font-bold text-on-surface">{copy.valueB.t}</h3>
            <p class="text-sm leading-relaxed text-on-surface-muted">{copy.valueB.d}</p>
          </article>
        </div>
      </div>
    </div>
  </section>

  {/* ========== 3. HERITAGE — Silk Road ========== */}
  <section class="bg-surface-mid px-4 py-24 md:px-8 md:py-32">
    <div class="mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-16 md:grid-cols-2 md:gap-20">
      {/* Left: antique map + overlapping coffee-pot vignette */}
      <div class="relative">
        <div class="shadow-editorial relative aspect-[4/5] overflow-hidden bg-surface-container-high">
          <img
            src={silkRoadImg}
            alt=""
            class="h-full w-full object-cover"
            loading="lazy"
            decoding="async"
            width="800"
            height="1000"
          />
        </div>
        <div class="absolute -bottom-8 -end-6 hidden h-48 w-48 overflow-hidden border-[10px] border-surface shadow-xl lg:block">
          <img
            src={coffeePotImg}
            alt=""
            class="h-full w-full object-cover"
            loading="lazy"
            decoding="async"
            width="300"
            height="300"
          />
        </div>
      </div>
      {/* Right: copy block */}
      <div class="space-y-6">
        <span class="eyebrow block text-orange-dark">{copy.heritageEyebrow}</span>
        <h2 class="serif-display text-4xl font-bold leading-tight text-on-surface md:text-5xl">
          {copy.heritageTitle1}
          <br />
          {copy.heritageTitle2}
        </h2>
        <div class="h-1 w-20 bg-teal-dark"></div>
        <p class="text-lg leading-relaxed text-on-surface-muted">{copy.heritageLead}</p>
        <p class="italic leading-relaxed text-on-surface-subtle">{copy.heritageQuote}</p>
      </div>
    </div>
  </section>

  {/* ========== 4. JOURNEY — alternating timeline ========== */}
  <section class="px-4 py-24 md:px-8 md:py-32">
    <div class="mx-auto w-full max-w-7xl">
      <div class="mb-16 text-center md:mb-20">
        <span class="eyebrow mb-4 block text-orange-dark">{copy.journeyEyebrow}</span>
        <h2 class="serif-display text-4xl font-bold text-on-surface md:text-5xl">
          {copy.journeyTitle}
        </h2>
      </div>

      <ol class="relative space-y-16 md:space-y-24">
        {/* Desktop center rail */}
        <span
          aria-hidden="true"
          class="absolute start-1/2 top-0 hidden h-full w-px -translate-x-1/2 bg-outline/40 md:block"
        ></span>

        {copy.journey.map((step, idx) => {
          const isLeft = idx % 2 === 0;
          const isLast = idx === copy.journey.length - 1;
          return (
            <li class="relative flex flex-col items-stretch gap-4 md:flex-row md:items-center md:gap-8">
              {/* LEFT half */}
              <div class={`hidden md:block md:w-5/12 ${isLeft ? 'md:text-end' : 'md:order-3'}`}>
                {isLeft ? (
                  <span class="serif-display block text-4xl font-bold text-orange/40 md:text-5xl">
                    {step.y}
                  </span>
                ) : (
                  <article class={`shadow-editorial rounded-md bg-surface-lowest p-8 text-start ${isLast ? 'border-t-4 border-orange' : ''}`}>
                    <h3 class="mb-2 text-lg font-bold tracking-wide text-on-surface md:text-xl">{step.t}</h3>
                    <p class="text-sm leading-relaxed text-on-surface-muted">{step.d}</p>
                  </article>
                )}
              </div>

              {/* Center dot */}
              <div class="relative hidden items-center justify-center md:order-2 md:flex md:w-auto">
                <span
                  class={`z-10 flex h-12 w-12 items-center justify-center rounded-full border-4 border-surface ${isLast ? 'bg-orange shadow-lg shadow-orange/30' : 'bg-surface-mid'}`}
                >
                  <span class={`block h-3 w-3 rounded-full ${isLast ? 'bg-white' : 'bg-teal-dark'}`}></span>
                </span>
              </div>

              {/* RIGHT half */}
              <div class={`md:w-5/12 ${isLeft ? 'md:order-3' : 'md:text-start'}`}>
                {isLeft ? (
                  <article class={`shadow-editorial rounded-md bg-surface-lowest p-8 ${isLast ? 'border-t-4 border-orange' : ''}`}>
                    <span class="serif-display mb-2 block text-2xl font-bold text-orange md:hidden">{step.y}</span>
                    <h3 class="mb-2 text-lg font-bold tracking-wide text-on-surface md:text-xl">{step.t}</h3>
                    <p class="text-sm leading-relaxed text-on-surface-muted">{step.d}</p>
                  </article>
                ) : (
                  <span class="serif-display hidden text-4xl font-bold text-orange/40 md:block md:text-5xl">
                    {step.y}
                  </span>
                )}
              </div>

              {/* Mobile: year + content stacked */}
              {!isLeft && (
                <article class={`shadow-editorial block rounded-md border-s-2 border-orange/60 bg-surface-lowest p-6 md:hidden ${isLast ? 'border-t-4 border-orange' : ''}`}>
                  <span class="serif-display mb-2 block text-2xl font-bold text-orange">{step.y}</span>
                  <h3 class="mb-2 text-lg font-bold tracking-wide text-on-surface">{step.t}</h3>
                  <p class="text-sm leading-relaxed text-on-surface-muted">{step.d}</p>
                </article>
              )}
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  {/* ========== 5. LEADERSHIP — dark band with portraits ========== */}
  <section class="overflow-hidden bg-surface-low px-4 py-24 md:px-8 md:py-32">
    <div class="mx-auto w-full max-w-7xl">
      <div class="mb-16 flex flex-col items-start justify-between gap-8 md:mb-20 md:flex-row md:items-end">
        <div class="max-w-2xl">
          <span class="eyebrow mb-4 block text-orange">{copy.leadershipEyebrow}</span>
          <h2 class="serif-display text-4xl font-bold text-on-surface md:text-5xl">{copy.leadershipTitle}</h2>
        </div>
        <p class="max-w-sm text-sm text-on-surface-muted">{copy.leadershipLead}</p>
      </div>

      <div class="grid grid-cols-1 gap-1 sm:grid-cols-2 md:grid-cols-3">
        {copy.leaders.map((ld, idx) => (
          <article class="group relative aspect-[3/4] cursor-pointer overflow-hidden border border-outline/20 bg-surface">
            <img
              src={leaderImgs[idx]}
              alt=""
              class="h-full w-full object-cover brightness-95 grayscale-[0.35] transition-all duration-700 group-hover:brightness-100 group-hover:grayscale-0"
              loading="lazy"
              decoding="async"
              width="600"
              height="800"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-surface/95 via-surface/20 to-transparent opacity-90"></div>
            <div class="absolute bottom-10 start-8 transition-transform duration-500 group-hover:-translate-y-1">
              <p class="eyebrow mb-2 text-orange">{ld.role}</p>
              <h3 class="serif-display text-2xl font-bold text-on-surface md:text-3xl">{ld.name}</h3>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</main>

<SiteFooter locale={locale} />
