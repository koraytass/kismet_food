---
/**
 * AboutPage — v3 corporate (LDC-grade boardroom).
 * Mevcut copy data değişmeden korundu; sunum tamamen Corp dilinde.
 */
import type { Locale } from '@/i18n';
import { t } from '@/i18n';
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
import CorpPageHero from '../v3/CorpPageHero.astro';
import CorpSection from '../v3/CorpSection.astro';

interface Props { locale: Locale; currentPath: string }
const { locale, currentPath } = Astro.props;
const tr = t(locale);

const copy = {
  tr: {
    eyebrow: 'KISMET FELSEFESİ',
    heroTitle1: 'Küresel',
    heroTitleItalic: 'Küratör',
    heroLead: 'Kısmet Foods yalnızca bir aracı değildir; dünyanın en değerli ham maddeleriyle küresel pazar arasında bir köprüdür. Misyonumuz, dünyanın en önemli lezzetlerini cerrahi bir titizlik ve göçebe bir ruhla kürate etmektir.',
    visionEyebrow: 'PUSULAMIZ', visionTitle: 'Vizyon ve Değerler',
    visionLead: 'Geleneksel ticaret bilgeliği ile modern lojistik teknolojisinin kesişiminde çalışıyoruz. Ellediğimiz her çekirdek, her tohum ve her baharat kendi menşeinin ağırlığını ve vardığı yerin vaadini taşır.',
    valueA: { t: 'Menşe Bütünlüğü', d: 'Küçük ölçekli çiftçilerle doğrudan ilişkiler; tam izlenebilirlik ve etik fiyatlama yapısını garantiler.' },
    valueB: { t: 'Küresel Lojistik', d: 'Dört kıtayı gerçek zamanlı takip ve kalite güvencesi ile birbirine bağlayan kusursuz bir ağ.' },
    valueC: { t: 'Kurumsal Disiplin', d: 'Her parti için akredite üçüncü-taraf laboratuvar denetimi ve uçtan-uca evrak dosyası.' },
    heritageEyebrow: 'MİRASIMIZ', heritageTitle: 'İpek Yolu’nda kökler', heritageItalic: 'modern uzmanlık.',
    heritageLead: 'Türkiye her zaman Doğu ile Batı arasındaki ticaretin kalbi olmuştur. Kısmet Foods’ta bu kadim birikimi 21. yüzyıla taşıyoruz. Kurucularımız, ticaretin yalnızca mal değil; kültür, güven ve verilen söz olduğunu anlayan Akdenizli tüccar bir soydan gelir.',
    heritageQuote: '“Kısmet; mükemmelliğin, hazırlanmış bir niyetle fırsatla buluşmasına olan inançtır.”',
    journeyEyebrow: 'EVRİM', journeyTitle: 'Yolculuğumuz', journeyItalic: '',
    journey: [
      { y: '2019', t: 'Kuruluş', d: 'İstanbul’da Kısmet Foods kuruldu; ilk yıl Avrupa pazarı için premium Türk fındığı ve kuru kayısıya odaklandı.' },
      { y: '2021', t: 'Afrika Atağı', d: 'Etiyopya ve Gana’da doğrudan tedarik kanalları güvence altına alındı; portföye ham kakao ve spesiyalite kahve eklendi.' },
      { y: '2023', t: 'Çok Dilli Büyüme', d: 'Türkçe, İngilizce ve Arapça tam operasyonel kapasite; MENA ve EU arasında bire bir müşteri ilişkisi.' },
      { y: 'Bugün', t: 'Küresel Küratör', d: 'Türkiye merkezli, Avrupa, Orta Doğu ve Asya pazarlarına odaklanan çok dilli bir B2B ham madde kürasyon masası olarak çalışıyoruz.' },
    ],
    leadershipEyebrow: 'LİDERLİK', leadershipTitle: 'Uzmanlık Masamız',
    leadershipLead: 'Ekibimiz on yılların lojistik uzmanlığını ürünlerimizin sanatsal doğasına duyulan derin saygıyla birleştirir.',
    leaders: [
      { role: 'Tedarik', name: 'Menşe Kürasyonu', desc: 'Çiftçi kooperatifi ilişkileri, saha denetimi ve numune doğrulaması.' },
      { role: 'Operasyon', name: 'Lojistik Kontrol', desc: 'FOB/CIF/DDP akış koordinasyonu, gümrük ve sevkiyat takibi.' },
      { role: 'Ticaret', name: 'B2B İlişki Yönetimi', desc: 'Avrupa, Orta Doğu ve Asya bölge hesap yöneticileri.' },
    ],
  },
  en: {
    eyebrow: 'KISMET PHILOSOPHY',
    heroTitle1: 'The Global', heroTitleItalic: 'Curator',
    heroLead: 'Kismet Foods is not a mere middleman; we are the bridge between the earth\'s finest raw materials and the global market. Our mission is to curate the world\'s most essential flavors with surgical precision and nomadic soul.',
    visionEyebrow: 'OUR COMPASS', visionTitle: 'Vision & Values',
    visionLead: 'We operate at the intersection of traditional trade wisdom and modern logistics technology. Every bean, seed and spice we handle carries the weight of its origin and the promise of its destination.',
    valueA: { t: 'Integrity of Origin', d: 'Direct relationships with smallholder farmers ensure full traceability and ethical pricing structures.' },
    valueB: { t: 'Global Logistics', d: 'A seamless network connecting four continents with real-time tracking and quality assurance.' },
    valueC: { t: 'Corporate Discipline', d: 'Accredited third-party lab audit per batch and end-to-end documentation file.' },
    heritageEyebrow: 'OUR HERITAGE', heritageTitle: 'Roots in the Silk Road,', heritageItalic: 'modern expertise.',
    heritageLead: 'Türkiye has always been the heart of trade between East and West. At Kismet Foods, we carry this ancestral expertise into the 21st century. Our founders come from a lineage of Mediterranean traders who understood that trade is not just about commodities — it is about culture, trust and the spoken word.',
    heritageQuote: '“Kismet is the belief that excellence meets opportunity through prepared intention.”',
    journeyEyebrow: 'THE EVOLUTION', journeyTitle: 'Our Journey', journeyItalic: '',
    journey: [
      { y: '2019', t: 'Foundation', d: 'Kismet Foods established in Istanbul; year one focused on premium Turkish hazelnuts and dried apricots for the European market.' },
      { y: '2021', t: 'African Pivot', d: 'Direct sourcing channels secured in Ethiopia and Ghana; raw cocoa and specialty coffee added to the portfolio.' },
      { y: '2023', t: 'Multilingual Growth', d: 'Full operational capacity in Turkish, English, and Arabic; direct relationship management between MENA and EU.' },
      { y: 'Today', t: 'Global Curator Desk', d: 'Operating as a Türkiye-based, multilingual B2B raw-material curation desk for European, Middle Eastern and Asian markets.' },
    ],
    leadershipEyebrow: 'LEADERSHIP', leadershipTitle: 'Specialist Desk',
    leadershipLead: 'Our team combines decades of logistics expertise with a profound respect for the artisanal nature of our products.',
    leaders: [
      { role: 'Sourcing', name: 'Origin Curation', desc: 'Cooperative relations, field audits and sample verification.' },
      { role: 'Operations', name: 'Logistics Control', desc: 'FOB/CIF/DDP flow coordination, customs and shipment tracking.' },
      { role: 'Trade', name: 'B2B Relationship Management', desc: 'Regional account managers across EU, Middle East and Asia.' },
    ],
  },
  ar: {
    eyebrow: 'فلسفة كسمت',
    heroTitle1: 'القيّم', heroTitleItalic: 'العالمي',
    heroLead: 'كسمت فودز ليست مجرد وسيط؛ نحن الجسر بين أجود المواد الخام في الأرض والسوق العالمية. مهمتنا أن نختار أهم نكهات العالم بدقة جراحية وروح بدوية.',
    visionEyebrow: 'بوصلتنا', visionTitle: 'الرؤية والقيم',
    visionLead: 'نعمل عند تقاطع حكمة التجارة التقليدية وتكنولوجيا اللوجستيات الحديثة. كل حبة وبذرة وتابل نتعامل معه يحمل ثقل منشئه ووعد وجهته.',
    valueA: { t: 'نزاهة المنشأ', d: 'علاقات مباشرة مع صغار المزارعين تضمن التتبع الكامل وهيكل تسعير أخلاقي.' },
    valueB: { t: 'لوجستيات عالمية', d: 'شبكة متكاملة تربط أربع قارات مع تتبع فوري وضمان جودة.' },
    valueC: { t: 'انضباط مؤسسي', d: 'تدقيق مختبر طرف ثالث معتمد لكل دفعة وملف وثائق متكامل.' },
    heritageEyebrow: 'إرثنا', heritageTitle: 'جذور في طريق الحرير،', heritageItalic: 'خبرة حديثة.',
    heritageLead: 'لطالما كانت تركيا قلب التجارة بين الشرق والغرب. في كسمت فودز، ننقل هذه الخبرة العريقة إلى القرن الحادي والعشرين. مؤسسونا من سلالة تجار متوسطيين أدركوا أن التجارة ليست مجرد سلع — بل ثقافة وثقة وكلمة منطوقة.',
    heritageQuote: '«كسمت هو الإيمان بأن التميز يلتقي الفرصة عبر نية مُعَدّة مسبقاً.»',
    journeyEyebrow: 'التطور', journeyTitle: 'رحلتنا', journeyItalic: '',
    journey: [
      { y: '2019', t: 'التأسيس', d: 'تأسست كسمت فودز في إسطنبول؛ وركزت في عامها الأول على البندق التركي الفاخر والمشمش المجفف للسوق الأوروبية.' },
      { y: '2021', t: 'الانعطاف الأفريقي', d: 'تأمين قنوات توريد مباشرة في إثيوبيا وغانا؛ توسيع المحفظة لتشمل الكاكاو الخام والقهوة المتخصصة.' },
      { y: '2023', t: 'نمو متعدد اللغات', d: 'قدرة تشغيلية كاملة بالتركية والإنجليزية والعربية؛ إدارة علاقة مباشرة بين الشرق الأوسط والاتحاد الأوروبي.' },
      { y: 'اليوم', t: 'مكتب القيّم العالمي', d: 'نعمل من تركيا كمكتب B2B متعدد اللغات لاختيار المواد الخام لأسواق أوروبا والشرق الأوسط وآسيا.' },
    ],
    leadershipEyebrow: 'القيادة', leadershipTitle: 'مكتب متخصص',
    leadershipLead: 'يجمع فريقنا بين عقود من الخبرة اللوجستية والاحترام العميق للطبيعة الحرفية لمنتجاتنا.',
    leaders: [
      { role: 'التوريد', name: 'اختيار المناشئ', desc: 'علاقات تعاونيات وتدقيق ميداني وتحقق العينات.' },
      { role: 'العمليات', name: 'ضبط اللوجستيات', desc: 'تنسيق FOB/CIF/DDP والجمارك ومتابعة الشحنات.' },
      { role: 'التجارة', name: 'إدارة علاقات B2B', desc: 'مديرو حسابات إقليميون لأوروبا والشرق الأوسط وآسيا.' },
    ],
  },
}[locale];

const heroBg = 'https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=2400&q=80';
void tr;
---

<SiteHeader locale={locale} currentPath={currentPath} />

<main id="main">
  <CorpPageHero
    locale={locale}
    eyebrow={copy.eyebrow}
    title={copy.heroTitle1}
    italic={copy.heroTitleItalic}
    lede={copy.heroLead}
    background={heroBg}
    meta={[
      { label: 'HQ', value: 'İstanbul · Caddebostan' },
      { label: 'Founded', value: '2019' },
      { label: 'Continents', value: '5' },
      { label: 'Origins', value: '17 active' },
    ]}
  />

  <CorpSection variant="white" eyebrow={copy.visionEyebrow} title={copy.visionTitle} lede={copy.visionLead}>
    <div class="ab-values">
      {[copy.valueA, copy.valueB, copy.valueC].map((v, i) => (
        <article class="ab-value">
          <span class="co-num ab-value__num">0{i + 1}</span>
          <h3 class="co-h3">{v.t}</h3>
          <p>{v.d}</p>
        </article>
      ))}
    </div>
  </CorpSection>

  <CorpSection variant="navy" eyebrow={copy.heritageEyebrow} title={copy.heritageTitle} italic={copy.heritageItalic} lede={copy.heritageLead}>
    <blockquote class="ab-heritage-quote">{copy.heritageQuote}</blockquote>
  </CorpSection>

  <CorpSection variant="snow" eyebrow={copy.journeyEyebrow} title={copy.journeyTitle}>
    <ol class="ab-journey">
      {copy.journey.map((j) => (
        <li>
          <span class="co-num ab-journey__year">{j.y}</span>
          <div>
            <h3 class="co-h3">{j.t}</h3>
            <p>{j.d}</p>
          </div>
        </li>
      ))}
    </ol>
  </CorpSection>

  <CorpSection variant="white" eyebrow={copy.leadershipEyebrow} title={copy.leadershipTitle} lede={copy.leadershipLead}>
    <div class="ab-leaders">
      {copy.leaders.map((l, i) => (
        <article class="ab-leader">
          <span class="co-eyebrow co-eyebrow--ink">{l.role}</span>
          <h3 class="co-h3">{l.name}</h3>
          <p>{l.desc}</p>
          <span class="co-num ab-leader__index">0{i + 1}</span>
        </article>
      ))}
    </div>
  </CorpSection>
</main>

<SiteFooter locale={locale} />

<style>
  .ab-values { display: grid; grid-template-columns: 1fr; gap: 36px; }
  @media (min-width: 880px) { .ab-values { grid-template-columns: repeat(3, 1fr); gap: 40px; } }
  .ab-value { display: flex; flex-direction: column; gap: 12px; padding-top: 24px; border-top: 2px solid var(--co-amber); }
  .ab-value__num { font-size: 32px; color: var(--co-amber); line-height: 1; }
  .ab-value p { font-family: var(--co-sans); font-size: 15px; color: var(--co-mute); margin: 0; line-height: 1.65; }

  .ab-heritage-quote {
    margin: 0;
    font-family: var(--co-serif);
    font-style: italic;
    font-size: clamp(22px, 2.4vw, 32px);
    line-height: 1.45;
    color: var(--co-white);
    max-width: 50ch;
    border-left: 4px solid var(--co-amber);
    padding-left: 24px;
  }

  .ab-journey { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: 0; border-top: 1px solid var(--co-line); }
  .ab-journey li { display: grid; grid-template-columns: 120px 1fr; gap: 24px; padding: 28px 0; border-bottom: 1px solid var(--co-line); align-items: start; }
  .ab-journey__year { font-size: 32px; color: var(--co-navy); line-height: 1; }
  .ab-journey h3 { color: var(--co-ink); margin: 0 0 8px; }
  .ab-journey p { font-family: var(--co-sans); font-size: 15px; color: var(--co-mute); margin: 0; line-height: 1.65; }

  .ab-leaders { display: grid; grid-template-columns: 1fr; gap: 24px; }
  @media (min-width: 880px) { .ab-leaders { grid-template-columns: repeat(3, 1fr); } }
  .ab-leader {
    background: var(--co-snow);
    border: 1px solid var(--co-line);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    position: relative;
    transition: border-color 220ms ease, transform 220ms ease, box-shadow 220ms ease;
  }
  .ab-leader:hover { border-color: var(--co-navy); box-shadow: 0 24px 48px -28px rgba(12,37,69,0.22); transform: translateY(-2px); }
  .ab-leader h3 { color: var(--co-ink); margin: 0; }
  .ab-leader p { font-family: var(--co-sans); font-size: 14px; color: var(--co-mute); margin: 0; line-height: 1.6; }
  .ab-leader__index { position: absolute; top: 16px; right: 20px; font-size: 14px; color: var(--co-amber); }
</style>
