---
/**
 * AboutPage — faithful to Stitch design (5 editorial sections).
 *
 *   1. Hero         — large italic serif title, "Kismet Philosophy" eyebrow,
 *                     surface card with quote, cocoa image filling right 3/5.
 *   2. Vision/Values— "Our Compass" eyebrow + title + 2 icon cards.
 *   3. Heritage     — Silk Road antique map overlapped by copper coffee pot;
 *                     "Roots in the Silk Road" multiline heading + italic quote.
 *   4. Journey      — Alternating timeline (2019 / 2021 / 2023 / Today) with
 *                     central dot rail; mobile falls back to left-aligned list.
 *   5. Leadership   — Dark band, 3 portrait cards with grayscale → color hover.
 */
import type { Locale } from '@/i18n';
import { t } from '@/i18n';
import { stitchSrc } from '@/lib/stitch';
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
import Breadcrumb from '../Breadcrumb.astro';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const tr = t(locale);

