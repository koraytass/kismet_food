---
import type { Locale } from '@/i18n';
import { localePath } from '@/i18n';
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
import CorpPageHero from '../v3/CorpPageHero.astro';
import CorpSection from '../v3/CorpSection.astro';

interface Props { locale: Locale; currentPath: string }
const { locale, currentPath } = Astro.props;

const copy = {
  tr: {
    eyebrow: 'GÖRÜŞ & PİYASA',
    heroTitle: 'Editör masamızdan.',
    heroLead: 'Aylık piyasa raporları, çiftçi portreleri ve regülasyon yorumları. Yatırımcı ve alıcı tarafına aynı veri seti.',
    featuredEyebrow: 'ÖNE ÇIKAN', featuredTitle: 'Mayıs 2026', featuredItalic: 'piyasa raporu.',
    featuredCat: 'Piyasa Raporu',
    featuredHead: 'Arabica fiyatlarında 18 aylık zirve: 2026 hasat sezonu öngörüleri.',
    featuredBody: 'Brezilya kuraklığı, Etiyopya hasadı ve dolar paritesi — Q3 için bekleyen 3 senaryoyu inceledik. Haziran-Eylül penceresinde alıcı stratejisi ve EUDR uyumlu Etiyopya hattının kritik noktaları.',
    featuredRead: '12 dk · 04 May 2026',
    listEyebrow: 'TÜM YAYINLAR',
    listTitle: 'Sektör görüşü,', listItalic: 'pazarlama değil.',
    listLead: 'ICCO, ICO, FAO, USDA-FAS ve menşe ülke raporlarının sentezi. Senaryolar; tavsiyeler değil bağlam.',
    items: [
      { date: '21 Nis 2026', cat: 'Saha', read: '8 dk', t: 'Antep’te üç nesil: bir fıstık ailesinin portresi.', d: 'Gaziantep platosunda 1962’den bu yana fıstık yetiştiren bir ailenin yıllık tedarik döngüsü.' },
      { date: '15 Nis 2026', cat: 'Regülasyon', read: '14 dk', t: 'EU EUDR Aralık 2024 sonrası: ilk altı ayın bilançosu.', d: 'Geo-trace + farmer-ID uygulamasında Türkiye, Etiyopya ve Gana hatlarının uyum oranları.' },
      { date: '03 Nis 2026', cat: 'Pazar', read: '6 dk', t: 'Vietnam robusta hasadı: küresel kahve fiyatlarına etkisi.', d: 'USDA-FAS Mart raporu üzerinden Q2 robusta öngörüleri ve LIFFE diferansiyel hareketi.' },
      { date: '28 Mar 2026', cat: 'Saha', read: '7 dk', t: 'Yirgacheffe washing station ziyareti.', d: 'YCFCU kooperatifinin 2026 hasat sezonu hazırlıkları, parche kurutma yatakları ve cup score profilleri.' },
      { date: '14 Mar 2026', cat: 'Pazar', read: '10 dk', t: 'Kakao fiyat şoku: ICCO Mart raporunun okunması.', d: 'Batı Afrika hasadı ve dolar/USD-EUR paritesi nedenleri; çikolata sanayisinin 2026 stok stratejisi.' },
      { date: '02 Mar 2026', cat: 'Lojistik', read: '5 dk', t: 'Süveyş Kanalı yeniden açıldı: gıda navlununa etkisi.', d: 'Kakao, kahve ve baharat hatlarında Tema-Hamburg ve Cat Lai-Hamburg navlun değişimi.' },
    ],
    archiveBtn: 'Arşivin tamamı',
    subEyebrow: 'BÜLTEN', subTitle: 'Aylık piyasa raporu', subItalic: 'doğrudan kutunuza.',
    subBody: 'Her ayın ilk pazartesi günü piyasa görüşü, EUDR güncellemesi ve Kismet menşe notları.',
    subPlaceholder: 'kurumsal@sirket.com', subBtn: 'Abone Ol',
  },
  en: {
    eyebrow: 'INSIGHTS & MARKETS',
    heroTitle: 'From the editor’s desk.',
    heroLead: 'Monthly market reports, farmer portraits and regulation commentary. Same data set for investors and buyers.',
    featuredEyebrow: 'FEATURED', featuredTitle: 'May 2026', featuredItalic: 'market report.',
    featuredCat: 'Market Report',
    featuredHead: '18-month high in arabica prices: 2026 harvest outlook.',
    featuredBody: 'Brazilian drought, Ethiopian harvest and the dollar parity — three scenarios pending for Q3. Buyer strategy in the Jun-Sep window and the critical points of EUDR-compliant Ethiopian line.',
    featuredRead: '12 min · 04 May 2026',
    listEyebrow: 'ALL PUBLICATIONS',
    listTitle: 'Sector view,', listItalic: 'not marketing.',
    listLead: 'Synthesis of ICCO, ICO, FAO, USDA-FAS and country reports. Scenarios — context, not advice.',
    items: [
      { date: '21 Apr 2026', cat: 'Field', read: '8 min', t: 'Three generations in Antep: portrait of a pistachio family.', d: 'A family on the Gaziantep plateau growing pistachios since 1962 — their annual sourcing cycle.' },
      { date: '15 Apr 2026', cat: 'Regulation', read: '14 min', t: 'After EU EUDR Dec 2024: a six-month balance sheet.', d: 'Türkiye, Ethiopia and Ghana compliance rates with geo-trace + farmer-ID.' },
      { date: '03 Apr 2026', cat: 'Market', read: '6 min', t: 'Vietnam robusta harvest: impact on global coffee prices.', d: 'Q2 robusta outlook and LIFFE differential moves through the USDA-FAS March report.' },
      { date: '28 Mar 2026', cat: 'Field', read: '7 min', t: 'A visit to a Yirgacheffe washing station.', d: 'YCFCU cooperative’s 2026 harvest prep, parche drying beds and cup score profiles.' },
      { date: '14 Mar 2026', cat: 'Market', read: '10 min', t: 'Cocoa price shock: reading the ICCO March report.', d: 'West African harvest and USD/EUR parity drivers; chocolate industry 2026 stock strategy.' },
      { date: '02 Mar 2026', cat: 'Logistics', read: '5 min', t: 'Suez Canal reopened: impact on food freight.', d: 'Tema-Hamburg and Cat Lai-Hamburg freight changes for cocoa, coffee and spice lines.' },
    ],
    archiveBtn: 'Full archive',
    subEyebrow: 'NEWSLETTER', subTitle: 'Monthly market report', subItalic: 'to your inbox.',
    subBody: 'First Monday of every month: market view, EUDR update and Kismet origin notes.',
    subPlaceholder: 'name@company.com', subBtn: 'Subscribe',
  },
  ar: {
    eyebrow: 'تحليلات وأسواق',
    heroTitle: 'من مكتب التحرير.',
    heroLead: 'تقارير سوق شهرية وصور للمزارعين وتعليقات تنظيمية.',
    featuredEyebrow: 'مميز', featuredTitle: 'تقرير سوق', featuredItalic: 'مايو ٢٠٢٦.',
    featuredCat: 'تقرير سوق',
    featuredHead: 'أعلى أسعار للعربيكا منذ ١٨ شهراً: توقعات حصاد ٢٠٢٦.',
    featuredBody: 'الجفاف البرازيلي وحصاد إثيوبيا وسعر الدولار — ثلاثة سيناريوهات للربع الثالث.',
    featuredRead: '١٢ دقيقة · ٠٤ مايو ٢٠٢٦',
    listEyebrow: 'كل المنشورات',
    listTitle: 'رؤية قطاع،', listItalic: 'لا تسويق.',
    listLead: 'تركيب لتقارير ICCO وICO وFAO وUSDA-FAS.',
    items: [
      { date: '٢١ أبريل', cat: 'ميدان', read: '٨ د', t: 'ثلاثة أجيال في عنتاب.', d: 'عائلة فستق منذ ١٩٦٢.' },
      { date: '١٥ أبريل', cat: 'تنظيم', read: '١٤ د', t: 'بعد EU EUDR.', d: 'معدلات الامتثال في تركيا وإثيوبيا وغانا.' },
      { date: '٠٣ أبريل', cat: 'سوق', read: '٦ د', t: 'حصاد روبوستا فيتنام.', d: 'توقعات Q2 وحركة فارق LIFFE.' },
      { date: '٢٨ مارس', cat: 'ميدان', read: '٧ د', t: 'زيارة محطة غسيل يرغاشيف.', d: 'تحضيرات حصاد ٢٠٢٦.' },
      { date: '١٤ مارس', cat: 'سوق', read: '١٠ د', t: 'صدمة سعر الكاكاو.', d: 'قراءة تقرير ICCO.' },
      { date: '٠٢ مارس', cat: 'لوجستيات', read: '٥ د', t: 'إعادة فتح السويس.', d: 'تأثير على شحن الغذاء.' },
    ],
    archiveBtn: 'الأرشيف الكامل',
    subEyebrow: 'النشرة', subTitle: 'تقرير شهري', subItalic: 'مباشرة.',
    subBody: 'أول اثنين من كل شهر.',
    subPlaceholder: 'name@company.com', subBtn: 'اشترك',
  },
}[locale];

const heroBg = 'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=2400&q=80';
---

<SiteHeader locale={locale} currentPath={currentPath} />

<main id="main">
  <CorpPageHero
    locale={locale}
    eyebrow={copy.eyebrow}
    title={copy.heroTitle}
    lede={copy.heroLead}
    background={heroBg}
    meta={[
      { label: 'Cadence', value: 'monthly' },
      { label: 'Sources', value: 'ICO · ICCO · FAO · USDA' },
      { label: 'Format', value: 'PDF + web' },
    ]}
  />

  <CorpSection variant="white" eyebrow={copy.featuredEyebrow} title={copy.featuredTitle} italic={copy.featuredItalic}>
    <article class="ip-feat">
      <figure>
        <img src="https://images.unsplash.com/photo-1574323347407-f5e1ad6d020b?auto=format&fit=crop&w=1600&q=80" alt={copy.featuredHead} loading="lazy" decoding="async" />
      </figure>
      <div>
        <span class="co-eyebrow co-eyebrow--ink">{copy.featuredCat} · {copy.featuredRead}</span>
        <h3 class="co-h2">{copy.featuredHead}</h3>
        <p>{copy.featuredBody}</p>
        <a href={localePath('/insights/market-reports/', locale)} class="co-link"><span>{locale === 'tr' ? 'Raporu Oku' : locale === 'ar' ? 'اقرأ التقرير' : 'Read Report'}</span><span class="co-link__arrow" aria-hidden="true">→</span></a>
      </div>
    </article>
  </CorpSection>

  <CorpSection variant="snow" eyebrow={copy.listEyebrow} title={copy.listTitle} italic={copy.listItalic} lede={copy.listLead}>
    <div class="ip-grid">
      {copy.items.map((it) => (
        <a class="ip-card" href={localePath('/insights/', locale)}>
          <div class="ip-card__head">
            <span class="co-eyebrow co-eyebrow--ink">{it.cat}</span>
            <span class="ip-card__meta">{it.date} · {it.read}</span>
          </div>
          <h3 class="co-h3">{it.t}</h3>
          <p>{it.d}</p>
        </a>
      ))}
    </div>
    <div class="ip-foot">
      <a href={localePath('/insights/market-reports/', locale)} class="co-btn co-btn--ghost">{copy.archiveBtn} <span aria-hidden="true">→</span></a>
    </div>
  </CorpSection>

  <CorpSection variant="navy" eyebrow={copy.subEyebrow} title={copy.subTitle} italic={copy.subItalic} lede={copy.subBody}>
    <form class="ip-sub" method="post" action="#">
      <input type="email" placeholder={copy.subPlaceholder} required />
      <button type="submit" class="co-btn co-btn--amber">{copy.subBtn} <span aria-hidden="true">→</span></button>
    </form>
  </CorpSection>
</main>

<SiteFooter locale={locale} />

<style>
  .ip-feat { display: grid; grid-template-columns: 1fr; gap: 32px; align-items: center; }
  @media (min-width: 1024px) { .ip-feat { grid-template-columns: 1fr 1fr; gap: 56px; } }
  .ip-feat figure { margin: 0; aspect-ratio: 4 / 3; overflow: hidden; }
  .ip-feat figure img { width: 100%; height: 100%; object-fit: cover; }
  .ip-feat > div { display: flex; flex-direction: column; gap: 16px; }
  .ip-feat h3 { color: var(--co-ink); margin: 0; }
  .ip-feat p { font-family: var(--co-sans); font-size: 17px; color: var(--co-mute); margin: 0; line-height: 1.65; }
  .ip-feat .co-link { align-self: flex-start; margin-top: 8px; }

  .ip-grid { display: grid; grid-template-columns: 1fr; gap: 16px; }
  @media (min-width: 720px) { .ip-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; } }
  @media (min-width: 1080px) { .ip-grid { grid-template-columns: repeat(3, 1fr); } }
  .ip-card { background: var(--co-white); border: 1px solid var(--co-line); padding: 24px; text-decoration: none; color: var(--co-text); display: flex; flex-direction: column; gap: 14px; transition: border-color 220ms ease, box-shadow 220ms ease, transform 220ms ease; }
  .ip-card:hover { border-color: var(--co-navy); box-shadow: 0 24px 48px -28px rgba(12,37,69,0.18); transform: translateY(-2px); }
  .ip-card__head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .ip-card__meta { font-family: var(--co-sans); font-size: 12px; color: var(--co-mute); font-weight: 500; }
  .ip-card h3 { color: var(--co-ink); margin: 0; font-size: 18px; line-height: 1.3; }
  .ip-card p { font-family: var(--co-sans); font-size: 14px; color: var(--co-mute); margin: 0; line-height: 1.6; }

  .ip-foot { margin-top: 56px; display: flex; justify-content: center; }

  .ip-sub { display: flex; flex-direction: column; gap: 12px; max-width: 540px; }
  @media (min-width: 600px) { .ip-sub { flex-direction: row; } }
  .ip-sub input { flex: 1; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.16); padding: 14px 18px; color: var(--co-white); font-family: var(--co-sans); font-size: 15px; }
  .ip-sub input::placeholder { color: rgba(255,255,255,0.5); }
  .ip-sub input:focus { outline: none; border-color: var(--co-amber); }
</style>
