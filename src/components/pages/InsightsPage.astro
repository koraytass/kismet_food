const featuredImg = copy.reports[1].img;

const newsletterMail =
  'mailto:insights@kismetfoods.com?subject=Market%20Reports%20Subscription';
---

<SiteHeader locale={locale} currentPath={currentPath} />

<Breadcrumb locale={locale} items={[{ name: tr.nav.insights }]} />

<main id="main" class="bg-surface">
  {/* ========== 1. HERO ========== */}
  <section class="px-4 pb-16 pt-10 md:px-8 md:pb-24 md:pt-16">
    <div class="mx-auto grid max-w-7xl grid-cols-1 items-end gap-12 md:grid-cols-[3fr_2fr]">
      <div>
        <span class="eyebrow mb-6 block text-orange-dark">{copy.eyebrow}</span>
        <h1 class="serif-display mb-8 text-5xl font-bold leading-[0.95] tracking-tight text-on-surface md:text-6xl lg:text-7xl">
          {copy.heroTitle1}
          <br />
          <span class="italic text-teal-dark">{copy.heroTitleItalic}</span>
        </h1>
        <p class="max-w-2xl text-lg leading-relaxed text-on-surface-muted md:text-xl">
          {copy.heroLead}
        </p>
      </div>

      <div class="relative">
        <div class="shadow-editorial aspect-[4/5] w-full -rotate-2 overflow-hidden rounded-lg bg-surface-low">
          <img
            src={heroImg}
            alt=""
            width="800"
            height="1000"
            class="h-full w-full object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <div class="shadow-editorial absolute -bottom-8 -start-8 hidden max-w-[240px] bg-surface-lowest p-6 md:block">
          <span class="eyebrow mb-2 block text-orange-dark">{copy.latestLabel}</span>
          <p class="serif-display text-lg italic leading-snug text-on-surface">
            {copy.latestQuote}
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ========== 2. NEWS TICKER ========== */}
  <section
    aria-label={copy.reportsEyebrow}
    class="overflow-hidden whitespace-nowrap bg-on-surface py-4 text-surface"
  >
    <div class="flex items-center gap-12 px-4 md:px-8">
      {copy.ticker.map((item, idx) => (
        <div class="flex shrink-0 items-center gap-4">
          <span class={idx % 2 === 0 ? 'font-bold text-teal' : 'font-bold text-orange'}>•</span>
          <span class="eyebrow text-xs">{item}</span>
        </div>
      ))}
      {copy.ticker.map((item, idx) => (
        <div class="flex shrink-0 items-center gap-4" aria-hidden="true">
          <span class={idx % 2 === 0 ? 'font-bold text-teal' : 'font-bold text-orange'}>•</span>
          <span class="eyebrow text-xs">{item}</span>
        </div>
      ))}
    </div>
  </section>

  {/* ========== 3. FEATURED ARTICLE ========== */}
  <section class="px-4 py-24 md:px-8 md:py-28">
    <div class="mx-auto max-w-7xl">
      <article class="grid grid-cols-1 overflow-hidden rounded-lg bg-surface-low md:grid-cols-[6fr_5fr]">
        <div class="aspect-[4/3] overflow-hidden md:aspect-auto">
          <img
            src={stitchSrc(featuredImg)}
            alt=""
            width="1000"
            height="800"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
        </div>
        <div class="flex flex-col justify-center gap-6 p-10 md:p-14">
          <span class="eyebrow text-orange-dark">{copy.featuredKicker}</span>
          <h2 class="serif-display text-3xl font-bold leading-tight text-on-surface md:text-4xl lg:text-5xl">
            {copy.featuredTitle}
          </h2>
          <p class="text-lg leading-relaxed text-on-surface-muted">{copy.featuredExcerpt}</p>
          <p class="eyebrow text-on-surface-subtle">{copy.featuredMeta}</p>
          <div>
            <a
              href="#reports"
              class="cta-gradient shadow-editorial inline-flex items-center rounded-md px-6 py-3 text-xs font-bold uppercase tracking-widest text-white"
            >
              {copy.featuredCta}
            </a>
          </div>
        </div>
      </article>
    </div>
  </section>

  {/* ========== 4. MARKET REPORTS GRID ========== */}
  <section id="reports" class="px-4 py-20 md:px-8 md:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="mb-10 grid grid-cols-1 items-end gap-8 md:grid-cols-[7fr_5fr]">
        <div>
          <span class="eyebrow mb-4 block text-orange-dark">{copy.reportsEyebrow}</span>
          <h2 class="serif-display text-4xl font-bold text-on-surface md:text-5xl">
            {copy.reportsTitle}
          </h2>
        </div>
        <p class="leading-relaxed text-on-surface-muted">{copy.reportsLead}</p>
      </div>

      {/* Filter chips */}
      <div class="mb-12 flex flex-wrap items-center gap-3" role="group" aria-label={copy.filterLabel}>
        <span class="eyebrow me-2 text-on-surface-subtle">{copy.filterLabel}:</span>
        {copy.filters.map((f, idx) => (
          <button
            type="button"
            aria-pressed={idx === 0 ? 'true' : 'false'}
            class={
              'eyebrow rounded-full border px-4 py-2 text-xs transition-colors ' +
              (idx === 0
                ? 'border-teal-dark bg-teal-dark text-white'
                : 'border-outline/30 bg-surface-low text-on-surface-muted hover:border-teal-dark hover:text-teal-dark')
            }
          >
            {f}
          </button>
        ))}
        <a href="#" class="eyebrow ms-auto border-b-2 border-orange/30 pb-1 text-orange-dark hover:border-orange">
          {copy.archiveCta}
        </a>
      </div>

      {/* Top 3 report cards — with images */}
      <div class="mb-16 grid grid-cols-1 gap-10 md:grid-cols-3">
        {copy.reports.map((item) => (
          <article class="group">
            <div class="relative mb-6 aspect-[3/4] overflow-hidden rounded-md bg-surface-low">
              <img
                src={stitchSrc(item.img)}
                alt={item.imgAlt}
                width="600"
                height="800"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
              <div class="shadow-editorial absolute start-5 top-5 bg-surface-lowest p-3">
                <span class="serif-display block text-xl font-bold text-orange-dark">
                  {item.originLabel}
                </span>
              </div>
            </div>
            <span class="eyebrow mb-2 block text-on-surface-subtle">{item.category}</span>
            <h3 class="serif-display mb-3 text-xl font-bold leading-snug text-on-surface md:text-2xl">
              {item.title}
            </h3>
            <time datetime={item.date} class="eyebrow mb-3 block text-on-surface-subtle">
              {item.dateLabel}
            </time>
            <p class="mb-6 leading-relaxed text-on-surface-muted">{item.excerpt}</p>
            <a
              href="#"
              class="eyebrow inline-flex items-center gap-2 text-teal-dark hover:text-orange-dark"
              aria-label={`${copy.downloadCta} — ${item.title}`}
            >
              <span aria-hidden="true">↓</span>
              <span>{copy.downloadCta} · {item.size}</span>
            </a>
          </article>
        ))}
      </div>

      {/* Extra teaser row — 3 text-only teasers to reach 6+ articles */}
      <div class="grid grid-cols-1 gap-6 border-t border-outline/20 pt-10 md:grid-cols-3">
        {copy.extraReports.map((r, idx) => (
          <article class="group border-s-2 border-orange/40 ps-6 transition-all hover:border-orange">
            <span class="eyebrow mb-2 block text-orange-dark">
              {String(idx + 4).padStart(2, '0')} · {r.cat}
            </span>
            <h3 class="serif-display mb-2 text-lg font-bold leading-snug text-on-surface md:text-xl">
              {r.title}
            </h3>
            <p class="eyebrow text-on-surface-subtle">{r.meta}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ========== 5. ORIGIN STORIES ========== */}
  <section class="bg-surface-low px-4 py-24 md:px-8 md:py-28">
    <div class="mx-auto max-w-7xl">
      <div class="grid grid-cols-1 items-start gap-12 md:grid-cols-[4fr_8fr] md:gap-16">
        <aside class="md:sticky md:top-32">
          <span class="eyebrow mb-4 block text-orange-dark">{copy.storiesEyebrow}</span>
          <h2 class="serif-display mb-6 text-4xl font-bold leading-tight text-on-surface md:text-5xl">
            {copy.storiesTitle}
          </h2>
          <p class="mb-8 text-lg leading-relaxed text-on-surface-muted">{copy.storiesLead}</p>
          <ul class="space-y-3">
            {copy.storyTabs.map((tab, idx) => (
              <li class="flex items-center gap-4">
                <span
                  aria-hidden="true"
                  class={'h-1 transition-all ' + (idx === 0 ? 'w-16 bg-teal-dark' : 'w-12 bg-outline/30')}
                ></span>
                <span
                  class={
                    'eyebrow ' + (idx === 0 ? 'text-on-surface' : 'text-on-surface-subtle')
                  }
                >
                  {tab}
                </span>
              </li>
            ))}
          </ul>
        </aside>

        <div class="grid grid-cols-1 gap-x-10 gap-y-16 md:grid-cols-2 md:gap-y-20">
          {copy.stories.map((story, idx) => (
            <article class={'flex flex-col ' + (idx % 2 === 1 ? 'md:mt-16' : '')}>
              <div class="mb-6 aspect-video overflow-hidden rounded-md bg-surface-mid">
                <img
                  src={stitchSrc(story.img)}
                  alt={story.imgAlt}
                  width="960"
                  height="540"
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover"
                />
              </div>
              <span class="eyebrow mb-2 block text-orange-dark">{story.category}</span>
              <h3 class="serif-display mb-3 text-2xl font-bold leading-snug text-on-surface">
                {story.title}
              </h3>
              <p class="mb-4 leading-relaxed text-on-surface-muted">{story.excerpt}</p>
              <a
                href="#"
                class="eyebrow mt-auto inline-flex items-center gap-2 text-teal-dark hover:text-orange-dark"
              >
                <span>{copy.readMore}</span>
                <span aria-hidden="true">→</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* ========== 6. GLOBAL REACH MAP ========== */}
  <section class="px-4 py-24 md:px-8 md:py-28">
    <div class="mx-auto max-w-7xl">
      <div class="mb-16 text-center">
        <h2 class="serif-display mb-4 text-3xl font-bold text-on-surface md:text-4xl">
          {copy.mapTitle}
        </h2>
        <p class="mx-auto max-w-2xl text-on-surface-muted">{copy.mapLead}</p>
      </div>
      <div class="relative mx-auto aspect-[2/1] max-w-6xl overflow-hidden rounded-lg bg-surface-mid shadow-inner">
        <img
          src={mapImg}
          alt=""
          width="1200"
          height="600"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover opacity-25 grayscale"
        />
        {/* Pulse markers */}
        <span aria-hidden="true" class="absolute left-[20%] top-1/2 h-4 w-4 animate-ping rounded-full bg-teal/60"></span>
        <span aria-hidden="true" class="absolute left-[20.5%] top-[55%] h-3 w-3 rounded-full bg-teal-dark shadow-[0_0_15px_rgba(0,172,175,0.8)]"></span>
        <span aria-hidden="true" class="absolute left-[45%] top-[45%] h-4 w-4 animate-ping rounded-full bg-teal/60"></span>
        <span aria-hidden="true" class="absolute left-[45.5%] top-[50%] h-3 w-3 rounded-full bg-teal-dark shadow-[0_0_15px_rgba(0,172,175,0.8)]"></span>
        <span aria-hidden="true" class="absolute left-[62%] top-[35%] h-4 w-4 animate-ping rounded-full bg-teal/60"></span>
        <span aria-hidden="true" class="absolute left-[62.5%] top-[38%] h-3 w-3 rounded-full bg-teal-dark shadow-[0_0_15px_rgba(0,172,175,0.8)]"></span>

        {/* Live fleet card */}
        <div class="shadow-editorial absolute bottom-6 end-6 rounded-md bg-surface-lowest p-6 text-start">
          <span class="eyebrow mb-3 block text-orange-dark">{copy.fleetLabel}</span>
          <div class="mb-2 flex items-center gap-3">
            <span aria-hidden="true" class="h-2 w-2 rounded-full bg-teal-dark"></span>
            <span class="eyebrow text-on-surface">{copy.fleetA}</span>
          </div>
          <div class="flex items-center gap-3">
            <span aria-hidden="true" class="h-2 w-2 rounded-full bg-outline"></span>
            <span class="eyebrow text-on-surface-subtle">{copy.fleetB}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ========== 7. NEWSLETTER ========== */}
  <section class="cta-gradient px-4 py-24 text-white md:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <span class="eyebrow mb-4 block text-white/70">{copy.newsletterEyebrow}</span>
      <h2 class="serif-display mb-4 text-3xl font-bold md:text-4xl">{copy.newsletterTitle}</h2>
      <p class="mb-10 text-lg leading-relaxed text-white/85">{copy.newsletterLead}</p>

      <form
        action={newsletterMail}
        method="get"
        class="mx-auto flex max-w-xl flex-col gap-3 sm:flex-row"
        aria-label={copy.newsletterTitle}
      >
        <label class="sr-only" for="newsletter-email">{copy.emailPlaceholder}</label>
        <input
          id="newsletter-email"
          type="email"
          name="subject"
          required
          placeholder={copy.emailPlaceholder}
          class="flex-1 rounded-md bg-white/10 px-5 py-4 text-base text-white placeholder:text-white/60 backdrop-blur focus:bg-white/20 focus:outline-none focus:ring-2 focus:ring-white/40"
        />
        <button
          type="submit"
          class="rounded-md bg-orange px-8 py-4 text-xs font-bold uppercase tracking-widest text-white shadow-lg shadow-orange/20 transition-colors hover:bg-orange-dark"
        >
          {copy.newsletterCta}
        </button>
      </form>
    </div>
  </section>
</main>

<SiteFooter locale={locale} />
