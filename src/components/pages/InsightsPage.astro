/* --- Stitch imagery --- */
const heroImg = stitchSrc(
  'https://lh3.googleusercontent.com/aida-public/AB6AXuBMFBdJSurWIDbnnEvkuDPg65hi6uKVXmSWDRCuak7GI3lJ65N0GrOsk8vCwz2RFdnfMiRlJN73PuNho2dfC_SdFz2Lq8R8-q5kXCJoFGZNRK2yaMho9cY2AHvi740dULOB6iDfzByemu-OFbn7zESyy7U0DjjBMEfQeCgZuAfMssdaj9TpR0AH7qv8thMM67o3P2oAzzBiyXg1VZA6TZWDONDj3hKq-nYIsWYB3swa7B4MYftYlMYKhqPAbxTsoG_nrmqfUl-3oK8',
);
const mapImg = stitchSrc(
  'https://lh3.googleusercontent.com/aida-public/AB6AXuCVjf4EpxEMqboDPczFNJKovP4imIp9MfO9WALZvdfqXGmuWxhEeU7YsVxBYAJyt7jzQqrzevjbCTSKVKOk7hm4aWPRrUpqCJat9Unz8FTm-BXPxITr86NmfI3vm6KuXgzbD_eQTCM86o0JL52U0eC_jOgHK9UOdMUKKD5lLUaV0tipDAIfXJzTB27ayy7NpLHqyondCJnEtVHVL2qBJkvbjkE1mig6JAd71jjqrCAr5hpNtCShQbAcGcWX-iGdKKDr0fLRPi2daFo',
);
