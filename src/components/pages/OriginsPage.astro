      { k: 'colombia', name: 'Colombia', region: 'Huila · Nariño', body: 'Specialty coffee with balanced acidity and caramel notes.' },
      { k: 'vietnam', name: 'Vietnam', region: 'Dak Lak · Lam Dong', body: 'Robusta coffee, cashews and black pepper — continuous supply at scale.' },
      { k: 'ghana', name: 'Ghana', region: 'Ashanti · Western', body: 'Fermented cocoa bean — the premium choice for chocolatiers.' },
      { k: 'ivory', name: "Côte d'Ivoire", region: 'San-Pédro · Abidjan', body: 'Traceable supply from the world’s largest cocoa producer.' },
      { k: 'indonesia', name: 'Indonesia', region: 'Sumatra · Sulawesi', body: 'Sumatran coffee, coconut and spice commodities.' },
      { k: 'brazil', name: 'Brazil', region: 'Minas Gerais · Sul', body: 'Blend-base arabica and specialty microlot coffees.' },
