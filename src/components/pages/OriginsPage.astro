---

<SiteHeader locale={locale} currentPath={currentPath} />

<main id="main">
  <CorpPageHero
    locale={locale}
    eyebrow={copy.eyebrow}
    title={copy.heroTitle}
    lede={copy.heroLead}
    background={heroBg}
    meta={[
      { label: 'Continents', value: '5' },
      { label: 'Countries', value: '11' },
      { label: 'Specialists', value: 'on the ground' },
    ]}
  />

  <CorpSection variant="snow" eyebrow="HARITA · INTERAKTİF" title="17 menşe" italic="tek dünya.">
    <OriginsMap
      markers={mapMarkers[locale]}
      labels={{
        viewDetail: copy.viewBtn,
        mapAria: locale === 'ar' ? 'خريطة المناشئ' : locale === 'tr' ? 'Menşe haritası' : 'Origins map',
        listTitle: locale === 'ar' ? 'سجل المناشئ' : locale === 'tr' ? 'Menşe defteri' : 'Origin ledger',
        productPrefix: locale === 'ar' ? 'المنتجات' : locale === 'tr' ? 'Ürünler' : 'Products',
        filters: locale === 'tr'
          ? { all: 'Tümü', coffee: 'Kahve', cocoa: 'Kakao', nuts: 'Kuruyemiş', spices: 'Baharat', ingredients: 'Hammadde' }
          : locale === 'ar'
          ? { all: 'الكل', coffee: 'قهوة', cocoa: 'كاكاو', nuts: 'مكسرات', spices: 'توابل', ingredients: 'مكونات' }
          : { all: 'All', coffee: 'Coffee', cocoa: 'Cocoa', nuts: 'Nuts', spices: 'Spices', ingredients: 'Ingredients' },
      }}
    />
  </CorpSection>

  <CorpSection variant="white" eyebrow={copy.countriesEyebrow} title={copy.countriesTitle} italic={copy.countriesItalic} lede={copy.countriesLead}>
    <div class="op-grid">
      {copy.countries.map((c) => (
        <a href={(c as any).href ?? localePath(`/origins/${c.k}/`, locale)} class:list={['op-card', (c as any).featured && 'op-card--featured']}>
          <div class="op-card__head">
            <span class="co-eyebrow">{c.region}</span>
            {(c as any).featured && <span class="op-card__badge">Öne çıkan menşe</span>}
          </div>
          <h3 class="co-h3">{c.name}</h3>
          <p>{c.body}</p>
          <span class="co-link"><span>{copy.viewBtn}</span><span class="co-link__arrow" aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </CorpSection>

  <CorpSection variant="navy" eyebrow="VERİ" title={copy.statsTitle} italic={copy.statsItalic}>
    <div class="op-stats">
      {copy.stats.map((s) => (
        <div class="op-stat">
          <span class="co-num op-stat__v">{s.n}</span>
          <span class="op-stat__l">{s.l}</span>
        </div>
      ))}
    </div>
  </CorpSection>

  <CorpSection variant="snow" compact>
    <div class="op-cta">
      <h2 class="co-h2">{copy.ctaTitle}</h2>
      <p>{copy.ctaLead}</p>
      <a href={contactHref} class="co-btn co-btn--primary">{copy.ctaBtn} <span aria-hidden="true">→</span></a>
    </div>
  </CorpSection>
</main>

<SiteFooter locale={locale} />

<style>
  .op-grid { display: grid; grid-template-columns: 1fr; gap: 16px; }
  @media (min-width: 720px) { .op-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .op-grid { grid-template-columns: repeat(3, 1fr); gap: 20px; } }
  .op-card {
    background: var(--co-white);
    border: 1px solid var(--co-line);
    padding: 24px;
    text-decoration: none;
    color: var(--co-text);
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: border-color 220ms ease, box-shadow 220ms ease, transform 220ms ease;
  }
  .op-card:hover { border-color: var(--co-navy); box-shadow: 0 24px 48px -28px rgba(12,37,69,0.22); transform: translateY(-2px); }
  .op-card--featured { border-color: var(--co-navy); border-top: 4px solid var(--co-amber); }
  .op-card__head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .op-card__badge {
    font-family: var(--co-sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--co-amber);
  }
  .op-card h3 { color: var(--co-ink); margin: 0; }
  .op-card p { font-family: var(--co-sans); font-size: 14px; color: var(--co-mute); margin: 0; line-height: 1.6; }
  .op-card .co-link { align-self: flex-start; margin-top: auto; }

  .op-stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.12); }
  @media (min-width: 880px) { .op-stats { grid-template-columns: repeat(4, 1fr); } }
  .op-stat { background: rgba(255,255,255,0.02); padding: 28px 22px; display: flex; flex-direction: column; gap: 6px; }
  .op-stat__v { font-size: clamp(28px, 3vw, 44px); color: var(--co-white); line-height: 1; }
  .op-stat__l { font-family: var(--co-sans); font-size: 12px; font-weight: 600; letter-spacing: 0.06em; color: var(--co-amber); text-transform: uppercase; }

  .op-cta { display: flex; flex-direction: column; gap: 18px; align-items: flex-start; max-width: 60ch; }
  .op-cta h2 { color: var(--co-ink); }
  .op-cta p { font-family: var(--co-sans); font-size: 17px; color: var(--co-mute); margin: 0; line-height: 1.65; }
</style>
