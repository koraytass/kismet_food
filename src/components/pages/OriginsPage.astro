      { n: '11', l: 'دولة منشأ' },
      { n: '100%', l: 'توريد قابل للتتبع' },
      { n: '24س', l: 'رؤية لوجستية' },
    ],
    ctaTitle: 'لنبنِ خطة منشأ مخصصة لمواصفاتك.',
