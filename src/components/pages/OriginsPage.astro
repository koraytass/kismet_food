const contactHref = localePath('/contact/', locale);

/* Origin marker data for the interactive Leaflet map.
 * Keys align with `copy.countries[].k`, so localized names flow through. */
const markerMeta: Record<
  string,
  { lat: number; lng: number; category: OriginMarker['category']; productsKey: string[] }
> = {
  turkiye: { lat: 40.91, lng: 38.39, category: 'mixed', productsKey: ['nuts', 'spices', 'dried'] },
  ethiopia: { lat: 6.15, lng: 38.2, category: 'coffee', productsKey: ['coffee'] },
  colombia: { lat: 2.55, lng: -75.52, category: 'coffee', productsKey: ['coffee'] },
  vietnam: { lat: 12.7, lng: 108.1, category: 'coffee', productsKey: ['coffee', 'cashew', 'pepper'] },
  ghana: { lat: 6.7, lng: -1.62, category: 'cocoa', productsKey: ['cocoa'] },
  ivory: { lat: 4.75, lng: -6.64, category: 'cocoa', productsKey: ['cocoa'] },
  indonesia: { lat: 0.6, lng: 100.0, category: 'coffee', productsKey: ['coffee', 'spices'] },
  brazil: { lat: -18.5, lng: -44.5, category: 'coffee', productsKey: ['coffee'] },
  uganda: { lat: 1.12, lng: 34.53, category: 'coffee', productsKey: ['coffee'] },
  kenya: { lat: -0.42, lng: 36.95, category: 'coffee', productsKey: ['coffee'] },
  rwanda: { lat: -2.5, lng: 28.9, category: 'coffee', productsKey: ['coffee'] },
};

/* Locale-scoped product labels used inside the map popup. */
const productLabels: Record<Locale, Record<string, string>> = {
  tr: { coffee: 'Kahve', cocoa: 'Kakao', nuts: 'Kuruyemiş', spices: 'Baharat', dried: 'Kuru meyve', cashew: 'Kaju', pepper: 'Kara biber' },
  en: { coffee: 'Coffee', cocoa: 'Cocoa', nuts: 'Nuts', spices: 'Spices', dried: 'Dried fruit', cashew: 'Cashew', pepper: 'Pepper' },
  ar: { coffee: 'قهوة', cocoa: 'كاكاو', nuts: 'مكسرات', spices: 'توابل', dried: 'فواكه مجففة', cashew: 'كاجو', pepper: 'فلفل أسود' },
};

const mapMarkers: OriginMarker[] = copy.countries.map((c) => {
  const meta = markerMeta[c.k];
  return {
    k: c.k,
    name: c.name,
    region: c.region,
    products: meta ? meta.productsKey.map((p) => productLabels[locale][p] ?? p) : [],
    lat: meta?.lat ?? 0,
    lng: meta?.lng ?? 0,
    href: (c as { href?: string }).href,
    category: meta?.category ?? 'mixed',
  };
});

const mapLabels = {
  tr: {
    title: 'Menşelerimize dokunun',
    lead: 'Her nokta üzerine gelin — ürün, bölge ve menşe detayı yan kartta açılır.',
    viewDetail: 'Detayı gör',
    mapAria: 'Kısmet Foods menşe ağı interaktif haritası',
    panelHint: 'Bir noktanın üzerine gelin · ya da dokunun',
    closeLabel: 'Kapat',
  },
  en: {
    title: 'Hover into every origin',
    lead: 'Move over any marker — product, region and origin detail open in the side card.',
    viewDetail: 'View detail',
    mapAria: 'Kismet Foods origin network interactive map',
    panelHint: 'Hover a marker · or tap',
    closeLabel: 'Close',
  },
  ar: {
    title: 'اقترب من كل منشأ',
    lead: 'مرر فوق أي علامة — يفتح المنتج والمنطقة وتفاصيل المنشأ في البطاقة الجانبية.',
    viewDetail: 'عرض التفاصيل',
    mapAria: 'خريطة تفاعلية لشبكة مناشئ كسمت فودز',
    panelHint: 'مرر فوق علامة · أو اضغط',
    closeLabel: 'إغلاق',
  },
}[locale];
---

<SiteHeader locale={locale} currentPath={currentPath} />

<Breadcrumb locale={locale} items={[{ name: tr.nav.origins }]} />

<main id="main" class="bg-surface">
  {/* Hero — asymmetric 4/8 split, italic accent on title */}
  <section class="relative overflow-hidden bg-surface-low px-4 py-20 md:px-8 md:py-28 lg:py-32">
    <div class="mx-auto max-w-7xl">
      <div class="grid grid-cols-1 items-center gap-10 md:grid-cols-12 md:gap-14">
        <div class="md:col-span-5 lg:col-span-4">
          <span class="eyebrow mb-6 block text-orange">{copy.eyebrow}</span>
          <h1 class="serif-display mb-8 text-4xl font-semibold leading-[1.05] tracking-tight text-on-surface md:text-5xl lg:text-[3.5rem]">
            {copy.heroTitle}
          </h1>
          <p class="max-w-prose text-base leading-[1.7] text-on-surface-muted md:text-lg">
            {copy.heroLead}
          </p>
        </div>
        <div class="md:col-span-7 lg:col-span-8">
          <figure class="photo-grade photo-grade--cool relative overflow-hidden rounded-md shadow-editorial">
            <img
              src={mapImg}
              alt={copy.mapAlt}
              class="aspect-[16/10] w-full object-cover"
              width="1600"
              height="1000"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </figure>
        </div>
      </div>
    </div>
  </section>

  <AmuletDivider compact ariaLabel="section divider" />

  {/* Interactive world map */}
  <section id="origins-interactive-map" class="px-4 py-20 md:px-8 md:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="mb-10 max-w-3xl">
        <h2 class="serif-display mb-3 text-3xl font-bold leading-tight text-on-surface md:text-4xl">
          {mapLabels.title}
        </h2>
        <p class="text-base leading-relaxed text-on-surface-muted">{mapLabels.lead}</p>
      </div>
      <OriginsMap
        markers={mapMarkers}
        labels={{
          viewDetail: mapLabels.viewDetail,
          mapAria: mapLabels.mapAria,
          panelHint: mapLabels.panelHint,
          closeLabel: mapLabels.closeLabel,
        }}
      />
    </div>
  </section>

  {/* Country grid */}
  <section class="bg-surface-low px-4 py-20 md:px-8 md:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="mb-12 max-w-3xl">
        <h2 class="serif-display mb-4 text-3xl font-bold leading-tight text-on-surface md:text-4xl lg:text-5xl">
          {copy.countriesTitle}
        </h2>
        <p class="text-lg leading-relaxed text-on-surface-muted">{copy.countriesLead}</p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {copy.countries.map((c) => {
          const isLink = Boolean((c as any).href);
          const Tag: any = isLink ? 'a' : 'article';
          const featured = (c as any).featured;
          return (
            <Tag
              {...(isLink ? { href: (c as any).href } : {})}
              class={`group relative block overflow-hidden rounded-lg bg-surface-lowest shadow-editorial transition-transform hover:-translate-y-1 ${featured ? 'md:col-span-2 lg:col-span-2' : ''}`}
            >
              <div class="relative overflow-hidden">
                <img
                  src={originImgs[c.k]}
                  alt={c.name}
                  class={`w-full object-cover transition-transform duration-700 group-hover:scale-105 ${featured ? 'aspect-[16/7]' : 'aspect-[4/3]'}`}
                  width="1200"
                  height="800"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-surface-deep/70 to-transparent"></div>
                <div class="absolute bottom-0 start-0 p-6 text-white">
                  <span class="eyebrow mb-1 block text-orange">{c.region}</span>
                  <h3 class="serif-display text-2xl font-bold md:text-3xl">{c.name}</h3>
                </div>
              </div>
              <div class="p-6">
                <p class="leading-relaxed text-on-surface-muted">{c.body}</p>
                {isLink && (
                  <span class="eyebrow mt-4 inline-block text-teal group-hover:text-orange">
                    {copy.viewBtn} →
                  </span>
                )}
              </div>
            </Tag>
          );
        })}
      </div>
    </div>
  </section>

  {/* Stats */}
  <section class="cta-gradient px-4 py-20 text-white md:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="serif-display mb-12 text-center text-3xl font-bold md:text-4xl">
        {copy.statsTitle}
      </h2>
      <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
        {copy.stats.map((s) => (
          <div class="text-center">
            <span class="serif-display mb-2 block text-4xl font-bold md:text-5xl">{s.n}</span>
            <span class="eyebrow block text-white/75">{s.l}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* CTA */}
  <section class="bg-surface-mid px-4 py-20 md:px-8">
    <div class="mx-auto max-w-4xl text-center">
