/* Country data — structure is locale-agnostic; labels filled per-locale below */
const originImgs: Record<string, string> = {
  turkiye: turkiyeImg,
  ethiopia: ethiopiaImg,
  colombia: ethiopiaImg,
  vietnam: ghanaImg,
  ghana: ghanaImg,
  ivory: ghanaImg,
  indonesia: ethiopiaImg,
  brazil: ethiopiaImg,
  uganda: ghanaImg,
  kenya: ethiopiaImg,
  rwanda: ethiopiaImg,
