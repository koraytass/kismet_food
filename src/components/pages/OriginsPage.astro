      { k: 'colombia', name: 'Kolombiya', region: 'Huila · Nariño', body: 'Dengeli asidite ve karamel notalı specialty kahve.' },
      { k: 'vietnam', name: 'Vietnam', region: 'Dak Lak · Lam Dong', body: 'Robusta kahve, kaju ve kara biber; ölçekte sürekli tedarik.' },
      { k: 'ghana', name: 'Gana', region: 'Ashanti · Western', body: 'Fermente kakao çekirdeği — çikolatacılar için premium seçim.' },
      { k: 'ivory', name: 'Fildişi Sahili', region: 'San-Pédro · Abidjan', body: 'Dünyanın en büyük kakao üreticisinden izlenebilir tedarik.' },
      { k: 'indonesia', name: 'Endonezya', region: 'Sumatra · Sulawesi', body: 'Sumatra kahvesi, Hindistan cevizi ve baharatlar.' },
      { k: 'brazil', name: 'Brezilya', region: 'Minas Gerais · Sul', body: 'Harman-tabanlı arabica ve specialty microlot kahveler.' },
