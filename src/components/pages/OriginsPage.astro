      { k: 'colombia', name: 'كولومبيا', region: 'هويلا · نارينيو', body: 'قهوة مختصة ذات حموضة متوازنة ونكهات كراميل.' },
      { k: 'vietnam', name: 'فيتنام', region: 'داك لاك · لام دونغ', body: 'بُن روبوستا، كاجو وفلفل أسود — توريد مستمر بكميات كبيرة.' },
      { k: 'ghana', name: 'غانا', region: 'أشانتي · الغربية', body: 'حبوب كاكاو مُخمّرة — الخيار الممتاز لصانعي الشوكولاتة.' },
      { k: 'ivory', name: 'ساحل العاج', region: 'سان بيدرو · أبيدجان', body: 'توريد قابل للتتبع من أكبر منتج للكاكاو في العالم.' },
      { k: 'indonesia', name: 'إندونيسيا', region: 'سومطرة · سولاوسي', body: 'قهوة سومطرة، جوز الهند والتوابل.' },
      { k: 'brazil', name: 'البرازيل', region: 'ميناس جيرايس · الجنوب', body: 'أرابيكا للمزجات وقهوة مايكرولوت مختصة.' },
      { k: 'uganda', name: 'أوغندا', region: 'جبل إلغون · روينزوري', body: 'أرابيكا وروبوستا عضوية — من التعاونيات.' },
      { k: 'kenya', name: 'كينيا', region: 'نيري · كيرينياغا', body: 'أرابيكا SL28/SL34 — حموضة لامعة وطابع كيني أيقوني.' },
      { k: 'rwanda', name: 'رواندا', region: 'نياماشيكي · غاكينكي', body: 'أرابيكا بوربون — ملامح أنيقة من المعالجة المغسولة.' },
