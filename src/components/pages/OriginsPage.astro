---
/**
 * OriginsPage — Reusable section composition for /<locale>/origins/.
 * Shows static world-map context with linked country origin cards.
 * Sections: Hero w/ map · Country grid · Stats · CTA
 */
import type { Locale } from '@/i18n';
import { t, localePath } from '@/i18n';
import { stitchSrc } from '@/lib/stitch';
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
import Breadcrumb from '../Breadcrumb.astro';
import OriginsMap, { type OriginMarker } from '../OriginsMap.astro';
import Button from '../Button.astro';
import AmuletDivider from '../AmuletDivider.astro';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const tr = t(locale);

const turkiyeHref = localePath('/origins/turkiye/', locale);

/* Shared image URLs (stitchSrc applied) */
const mapImg = stitchSrc(
