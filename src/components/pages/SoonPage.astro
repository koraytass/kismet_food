---
/**
 * SoonPage — Editorial under-construction teaser.
 *
 * Responsive approach:
 *   Desktop (lg+): 44/56 split, editorial column left, static 2×2
 *     equal-size gallery right (one-screen, no scroll).
 *   Mobile / tablet: Cinematic single-hero cross-fade (slides between
 *     Kahve → Kakao → Kaju → Baharat every ~6 s) with a small caption
 *     chip + progress dots. Editorial copy flows below. Not a catalog
 *     grid — single viewport, feels like a film opening.
 *
 *   All animations are pure CSS, GPU-composited, reduced-motion safe.
 */
import { brand } from '@/lib/brand';

const coffeeImg = '/images/gallery/hero.jpg';
const cocoaImg  = '/images/gallery/cocoa.jpg';
const nutsImg   = '/images/gallery/caju.jpg';
const spiceImg  = '/images/gallery/spices.jpg';

interface Category {
  num: string;
  labelTr: string;
  labelEn: string;
  labelAr: string;
  accent: 'orange' | 'brown' | 'teal' | 'red' | 'slate';
  img?: string;
}

const categories: Category[] = [
  { num: '01', labelTr: 'KAHVE',                       labelEn: 'Coffee',                      labelAr: 'القهوة',                     accent: 'orange', img: coffeeImg },
  { num: '02', labelTr: 'KAKAO',                       labelEn: 'Cocoa',                       labelAr: 'الكاكاو',                    accent: 'brown',  img: cocoaImg  },
  { num: '03', labelTr: 'KURUYEMİŞ',                   labelEn: 'Nuts',                        labelAr: 'المكسرات',                   accent: 'teal',   img: nutsImg   },
  { num: '04', labelTr: 'BAHARAT',                     labelEn: 'Spices',                      labelAr: 'التوابل',                    accent: 'red',    img: spiceImg  },
  { num: '05', labelTr: 'ENDÜSTRİYEL GIDA İÇERİKLERİ', labelEn: 'Industrial Food Ingredients', labelAr: 'المكونات الغذائية الصناعية', accent: 'slate' },
];

// Only categories with an image participate in the mobile cinematic cross-fade.
const heroSlides = categories.filter((c): c is Category & { img: string } => Boolean(c.img));

const accentDot = {
  orange: 'bg-orange',
  brown: 'bg-amber-800',
  teal: 'bg-teal',
  red: 'bg-red',
  slate: 'bg-slate-500',
} as const;
---

<div
  class="soon relative w-full bg-white text-neutral-900
         lg:grid lg:h-[100svh] lg:min-h-[780px] lg:grid-cols-[44%_1fr] lg:overflow-hidden"
>

  {/* ════════════════ LEFT (desktop) / TOP flow (mobile) ════════════════ */}
  <section
    class="relative z-10 flex flex-col px-5 pt-[calc(env(safe-area-inset-top,0px)+24px)] pb-6
           md:px-10 md:pt-10 md:pb-8
           lg:h-full lg:justify-between lg:px-14 lg:pt-14 lg:pb-10 xl:px-20"
  >
    {/* Logo */}
    <header class="soon-fade-1 flex w-full justify-center">
      <div class="soon-logo-wrap relative inline-block">
        <img
          src="/logos/logo-teal.svg"
          alt="Kismet Foods"
          width="360" height="264"
          class="soon-logo soon-logo-teal h-36 w-auto sm:h-44 md:h-52 lg:h-60"
        />
        <img
          src="/logos/logo-orange.svg" alt="" aria-hidden="true"
          width="360" height="264"
          class="soon-logo soon-logo-orange absolute left-0 top-0 h-36 w-auto sm:h-44 md:h-52 lg:h-72"
        />
      </div>
    </header>

    {/* ───── MOBILE-ONLY cinematic hero — sits right under the logo ───── */}
    <div class="relative my-6 aspect-[4/3] w-full overflow-hidden rounded-sm bg-neutral-100 sm:aspect-[16/10] md:aspect-[16/9] lg:hidden">
      {heroSlides.map((cat, i) => (
        <div
          class={`soon-cf soon-cf-${i} absolute inset-0`}
          aria-hidden={i === 0 ? undefined : 'true'}
        >
          <img
            src={cat.img}
            alt={cat.labelEn}
            class={`soon-cf-zoom soon-cf-zoom-${i} h-full w-full object-cover`}
            loading="eager"
            decoding="async"
          />
          {/* per-slide soft gradient for dot legibility */}
          <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-black/45 to-transparent" aria-hidden="true"></div>
        </div>
      ))}

      {/* Progress dots — above all slides */}
      <nav aria-label="Showcase progress" class="absolute bottom-3 right-3 z-10 flex items-center gap-1.5 md:bottom-4 md:right-4">
        {heroSlides.map((_, i) => (
          <span class="block h-1 w-5 overflow-hidden rounded-full bg-white/30 md:w-6">
            <span class={`soon-cf-dot-fill soon-cf-dot-${i} block h-full origin-left bg-white`}></span>
          </span>
        ))}
      </nav>
    </div>

    {/* Editorial text block (below mobile hero; top of left col on desktop) */}
    <div class="flex flex-col lg:py-0">
      <span class="soon-fade-2 mx-auto inline-flex items-center gap-3 text-xs font-bold uppercase tracking-[0.32em] text-orange sm:gap-4 sm:text-sm lg:text-base">
        <span class="soon-rule h-[2px] w-12 bg-orange sm:w-14 lg:w-20"></span>
        Trade. Trust. Kismet.
        <span class="soon-rule-r h-[2px] w-12 bg-orange sm:w-14 lg:w-20"></span>
      </span>

      <h1 class="soon-fade-3 mt-5 text-center font-serif text-[2.25rem] font-bold leading-[1.04] tracking-tight text-neutral-900 sm:text-4xl md:text-[2.5rem] lg:text-[3.25rem]">
        Something exceptional <span class="italic text-teal">is arriving.</span>
      </h1>

      <p class="soon-fade-4 mt-3 text-center font-serif text-lg italic leading-snug text-neutral-400 sm:text-xl lg:text-2xl">
        Olağanüstü bir şey hazırlanıyor.
      </p>
      <p dir="rtl" lang="ar" class="soon-fade-5 mt-1 text-center font-serif text-xl leading-[1.35] text-neutral-400 sm:text-2xl lg:text-[1.65rem]">
        شيء استثنائي قريباً
      </p>

      {/* Category list — mobile: two-row (bold TR top, EN+AR below); desktop: one-row */}
      <ul class="mt-6 divide-y divide-neutral-200/80 border-y border-neutral-200/80 lg:mt-7">
        {categories.map((cat, i) => (
          <li
            class:list={[
              'py-2.5 md:py-3.5 lg:py-2',
              ['soon-fade-3', 'soon-fade-4', 'soon-fade-5', 'soon-fade-6', 'soon-fade-7'][i],
            ]}
          >
            <div class="flex items-center gap-2.5 md:gap-3">
              <span class="font-serif text-xs italic tracking-wide text-neutral-300">{cat.num}</span>
              <span class:list={['inline-block h-2 w-2 flex-shrink-0 rounded-full', accentDot[cat.accent]]} aria-hidden="true" />
              <span class="font-serif text-lg font-bold tracking-tight text-neutral-900 lg:text-xl">
                {cat.labelTr}
              </span>
              <span class="hidden font-serif text-sm italic text-neutral-400 lg:inline lg:text-base">· {cat.labelEn}</span>
              <span dir="rtl" lang="ar" class="hidden font-serif text-base text-neutral-400 lg:inline lg:text-lg">· {cat.labelAr}</span>
            </div>
            {/* Mobile-only secondary row (EN + AR beneath TR) */}
            <div class="mt-0.5 flex items-baseline gap-2 pl-[2rem] lg:hidden">
              <span class="font-serif text-xs italic text-neutral-400">{cat.labelEn}</span>
              <span class="text-neutral-300">·</span>
              <span dir="rtl" lang="ar" class="font-serif text-sm text-neutral-400">{cat.labelAr}</span>
            </div>
          </li>
        ))}
      </ul>

      <div class="soon-fade-7 mt-6 flex flex-col items-center lg:mt-6">
        <p class="text-xs font-bold uppercase tracking-[0.32em] text-neutral-400">Commercial Inquiries</p>
        <a
          id="soon-mail"
          href="mailto:commercial@kismetfoods.com"
          data-email="commercial@kismetfoods.com"
          class="group relative mt-2 inline-flex items-baseline gap-2 font-serif text-lg tracking-tight text-neutral-900 lg:text-xl"
        >
          <span class="border-b border-neutral-900 pb-0.5 transition-colors duration-300 group-hover:border-orange group-hover:text-orange">
            commercial@kismetfoods.com
          </span>
          <span class="inline-block text-orange transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
          <span
            id="soon-mail-toast"
            class="pointer-events-none absolute -top-9 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-sm bg-neutral-900 px-3 py-1 text-xs font-normal not-italic tracking-normal text-white opacity-0 transition-opacity duration-300"
            role="status"
            aria-live="polite"
          >
            E-posta kopyalandı · Copied · تم النسخ
          </span>
        </a>
        <script is:inline>
          (function () {
            const link = document.getElementById('soon-mail');
            const toast = document.getElementById('soon-mail-toast');
            if (!link || !toast) return;
            link.addEventListener('click', async (e) => {
              const email = link.dataset.email;
              if (!email) return;
              // Always copy the address to clipboard as a robust fallback
              try {
                if (navigator.clipboard && window.isSecureContext) {
                  await navigator.clipboard.writeText(email);
                } else {
                  const ta = document.createElement('textarea');
                  ta.value = email;
                  ta.style.position = 'fixed';
                  ta.style.opacity = '0';
                  document.body.appendChild(ta);
                  ta.select();
                  document.execCommand('copy');
                  document.body.removeChild(ta);
                }
              } catch (_) {
                /* ignore — mailto: still fires */
              }
              toast.style.opacity = '1';
              setTimeout(() => {
                toast.style.opacity = '0';
              }, 2200);
              // Do NOT preventDefault — let the native mailto: handler try to open.
            });
          })();
        </script>
      </div>
    </div>

    {/* Legal — desktop: bottom of left col / mobile: continues in flow */}
    <footer class="soon-fade-7 mt-6 flex items-center justify-center border-t border-neutral-200/70 pt-4 text-[10px] tracking-[0.22em] lg:mt-0 lg:pt-5 lg:text-[11px]">
      <address class="not-italic">
        <span class="font-bold uppercase text-neutral-700">{brand.legalName}</span>
      </address>
    </footer>
  </section>

  {/* Preview bypass — sets a cookie that disables the soon-page redirects.
       Visible pill button, fixed bottom-right corner. */}
  <a
    href="/tr/"
    id="soon-bypass"
    class="fixed bottom-4 right-4 z-50 inline-flex items-center gap-2 rounded-full bg-teal px-5 py-2.5 text-[11px] font-bold uppercase tracking-[0.22em] text-white shadow-lg shadow-black/20 transition-colors duration-300 hover:bg-orange focus:outline-none focus-visible:ring-2 focus-visible:ring-orange focus-visible:ring-offset-2 sm:bottom-6 sm:right-6 sm:px-6 sm:py-3 sm:text-xs"
    aria-label="Preview internal site"
  >
    <span>Preview Site</span>
    <span aria-hidden="true">→</span>
  </a>
  <script is:inline>
    (function () {
      const link = document.getElementById('soon-bypass');
      if (!link) return;
      link.addEventListener('click', function (e) {
        e.preventDefault();
        document.cookie = 'kismet_bypass=1; path=/; max-age=604800; SameSite=Lax';
        window.location.href = link.getAttribute('href');
      });
    })();
  </script>

  {/* ════════════════ RIGHT — Desktop-only 2×2 gallery ════════════════ */}
  <section class="relative hidden h-full overflow-hidden bg-neutral-100 p-2 lg:block">
    <div class="grid h-full w-full grid-cols-2 grid-rows-2 gap-2">
      <figure class="soon-fade-2 relative overflow-hidden rounded-sm">
        <img src={coffeeImg} alt="Macro shot of roasted coffee beans"
          class="soon-kenburns h-full w-full object-cover"
          loading="eager" decoding="async" />
      </figure>
      <figure class="soon-fade-3 relative overflow-hidden rounded-sm">
        <img src={cocoaImg} alt="Raw cocoa beans, pods and powder"
          class="h-full w-full object-cover transition-transform duration-700 hover:scale-[1.04]"
          loading="eager" decoding="async" />
      </figure>
      <figure class="soon-fade-4 relative overflow-hidden rounded-sm">
        <img src={nutsImg} alt="Premium cashew nuts"
          class="h-full w-full object-cover transition-transform duration-700 hover:scale-[1.04]"
          loading="eager" decoding="async" />
      </figure>
      <figure class="soon-fade-5 relative overflow-hidden rounded-sm">
        <img src={spiceImg} alt="Heritage spices flat-lay on wood"
          class="h-full w-full object-cover transition-transform duration-700 hover:scale-[1.04]"
          loading="eager" decoding="async" />
      </figure>
    </div>
  </section>
</div>

<style>
  /* ── Staggered fade-up ─────────────────────────────────────────── */
  @keyframes soon-rise {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .soon [class*='soon-fade-'] {
    opacity: 0;
    animation: soon-rise 900ms cubic-bezier(0.22, 0.72, 0.22, 1) forwards;
  }
  .soon-fade-1 { animation-delay: 100ms; }
  .soon-fade-2 { animation-delay: 260ms; }
  .soon-fade-3 { animation-delay: 420ms; }
  .soon-fade-4 { animation-delay: 560ms; }
  .soon-fade-5 { animation-delay: 700ms; }
  .soon-fade-6 { animation-delay: 840ms; }
  .soon-fade-7 { animation-delay: 1000ms; }

  @keyframes soon-rule-grow {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }
  .soon-rule { transform-origin: right; animation: soon-rule-grow 900ms cubic-bezier(0.22, 0.72, 0.22, 1) 500ms both; }
  .soon-rule-r { transform-origin: left; animation: soon-rule-grow 900ms cubic-bezier(0.22, 0.72, 0.22, 1) 500ms both; }

  /* ── Logo slide-swap (teal exits left, orange enters from right, loops) ─
     8s total cycle. Each colour is stationary-visible for 3 s, then
     transitions to the opposite side while its twin slides in.
     Teleport back to the right happens while opacity is 0 (invisible). */
  .soon-logo-wrap { isolation: isolate; overflow: hidden; }

  @keyframes soon-logo-teal-slide {
    0%, 37.5%   { opacity: 1; transform: translateX(0); }
    50%         { opacity: 0; transform: translateX(-110%); }
    51%         { opacity: 0; transform: translateX(110%); }
    87.5%       { opacity: 0; transform: translateX(110%); }
    100%        { opacity: 1; transform: translateX(0); }
  }
  @keyframes soon-logo-orange-slide {
    0%          { opacity: 0; transform: translateX(110%); }
    37.5%       { opacity: 0; transform: translateX(110%); }
    50%         { opacity: 1; transform: translateX(0); }
    87.5%       { opacity: 1; transform: translateX(0); }
    99.9%       { opacity: 0; transform: translateX(-110%); }
    100%        { opacity: 0; transform: translateX(110%); }
  }
  .soon-logo-teal {
    animation:
      soon-rise 900ms cubic-bezier(0.22, 0.72, 0.22, 1) forwards,
      soon-logo-teal-slide 8s cubic-bezier(0.65, 0, 0.35, 1) 1.2s infinite;
  }
  .soon-logo-orange {
    animation: soon-logo-orange-slide 8s cubic-bezier(0.65, 0, 0.35, 1) 1.2s infinite;
  }

  /* ── Desktop ken-burns on first (hero) gallery tile ───────────── */
  @keyframes soon-kenburns {
    0%   { transform: scale(1) translate3d(0, 0, 0); }
    50%  { transform: scale(1.04) translate3d(-0.4%, -0.3%, 0); }
    100% { transform: scale(1) translate3d(0, 0, 0); }
  }
  .soon-kenburns { animation: soon-kenburns 22s ease-in-out infinite; }

  /* ── Mobile cinematic cross-fade ─────────────────────────────────
     Total cycle = 24 s (4 slides × 6 s each).
     Each slide: 5 s visible (0–21%), 1 s fade-out (21–25%), hidden 25–100%.
     Staggered delays place each slide at its window.
  */
  @keyframes soon-cf-cycle {
    0%, 21%   { opacity: 1; }
    25%, 96%  { opacity: 0; }
    100%      { opacity: 1; }
  }
  @keyframes soon-cf-zoom {
    0%   { transform: scale(1.01); }
    21%  { transform: scale(1.06); }
    25%, 100% { transform: scale(1.01); }
  }
  @keyframes soon-cf-dot {
    0%   { transform: scaleX(0); }
    21%  { transform: scaleX(1); }
    25%, 100% { transform: scaleX(0); }
  }

  .soon-cf        { opacity: 0; animation: soon-cf-cycle 24s linear infinite; }
  .soon-cf-zoom   { animation: soon-cf-zoom 24s ease-in-out infinite; }
  .soon-cf-dot-fill { transform: scaleX(0); animation: soon-cf-dot 24s linear infinite; }

  .soon-cf-0, .soon-cf-zoom-0, .soon-cf-dot-0 { animation-delay: 0s; }
  .soon-cf-1, .soon-cf-zoom-1, .soon-cf-dot-1 { animation-delay: 6s; }
  .soon-cf-2, .soon-cf-zoom-2, .soon-cf-dot-2 { animation-delay: 12s; }
  .soon-cf-3, .soon-cf-zoom-3, .soon-cf-dot-3 { animation-delay: 18s; }

  /* ── Reduced motion ─────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .soon [class*='soon-fade-'],
    .soon-rule, .soon-rule-r,
    .soon-logo-teal, .soon-logo-orange,
    .soon-kenburns,
    .soon-cf, .soon-cf-zoom,
    .soon-cf-dot-fill {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
    .soon-logo-orange { opacity: 0 !important; }
    /* Only show first slide static */
    .soon-cf-1, .soon-cf-2, .soon-cf-3 { opacity: 0 !important; }
    .soon-cf-0 { opacity: 1 !important; }
  }
</style>
