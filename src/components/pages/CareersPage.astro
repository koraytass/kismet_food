---
import type { Locale } from '@/i18n';
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
import CorpPageHero from '../v3/CorpPageHero.astro';
import CorpSection from '../v3/CorpSection.astro';

interface Props { locale: Locale; currentPath: string }
const { locale, currentPath } = Astro.props;

const copy = {
  tr: {
    eyebrow: 'KARİYER · 5 KITADA EKİP',
    heroTitle: 'Kismet’te emtia ticareti, küratörlüktür.',
    heroLead: 'İstanbul merkezli, 30 kişilik kurumsal yapı; her menşede saha, her hatta uzman portföy yöneticisi. Aradığımız: disiplinli, sahaya çıkmaya hazır, üç pazarlı düşünen profesyoneller.',
    cultureEyebrow: 'KÜLTÜR', cultureTitle: 'Disiplin', cultureItalic: 'sahanın kalbinde.',
    cultureLead: 'B2B ticareti bir spread oyunu değil; bir karar disiplini. Her kararı öncesinden numune ile, sonrasından parti hafızası ile doğrularız.',
    values: [
      { h: 'Saha-içi düşünce', d: 'Yılda 2 kez tüm ekip menşe ziyareti. Çiftçi, kooperatif, ihracatçıyla yüz yüze.' },
      { h: 'Belge disiplini', d: 'Numune doğrulamadan gümrük çıkışına; her sevkiyatta 14 kontrol noktası.' },
      { h: 'Üç pazarlı düşünce', d: 'TR, EN, AR — Avrupa, Orta Doğu ve Asya alıcısı için aynı netlikte iletişim.' },
      { h: 'Karar şeffaflığı', d: '2-haftalık review döngüleri; her kategori ve müşteri tarafı açık masada.' },
    ],
    rolesEyebrow: 'AÇIK ROLLER', rolesTitle: 'Şu an açık', rolesItalic: 'pozisyonlar.',
    roles: [
      { h: 'Origin Trader · Kahve', loc: 'İstanbul', type: 'Tam zamanlı', d: 'Etiyopya/Kolombiya/Vietnam kahve hatlarını yönetecek 5+ yıl emtia tecrübeli portföy yöneticisi. Q Grader sertifikası tercih sebebi.' },
      { h: 'QA Specialist · Lab + Saha', loc: 'İstanbul + remote menşe', type: 'Tam zamanlı', d: 'Laboratuvar protokolleri, parti onayı ve menşe ziyaretleri. Gıda mühendisliği veya kimya temelli.' },
      { h: 'Logistics Coordinator · FOB/CIF/DDP', loc: 'İstanbul', type: 'Tam zamanlı', d: 'MAERSK/MSC/COSCO sözleşmeleri, gümrük müşaviri koordinasyonu, transit takibi.' },
      { h: 'EUDR Compliance Lead', loc: 'İstanbul + AB', type: 'Tam zamanlı', d: 'Geo-trace + farmer-ID sistemleri, EU EUDR uyumluluğu, ESG raporlama.' },
      { h: 'Account Manager · MENA', loc: 'Dubai veya İstanbul', type: 'Tam zamanlı', d: 'BAE, Suudi Arabistan, Mısır ve Kuzey Afrika pazarı bölge hesabı. Arapça akıcı, B2B emtia tecrübesi.' },
    ],
    benefitsEyebrow: 'YAN HAKLAR', benefitsTitle: 'Ekibe katılınca,', benefitsItalic: 'ne düşünmezsin?',
    benefits: [
      { h: 'Sağlık', d: 'Premium özel sağlık sigortası (eş ve çocuk dahil).' },
      { h: 'Saha', d: 'Yılda 2 kez tüm ekip menşe ziyareti, ekip + bireysel programlarla.' },
      { h: 'Eğitim', d: 'SCA, Q Grader, Kakao master programları için yıllık eğitim bütçesi.' },
      { h: 'Esneklik', d: 'İstanbul ofis + remote hibrit, 25 gün yıllık izin + 4 gün menşe izni.' },
    ],
    ctaTitle: 'CV\'nizi gönderin.',
    ctaLead: 'careers@kismetfoods.com — başvurularınız 2 hafta içinde değerlendirilir, açık pozisyon olmasa bile portföye eklenir.',
    ctaBtn: 'careers@kismetfoods.com',
  },
  en: {
    eyebrow: 'CAREERS · TEAM ACROSS 5 CONTINENTS',
    heroTitle: 'At Kismet, commodity trading is curation.',
    heroLead: 'Istanbul-based 30-person organisation; field representation per origin, dedicated portfolio manager per line. We hire disciplined, field-ready, three-market-aware professionals.',
    cultureEyebrow: 'CULTURE', cultureTitle: 'Discipline', cultureItalic: 'at the heart of the field.',
    cultureLead: 'B2B trade is not a spread game; it’s a decision discipline. Every decision validated upstream by sample and downstream by batch memory.',
    values: [
      { h: 'Field-first thinking', d: 'Two whole-team origin visits per year. Face-to-face with farmer, cooperative, exporter.' },
      { h: 'Document discipline', d: 'From sample validation to customs clearance — 14 control points per shipment.' },
      { h: 'Three-market thinking', d: 'TR, EN, AR — EU, Middle East and Asia buyers in the same clarity of communication.' },
      { h: 'Decision transparency', d: 'Two-week review cycles; every category and client side on the open table.' },
    ],
    rolesEyebrow: 'OPEN ROLES', rolesTitle: 'Currently', rolesItalic: 'open positions.',
    roles: [
      { h: 'Origin Trader · Coffee', loc: 'Istanbul', type: 'Full-time', d: 'Portfolio manager for Ethiopia/Colombia/Vietnam coffee lines, 5+ years commodity experience. Q Grader cert preferred.' },
      { h: 'QA Specialist · Lab + Field', loc: 'Istanbul + remote origin', type: 'Full-time', d: 'Lab protocols, batch approval, origin visits. Food engineering or chemistry background.' },
      { h: 'Logistics Coordinator · FOB/CIF/DDP', loc: 'Istanbul', type: 'Full-time', d: 'MAERSK/MSC/COSCO contracts, customs broker coordination, transit tracking.' },
      { h: 'EUDR Compliance Lead', loc: 'Istanbul + EU', type: 'Full-time', d: 'Geo-trace + farmer-ID systems, EU EUDR compliance, ESG reporting.' },
      { h: 'Account Manager · MENA', loc: 'Dubai or Istanbul', type: 'Full-time', d: 'UAE, Saudi Arabia, Egypt and North Africa regional account. Arabic fluency, B2B commodity background.' },
    ],
    benefitsEyebrow: 'BENEFITS', benefitsTitle: 'When you join,', benefitsItalic: 'what you don’t worry about.',
    benefits: [
      { h: 'Health', d: 'Premium private health insurance (spouse and child included).' },
      { h: 'Field', d: 'Two whole-team origin visits per year with team + individual programmes.' },
      { h: 'Education', d: 'Annual training budget for SCA, Q Grader, Cocoa master programmes.' },
      { h: 'Flexibility', d: 'Istanbul office + remote hybrid, 25 days annual leave + 4 origin-leave days.' },
    ],
    ctaTitle: 'Send your CV.',
    ctaLead: 'careers@kismetfoods.com — applications reviewed within 2 weeks, added to portfolio even when no role is open.',
    ctaBtn: 'careers@kismetfoods.com',
  },
  ar: {
    eyebrow: 'الوظائف · فريق في ٥ قارات',
    heroTitle: 'تجارة السلع في كسمت تنسيق.',
    heroLead: 'هيكل ٣٠ شخصاً مقره إسطنبول؛ تمثيل ميداني في كل منشأ، مدير محفظة مخصص لكل خط.',
    cultureEyebrow: 'الثقافة', cultureTitle: 'الانضباط', cultureItalic: 'في قلب الميدان.',
    cultureLead: 'تجارة B2B ليست لعبة فارق؛ بل انضباط قرار.',
    values: [
      { h: 'تفكير ميداني', d: 'زيارتان للمنشأ سنوياً للفريق كاملاً.' },
      { h: 'انضباط وثائقي', d: '١٤ نقطة تحكم لكل شحنة.' },
      { h: 'تفكير ثلاثي الأسواق', d: 'TR وEN وAR.' },
      { h: 'شفافية قرار', d: 'دورات مراجعة كل أسبوعين.' },
    ],
    rolesEyebrow: 'الأدوار المفتوحة', rolesTitle: 'الوظائف', rolesItalic: 'الشاغرة حالياً.',
    roles: [
      { h: 'تاجر منشأ · قهوة', loc: 'إسطنبول', type: 'دوام كامل', d: 'إثيوبيا/كولومبيا/فيتنام، خبرة ٥+ سنوات.' },
      { h: 'أخصائي جودة · مختبر + ميدان', loc: 'إسطنبول + منشأ', type: 'دوام كامل', d: 'بروتوكولات مختبر، اعتماد دفعات.' },
      { h: 'منسق لوجستيات', loc: 'إسطنبول', type: 'دوام كامل', d: 'عقود MAERSK/MSC/COSCO.' },
      { h: 'قائد امتثال EUDR', loc: 'إسطنبول + EU', type: 'دوام كامل', d: 'أنظمة geo-trace + farmer-ID.' },
      { h: 'مدير حساب · MENA', loc: 'دبي أو إسطنبول', type: 'دوام كامل', d: 'الإمارات والسعودية ومصر وشمال أفريقيا. عربية بطلاقة.' },
    ],
    benefitsEyebrow: 'المزايا', benefitsTitle: 'حين تنضم،', benefitsItalic: 'ما لا تقلق منه.',
    benefits: [
      { h: 'صحة', d: 'تأمين خاص فاخر للزوج والأطفال.' },
      { h: 'ميدان', d: 'زيارتان للمنشأ سنوياً.' },
      { h: 'تدريب', d: 'ميزانية SCA وQ Grader.' },
      { h: 'مرونة', d: 'مكتب + هجين، ٢٥ يوماً إجازة سنوية.' },
    ],
    ctaTitle: 'أرسل سيرتك الذاتية.',
    ctaLead: 'careers@kismetfoods.com — يُراجع الطلب خلال أسبوعين.',
    ctaBtn: 'careers@kismetfoods.com',
  },
}[locale];

const heroBg = 'https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=2400&q=80';
---

<SiteHeader locale={locale} currentPath={currentPath} />

<main id="main">
  <CorpPageHero
    locale={locale}
    eyebrow={copy.eyebrow}
    title={copy.heroTitle}
    lede={copy.heroLead}
    background={heroBg}
    meta={[
      { label: 'Team', value: '30 people' },
      { label: 'Office', value: 'Istanbul' },
      { label: 'Field', value: '2 visits/yr' },
      { label: 'Languages', value: 'TR · EN · AR' },
    ]}
  />

  <CorpSection variant="white" eyebrow={copy.cultureEyebrow} title={copy.cultureTitle} italic={copy.cultureItalic} lede={copy.cultureLead}>
    <div class="cr-values">
      {copy.values.map((v, i) => (
        <article class="cr-value">
          <span class="co-num cr-value__num">0{i + 1}</span>
          <h3 class="co-h3">{v.h}</h3>
          <p>{v.d}</p>
        </article>
      ))}
    </div>
  </CorpSection>

  <CorpSection variant="snow" eyebrow={copy.rolesEyebrow} title={copy.rolesTitle} italic={copy.rolesItalic}>
    <ul class="cr-roles">
      {copy.roles.map((r) => (
        <li>
          <div class="cr-role__main">
            <h3 class="co-h3">{r.h}</h3>
            <p>{r.d}</p>
          </div>
          <div class="cr-role__meta">
            <span><span class="co-eyebrow co-eyebrow--ink">Lokasyon</span>{r.loc}</span>
            <span><span class="co-eyebrow co-eyebrow--ink">Tip</span>{r.type}</span>
            <a href="mailto:careers@kismetfoods.com" class="co-link">Başvur <span class="co-link__arrow" aria-hidden="true">→</span></a>
          </div>
        </li>
      ))}
    </ul>
  </CorpSection>

  <CorpSection variant="navy" eyebrow={copy.benefitsEyebrow} title={copy.benefitsTitle} italic={copy.benefitsItalic}>
    <div class="cr-benefits">
      {copy.benefits.map((b, i) => (
        <article class="cr-benefit">
          <span class="co-num">0{i + 1}</span>
          <h3 class="co-h3">{b.h}</h3>
          <p>{b.d}</p>
        </article>
      ))}
    </div>
  </CorpSection>

  <CorpSection variant="snow" compact>
    <div class="cr-cta">
      <h2 class="co-h2">{copy.ctaTitle}</h2>
      <p>{copy.ctaLead}</p>
      <a href="mailto:careers@kismetfoods.com" class="co-btn co-btn--primary">{copy.ctaBtn} <span aria-hidden="true">→</span></a>
    </div>
  </CorpSection>
</main>

<SiteFooter locale={locale} />

<style>
  .cr-values { display: grid; grid-template-columns: 1fr; gap: 28px; }
  @media (min-width: 880px) { .cr-values { grid-template-columns: repeat(4, 1fr); } }
  .cr-value { padding-top: 24px; border-top: 2px solid var(--co-amber); display: flex; flex-direction: column; gap: 10px; }
  .cr-value__num { font-size: 28px; color: var(--co-amber); line-height: 1; }
  .cr-value h3 { color: var(--co-ink); margin: 0; }
  .cr-value p { font-family: var(--co-sans); font-size: 14px; color: var(--co-mute); margin: 0; line-height: 1.6; }

  .cr-roles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: 0; border-top: 1px solid var(--co-line); }
  .cr-roles li { display: grid; grid-template-columns: 1fr; gap: 16px; padding: 28px 0; border-bottom: 1px solid var(--co-line); transition: background 200ms ease; }
  @media (min-width: 1024px) { .cr-roles li { grid-template-columns: 1.5fr 1fr; gap: 32px; align-items: center; } }
  .cr-roles li:hover { background: var(--co-white); }
  .cr-role__main h3 { color: var(--co-ink); margin: 0 0 8px; }
  .cr-role__main p { font-family: var(--co-sans); font-size: 14px; color: var(--co-mute); margin: 0; line-height: 1.6; max-width: 70ch; }
  .cr-role__meta { display: grid; grid-template-columns: 1fr 1fr auto; gap: 16px; align-items: center; }
  .cr-role__meta > span { display: flex; flex-direction: column; gap: 4px; font-family: var(--co-sans); font-size: 14px; font-weight: 600; color: var(--co-ink); }
  .cr-role__meta > span .co-eyebrow { color: var(--co-mute); margin-bottom: 2px; }

  .cr-benefits { display: grid; grid-template-columns: 1fr; gap: 24px; }
  @media (min-width: 880px) { .cr-benefits { grid-template-columns: repeat(4, 1fr); } }
  .cr-benefit { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.12); padding: 22px; display: flex; flex-direction: column; gap: 8px; }
  .cr-benefit .co-num { font-size: 22px; color: var(--co-amber); line-height: 1; }
  .cr-benefit h3 { color: var(--co-white); margin: 0; font-size: 17px; }
  .cr-benefit p { font-family: var(--co-sans); font-size: 13px; color: rgba(255,255,255,0.7); margin: 0; line-height: 1.55; }

  .cr-cta { display: flex; flex-direction: column; gap: 18px; align-items: flex-start; max-width: 60ch; }
  .cr-cta h2 { color: var(--co-ink); }
  .cr-cta p { font-family: var(--co-sans); font-size: 17px; color: var(--co-mute); margin: 0; line-height: 1.65; }
</style>
