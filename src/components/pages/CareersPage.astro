---

<SiteHeader locale={locale} currentPath={currentPath} />

<Breadcrumb locale={locale} items={[{ name: tr.nav.careers }]} />

<main id="main" class="bg-surface">
  {/* ========== 1. HERO ========== */}
  <section class="px-4 pb-16 pt-10 md:px-8 md:pb-24 md:pt-16">
    <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-12 md:grid-cols-[7fr_5fr]">
      <div>
        <span class="eyebrow mb-6 block text-orange-dark">{copy.eyebrow}</span>
        <h1 class="serif-display mb-8 text-5xl font-bold leading-[0.95] tracking-tight text-on-surface md:text-6xl lg:text-7xl">
          {copy.heroTitle1}
          <br />
          <span class="italic text-teal-dark">{copy.heroTitleItalic}</span>
          {' '}{copy.heroTitle2}
        </h1>
        <p class="mb-10 max-w-2xl text-lg leading-relaxed text-on-surface-muted md:text-xl">
          {copy.heroLead}
        </p>
        <div class="flex flex-wrap items-center gap-6">
          <a
            href="#open-roles"
            class="cta-gradient shadow-editorial inline-flex items-center rounded-md px-7 py-4 text-xs font-bold uppercase tracking-widest text-white"
          >
            {copy.viewOpenings}
          </a>
          <a
            href="#culture"
            class="eyebrow inline-flex items-center gap-3 text-on-surface transition-colors hover:text-teal-dark"
          >
            <span>{copy.philosophy}</span>
            <span aria-hidden="true" class="h-px w-8 bg-orange"></span>
          </a>
        </div>
      </div>

      <div class="relative">
        <div class="shadow-editorial aspect-[4/5] w-full overflow-hidden rounded-lg">
          <img
            src={heroImg}
            alt=""
            width="800"
            height="1000"
            class="h-full w-full object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>

        {/* editorial overlap chip */}
        <div aria-hidden="true" class="absolute -bottom-8 -start-10 -z-10 hidden h-64 w-52 rounded-lg bg-surface-low lg:block"></div>

        {/* global footprint card */}
        <div class="shadow-editorial absolute end-[-1rem] top-1/2 hidden w-[200px] -translate-y-1/2 rounded-lg bg-surface-lowest/90 p-5 backdrop-blur lg:block">
          <p class="eyebrow mb-2 text-orange-dark">{copy.footprintLabel}</p>
          <p class="serif-display text-2xl font-bold text-on-surface">{copy.footprintValue}</p>
          <div class="mt-4 h-1 w-full overflow-hidden rounded-full bg-surface-mid">
            <div class="h-full w-3/4 bg-teal"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ========== 2. CULTURE DNA ========== */}
  <section id="culture" class="bg-surface-low px-4 py-24 md:px-8 md:py-28">
    <div class="mx-auto max-w-7xl">
      <div class="mb-16 grid grid-cols-1 items-end gap-10 md:grid-cols-[7fr_5fr] md:gap-16">
        <div>
          <span class="eyebrow mb-4 block text-orange-dark">{copy.cultureEyebrow}</span>
          <h2 class="serif-display text-4xl font-bold leading-tight text-on-surface md:text-5xl">
            {copy.cultureTitle1}
            <br />
            {copy.cultureTitle2}
          </h2>
        </div>
        <blockquote class="border-s-2 border-teal-dark ps-6 italic leading-relaxed text-on-surface-muted">
          {copy.cultureQuote}
        </blockquote>
      </div>

      <div class="grid grid-cols-1 gap-1 bg-outline/10 p-1 md:grid-cols-3">
        {copy.values.map((v) => (
          <article class="group bg-surface p-10 transition-colors hover:bg-surface-lowest md:p-12">
            <svg class="mb-8 h-10 w-10 text-teal-dark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2l8 4v6c0 5-3.4 9.3-8 10-4.6-.7-8-5-8-10V6l8-4z"></path>
            </svg>
            <h3 class="serif-display mb-4 text-2xl font-bold text-on-surface">{v.t}</h3>
            <p class="mb-6 leading-relaxed text-on-surface-muted">{v.d}</p>
            <span class="eyebrow text-teal-dark opacity-0 transition-opacity group-hover:opacity-100">
              {v.hint}
            </span>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ========== 3. LIFE AT KISMET — bento grid ========== */}
  <section class="px-4 py-24 md:px-8 md:py-28">
    <div class="mx-auto max-w-7xl">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {/* Main visual — spans 2 columns, 2 rows */}
        <div class="group relative overflow-hidden rounded-lg md:col-span-2 md:row-span-2 md:min-h-[520px]">
          <img
            src={lifeMainImg}
            alt=""
            width="1200"
            height="900"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-on-surface/70 to-transparent"></div>
          <div class="absolute bottom-10 start-10 text-white">
            <p class="eyebrow mb-2 opacity-80">{copy.lifeEyebrow}</p>
            <h3 class="serif-display text-4xl font-bold md:text-5xl">{copy.lifeTitle}</h3>
          </div>
        </div>

        {/* Benefit A */}
        <article class="flex flex-col justify-between gap-8 rounded-lg bg-orange/15 p-8 md:p-10">
          <svg class="h-9 w-9 text-orange-dark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2a10 10 0 100 20 10 10 0 000-20zm0 3a2 2 0 110 4 2 2 0 010-4zm5 13H7v-1c0-2 3.3-3 5-3s5 1 5 3v1z"></path>
          </svg>
          <div>
            <h4 class="serif-display mb-2 text-xl font-bold text-on-surface">{copy.benefitA.t}</h4>
            <p class="text-sm leading-relaxed text-on-surface-muted">{copy.benefitA.d}</p>
          </div>
        </article>

        {/* Benefit B */}
        <article class="flex flex-col justify-between gap-8 rounded-lg bg-teal/15 p-8 md:p-10">
          <svg class="h-9 w-9 text-teal-dark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2l2.4 4.9 5.4.8-3.9 3.8.9 5.4L12 14.3l-4.8 2.6.9-5.4L4.2 7.7l5.4-.8L12 2z"></path>
          </svg>
          <div>
            <h4 class="serif-display mb-2 text-xl font-bold text-on-surface">{copy.benefitB.t}</h4>
            <p class="text-sm leading-relaxed text-on-surface-muted">{copy.benefitB.d}</p>
          </div>
        </article>

        {/* Small portrait */}
        <div class="overflow-hidden rounded-lg">
          <img
            src={teamPortraitImg}
            alt=""
            width="600"
            height="600"
            loading="lazy"
            decoding="async"
            class="h-full min-h-[240px] w-full object-cover"
          />
        </div>

        {/* Testimonial */}
        <article class="flex flex-col justify-center rounded-lg border border-outline/10 bg-surface-low p-8 md:p-10">
          <p class="mb-6 text-lg italic leading-relaxed text-on-surface-muted">{copy.testimonial.q}</p>
          <div>
            <p class="font-bold text-on-surface">{copy.testimonial.name}</p>
            <p class="eyebrow text-teal-dark">{copy.testimonial.role}</p>
          </div>
        </article>

        {/* Lab QC (4th Stitch image) */}
        <div class="relative overflow-hidden rounded-lg">
          <img
            src={labImg}
            alt=""
            width="600"
            height="600"
            loading="lazy"
            decoding="async"
            class="h-full min-h-[240px] w-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-on-surface/60 to-transparent"></div>
          <p class="eyebrow absolute bottom-6 start-6 text-white">{copy.labCaption}</p>
        </div>
      </div>
    </div>
  </section>

  {/* ========== 4. OPEN POSITIONS ========== */}
  <section id="open-roles" class="bg-surface-lowest px-4 py-24 md:px-8 md:py-28">
    <div class="mx-auto max-w-7xl">
      <div class="mb-20 text-center">
        <span class="eyebrow mb-4 block text-orange-dark">{copy.rolesEyebrow}</span>
        <h2 class="serif-display mb-6 text-4xl font-bold text-on-surface md:text-5xl">
          {copy.rolesTitle}
        </h2>
        <div class="mx-auto mb-6 h-1 w-24 bg-teal"></div>
        <p class="mx-auto max-w-2xl text-on-surface-muted">{copy.rolesLead}</p>
      </div>

      <ul class="space-y-2">
        {copy.roles.map((role) => (
          <li class="group grid grid-cols-1 gap-6 border-b border-outline/30 py-8 transition-all duration-300 md:grid-cols-[7fr_5fr] md:items-center md:gap-10 md:py-10 hover:md:px-6">
            <div class="flex items-start gap-6">
              <span aria-hidden="true" class="serif-display w-10 text-2xl italic text-teal-dark md:text-3xl">
                {role.num}
              </span>
              <div>
                <h3 class="serif-display text-2xl font-bold text-on-surface">{role.t}</h3>
                <p class="mt-2 text-sm leading-relaxed text-on-surface-muted">{role.desc}</p>
                <p class="mt-3 text-xs text-on-surface-subtle">{role.loc}</p>
              </div>
            </div>
            <div class="flex flex-wrap items-center gap-4 md:justify-end">
              <span class="eyebrow rounded-full bg-surface px-3 py-1 text-[10px] text-on-surface-muted">
                {role.tag}
              </span>
              <a
                href={`${careersMail}?subject=${encodeURIComponent('Application: ' + role.t)}`}
                class="rounded-md bg-on-surface px-6 py-3 text-xs font-bold uppercase tracking-widest text-white transition-colors hover:bg-teal-dark"
                aria-label={`${copy.applyCta} — ${role.t}`}
              >
                {copy.applyCta}
              </a>
            </div>
          </li>
        ))}
      </ul>

      <div class="mt-20 text-center">
        <p class="mb-4 text-on-surface-muted">{copy.spontaneousLead}</p>
        <a
          href={`${careersMail}?subject=${encodeURIComponent('Spontaneous Application')}`}
          class="eyebrow inline-block border-b-2 border-orange pb-1 text-on-surface transition-colors hover:text-orange-dark"
        >
          {copy.spontaneousCta}
        </a>
      </div>
    </div>
  </section>

  {/* ========== 5. FINAL CTA ========== */}
  <section class="cta-gradient px-4 py-24 text-white md:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <h2 class="serif-display mb-4 text-4xl font-bold md:text-5xl">{copy.ctaTitle}</h2>
      <p class="mb-8 text-lg leading-relaxed text-white/85">{copy.ctaLead}</p>
      <a
        href={careersMail}
        class="inline-block rounded-md bg-orange px-8 py-4 text-xs font-bold uppercase tracking-widest text-white shadow-lg shadow-orange/20 transition-colors hover:bg-orange-dark"
      >
        {copy.ctaBtn}
      </a>
    </div>
  </section>
</main>

<SiteFooter locale={locale} />
