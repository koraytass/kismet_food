---
import type { Locale } from '@/i18n';
import { localePath } from '@/i18n';
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
import CorpPageHero from '../v3/CorpPageHero.astro';
import CorpSection from '../v3/CorpSection.astro';

interface Props { locale: Locale; currentPath: string }
const { locale, currentPath } = Astro.props;

const copy = {
  tr: {
    eyebrow: 'TİCARİ MASA · 24 SAAT İÇİNDE DÖNÜŞ',
    heroTitle: 'Tedarik talebinizi 24 saat içinde değerlendiriyoruz.',
    heroLead: 'Bir konteyner ya da yıllık formula sözleşme — ticari masamız brief\'i alır, numune ve fiyat doğrulamasını paralel başlatır. KVKK ve GDPR uyumlu.',
    deskEyebrow: 'MASA', deskTitle: 'Doğrudan iletişim,', deskItalic: 'kategori bazlı.',
    deskLead: 'Her ürün hattı için ayrı portföy yöneticisi. Brief\'i doğru masaya gönderirseniz dönüş 24 saatten kısalır.',
    desks: [
      { h: 'Genel Ticaret', e: 'commercial@kismetfoods.com', d: 'Birden fazla hat, ilk görüşme, çok kategori talepleri.' },
      { h: 'Kahve & Kakao', e: 'coffee@kismetfoods.com', d: 'Specialty kahve, robusta, kakao mass ve fine flavour.' },
      { h: 'Kuruyemiş', e: 'nuts@kismetfoods.com', d: 'Antep fıstığı, fındık, kayısı, incir, kaju.' },
      { h: 'Baharat', e: 'spices@kismetfoods.com', d: 'Karabiber, tarçın, isot, pul biber, vanilya.' },
      { h: 'Endüstriyel', e: 'ingredients@kismetfoods.com', d: 'Tahıl, bakliyat, yağlı tohum, yağ, şeker.' },
      { h: 'Basın', e: 'press@kismetfoods.com', d: 'Medya talepleri, basın bültenleri, röportaj.' },
    ],
    formEyebrow: 'KISA FORM', formTitle: 'Hızlı', formItalic: 'iletişim formu.',
    formLead: 'Ürün, hacim ve teslim şekli paylaşıldığında ticari masamız 24 saat içinde özel teklif hazırlar.',
    fName: 'Ad Soyad *', fEmail: 'Şirket E-posta *', fCompany: 'Şirket', fSubject: 'Konu', fMessage: 'Mesajınız *', fSubmit: 'Gönder',
    fNameP: 'Ad Soyad', fEmailP: 'isim@sirket.com', fCompanyP: 'Şirket adı', fSubjectP: 'Brief başlığı',
    fMessageP: 'Ürün, menşe tercihi, hacim, teslim şekli ve zaman çerçevesi.',
    fConsent: 'KVKK Aydınlatma Metni\'ni okudum, kişisel verilerimin teklif değerlendirmesi için işlenmesine açık rıza veriyorum.',
    locEyebrow: 'KONUM', locTitle: 'İstanbul,', locItalic: 'Caddebostan.',
    locAddr: 'Caddebostan Mah. Dr. Abdülkadir Noyan Sk.',
    locAddr2: 'No: 12/9, 34728 Kadıköy / İstanbul',
    locHours: 'Pazartesi-Cuma: 09:00-18:00 (UTC+3)',
    locPhone: '+90 (216) 555 0198',
  },
  en: {
    eyebrow: 'COMMERCIAL DESK · 24-HOUR RESPONSE',
    heroTitle: 'We respond to sourcing inquiries within 24 hours.',
    heroLead: 'A single container or an annual formula contract — our trade desk takes the brief and runs sample + price verification in parallel. KVKK + GDPR compliant.',
    deskEyebrow: 'DESKS', deskTitle: 'Direct contact,', deskItalic: 'by category.',
    deskLead: 'Dedicated portfolio manager per product line. Send the brief to the right desk and the response shrinks below 24 hours.',
    desks: [
      { h: 'General Trade', e: 'commercial@kismetfoods.com', d: 'Multi-line, first conversation, multi-category requests.' },
      { h: 'Coffee & Cocoa', e: 'coffee@kismetfoods.com', d: 'Specialty coffee, robusta, mass cocoa and fine flavour.' },
      { h: 'Nuts', e: 'nuts@kismetfoods.com', d: 'Antep pistachio, hazelnut, apricot, fig, cashew.' },
      { h: 'Spices', e: 'spices@kismetfoods.com', d: 'Pepper, cinnamon, isot, chilli flakes, vanilla.' },
      { h: 'Industrial', e: 'ingredients@kismetfoods.com', d: 'Grain, pulses, oilseed, oil, sugar.' },
      { h: 'Press', e: 'press@kismetfoods.com', d: 'Media inquiries, press releases, interviews.' },
    ],
    formEyebrow: 'SHORT FORM', formTitle: 'Quick', formItalic: 'contact form.',
    formLead: 'Product, volume and delivery — share these and our desk returns a tailored proposal within 24 hours.',
    fName: 'Full Name *', fEmail: 'Company Email *', fCompany: 'Company', fSubject: 'Subject', fMessage: 'Message *', fSubmit: 'Send',
    fNameP: 'Full name', fEmailP: 'name@company.com', fCompanyP: 'Company name', fSubjectP: 'Brief title',
    fMessageP: 'Product, origin preference, volume, delivery term and timeframe.',
    fConsent: 'I have read the GDPR notice and consent to my data being processed for quote evaluation.',
    locEyebrow: 'LOCATION', locTitle: 'Istanbul,', locItalic: 'Caddebostan.',
    locAddr: 'Caddebostan Mah. Dr. Abdülkadir Noyan Sk.',
    locAddr2: 'No: 12/9, 34728 Kadıköy / Istanbul',
    locHours: 'Mon-Fri: 09:00-18:00 (UTC+3)',
    locPhone: '+90 (216) 555 0198',
  },
  ar: {
    eyebrow: 'مكتب تجاري · رد خلال ٢٤ ساعة',
    heroTitle: 'نرد على طلبات التوريد خلال ٢٤ ساعة.',
    heroLead: 'حاوية أو عقد سنوي — يستلم مكتبنا الموجز ويبدأ تحقق العينة والسعر بالتوازي.',
    deskEyebrow: 'المكاتب', deskTitle: 'تواصل مباشر،', deskItalic: 'حسب الفئة.',
    deskLead: 'مدير محفظة مخصص لكل خط.',
    desks: [
      { h: 'تجارة عامة', e: 'commercial@kismetfoods.com', d: 'متعدد الخطوط والفئات.' },
      { h: 'قهوة وكاكاو', e: 'coffee@kismetfoods.com', d: 'مختصة وروبوستا وكاكاو.' },
      { h: 'مكسرات', e: 'nuts@kismetfoods.com', d: 'فستق وبندق ومشمش وتين وكاجو.' },
      { h: 'توابل', e: 'spices@kismetfoods.com', d: 'فلفل وقرفة وإيسوت ورقائق ووانيليا.' },
      { h: 'صناعي', e: 'ingredients@kismetfoods.com', d: 'حبوب وبقول وزيوت وسكر.' },
      { h: 'صحافة', e: 'press@kismetfoods.com', d: 'استفسارات إعلامية ومقابلات.' },
    ],
    formEyebrow: 'نموذج قصير', formTitle: 'نموذج', formItalic: 'تواصل سريع.',
    formLead: 'شارك المنتج والحجم والتسليم — يرد المكتب خلال ٢٤ ساعة.',
    fName: 'الاسم الكامل *', fEmail: 'بريد الشركة *', fCompany: 'الشركة', fSubject: 'الموضوع', fMessage: 'رسالتك *', fSubmit: 'إرسال',
    fNameP: 'الاسم الكامل', fEmailP: 'name@company.com', fCompanyP: 'اسم الشركة', fSubjectP: 'عنوان الموجز',
    fMessageP: 'المنتج، تفضيل المنشأ، الحجم، شروط التسليم.',
    fConsent: 'قرأت إخطار GDPR وأوافق على معالجة بياناتي لتقييم العرض.',
    locEyebrow: 'الموقع', locTitle: 'إسطنبول،', locItalic: 'كاديكوي.',
    locAddr: 'حي جدّه بوستان شارع د. عبد القادر نويان',
    locAddr2: 'رقم ١٢/٩، ٣٤٧٢٨ كاديكوي / إسطنبول',
    locHours: 'الإثنين-الجمعة: ٠٩:٠٠-١٨:٠٠ (UTC+3)',
    locPhone: '+90 (216) 555 0198',
  },
}[locale];

const heroBg = 'https://images.unsplash.com/photo-1551434678-e076c223a692?auto=format&fit=crop&w=2400&q=80';
---

<SiteHeader locale={locale} currentPath={currentPath} />

<main id="main">
  <CorpPageHero
    locale={locale}
    eyebrow={copy.eyebrow}
    title={copy.heroTitle}
    lede={copy.heroLead}
    background={heroBg}
    meta={[
      { label: 'Response', value: '< 24 h' },
      { label: 'Languages', value: 'TR · EN · AR' },
      { label: 'Office', value: 'Istanbul' },
      { label: 'Compliance', value: 'KVKK · GDPR' },
    ]}
  />

  <CorpSection variant="white" eyebrow={copy.deskEyebrow} title={copy.deskTitle} italic={copy.deskItalic} lede={copy.deskLead}>
    <div class="ct-desks">
      {copy.desks.map((d) => (
        <a class="ct-desk" href={`mailto:${d.e}`}>
          <span class="co-eyebrow co-eyebrow--ink">{d.h}</span>
          <span class="ct-desk__email">{d.e}</span>
          <p>{d.d}</p>
        </a>
      ))}
    </div>
  </CorpSection>

  <CorpSection variant="snow" eyebrow={copy.formEyebrow} title={copy.formTitle} italic={copy.formItalic} lede={copy.formLead}>
    <div class="ct-form-wrap">
      <form id="ctForm" class="co-form ct-form" method="post" action="#">
        <div class="ct-form__row">
          <div class="co-form__field"><label for="ct-name">{copy.fName}</label><input id="ct-name" name="name" type="text" placeholder={copy.fNameP} required /></div>
          <div class="co-form__field"><label for="ct-email">{copy.fEmail}</label><input id="ct-email" name="email" type="email" placeholder={copy.fEmailP} required /></div>
        </div>
        <div class="ct-form__row">
          <div class="co-form__field"><label for="ct-company">{copy.fCompany}</label><input id="ct-company" name="company" type="text" placeholder={copy.fCompanyP} /></div>
          <div class="co-form__field"><label for="ct-subject">{copy.fSubject}</label><input id="ct-subject" name="subject" type="text" placeholder={copy.fSubjectP} /></div>
        </div>
        <div class="co-form__field"><label for="ct-message">{copy.fMessage}</label><textarea id="ct-message" name="message" rows="5" placeholder={copy.fMessageP} required></textarea></div>
        <label class="ct-form__consent"><input type="checkbox" name="consent" required /><span>{copy.fConsent} <a href={localePath('/privacy/', locale)}>KVKK</a></span></label>
        <button type="submit" class="co-btn co-btn--primary">{copy.fSubmit} <span aria-hidden="true">→</span></button>
      </form>

      <aside class="ct-loc">
        <span class="co-eyebrow">{copy.locEyebrow}</span>
        <h3 class="co-h3">{copy.locTitle} <em>{copy.locItalic}</em></h3>
        <address>
          {copy.locAddr}<br />
          {copy.locAddr2}
        </address>
        <dl>
          <div><dt>Saat</dt><dd>{copy.locHours}</dd></div>
          <div><dt>Telefon</dt><dd><a href={`tel:${copy.locPhone.replace(/\s|\(|\)/g, '')}`}>{copy.locPhone}</a></dd></div>
        </dl>
      </aside>
    </div>
  </CorpSection>
</main>

<SiteFooter locale={locale} />

<script is:inline>
  (function () {
    const f = document.getElementById('ctForm');
    if (!f) return;
    f.addEventListener('submit', function (e) {
      e.preventDefault();
      f.innerHTML = '<p style="font-family:var(--co-sans);font-size:18px;color:var(--co-navy);">Mesajınız alındı. 24 saat içinde dönüş yapacağız. · Message received. We will respond within 24 hours.</p>';
    });
  })();
</script>

<style>
  .ct-desks { display: grid; grid-template-columns: 1fr; gap: 16px; }
  @media (min-width: 720px) { .ct-desks { grid-template-columns: repeat(2, 1fr); gap: 20px; } }
  @media (min-width: 1080px) { .ct-desks { grid-template-columns: repeat(3, 1fr); } }
  .ct-desk { display: flex; flex-direction: column; gap: 8px; padding: 22px; background: var(--co-snow); border: 1px solid var(--co-line); text-decoration: none; color: var(--co-text); transition: border-color 220ms ease, background 220ms ease; }
  .ct-desk:hover { border-color: var(--co-navy); background: var(--co-white); }
  .ct-desk__email { font-family: var(--co-sans); font-size: 17px; font-weight: 600; color: var(--co-navy); margin-block: 2px; }
  .ct-desk p { font-family: var(--co-sans); font-size: 13px; color: var(--co-mute); margin: 0; line-height: 1.55; }

  .ct-form-wrap { display: grid; grid-template-columns: 1fr; gap: 40px; }
  @media (min-width: 1024px) { .ct-form-wrap { grid-template-columns: 1.5fr 1fr; gap: 56px; } }
  .ct-form { background: var(--co-white); border: 1px solid var(--co-line); padding: 32px; }
  .ct-form__row { display: grid; grid-template-columns: 1fr; gap: 16px; }
  @media (min-width: 600px) { .ct-form__row { grid-template-columns: 1fr 1fr; gap: 20px; } }
  .ct-form__consent { display: flex; align-items: flex-start; gap: 10px; margin-top: 8px; }
  .ct-form__consent input { margin-top: 4px; }
  .ct-form__consent span { font-family: var(--co-sans); font-size: 13px; color: var(--co-mute); line-height: 1.55; }
  .ct-form__consent a { color: var(--co-navy); text-decoration: underline; text-underline-offset: 3px; }

  .ct-loc { display: flex; flex-direction: column; gap: 14px; padding: 32px; background: var(--co-navy); color: var(--co-white); }
  .ct-loc .co-eyebrow { color: var(--co-amber); }
  .ct-loc h3 { color: var(--co-white); margin: 0; }
  .ct-loc h3 em { font-family: var(--co-serif); font-style: italic; color: var(--co-amber); font-weight: 400; }
  .ct-loc address { font-style: normal; font-family: var(--co-sans); font-size: 15px; line-height: 1.6; color: rgba(255,255,255,0.85); margin: 0; }
  .ct-loc dl { margin: 0; display: flex; flex-direction: column; gap: 12px; }
  .ct-loc dl > div { display: flex; flex-direction: column; gap: 4px; }
  .ct-loc dt { font-family: var(--co-sans); font-size: 11px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--co-amber); }
  .ct-loc dd { margin: 0; font-family: var(--co-sans); font-size: 14px; color: var(--co-white); }
  .ct-loc dd a { color: var(--co-white); text-decoration: none; border-bottom: 1px solid var(--co-amber); }
</style>
