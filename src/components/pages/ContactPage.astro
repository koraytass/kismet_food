---

<SiteHeader locale={locale} currentPath={currentPath} />

<Breadcrumb locale={locale} items={[{ name: tr.nav.contact }]} />

<main id="main" class="bg-surface">
  {/* ========== 1. HERO — Let's connect across coordinates ========== */}
  <section class="relative overflow-hidden px-4 py-16 md:px-8 md:py-24 lg:py-28">
    {/* Side image (desktop: right half, mobile: full behind with opacity) */}
    <div class="absolute inset-y-0 end-0 z-0 w-full md:w-1/2">
      <img
        src={heroMapImg}
        alt=""
        class="h-full w-full object-cover opacity-30 md:opacity-100"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width="1200"
        height="1500"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-surface via-surface/40 to-transparent md:from-surface md:via-surface/20"></div>
    </div>

    <div class="relative z-10 mx-auto max-w-7xl">
      <div class="max-w-3xl">
        <span class="eyebrow mb-6 block text-orange-dark">{copy.eyebrow}</span>
        <h1 class="serif-display mb-10 text-5xl font-bold leading-[0.95] tracking-tight text-on-surface md:text-7xl lg:text-8xl">
          {copy.heroTitle1}
          <br />
          {copy.heroTitle2}
          <br />
          <span class="ms-8 italic text-teal-dark md:ms-16">{copy.heroTitleItalic}</span>
        </h1>
        <div class="shadow-editorial ms-0 max-w-xl border-s-4 border-teal-dark bg-surface/95 p-8 backdrop-blur-sm md:p-10">
          <p class="text-lg font-light leading-relaxed text-on-surface-muted">
            {copy.heroLead}
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ========== 2. STRATEGIC ANCHORS — Global offices bento ========== */}
  <section class="bg-surface-low px-4 py-20 md:px-8 md:py-28">
    <div class="mx-auto max-w-7xl">
      <div class="mb-12 grid grid-cols-1 items-end gap-8 md:mb-16 md:grid-cols-[5fr_7fr] md:gap-16">
        <div>
          <span class="eyebrow mb-3 block text-orange-dark">{copy.anchorsEyebrow}</span>
          <h2 class="serif-display text-4xl font-bold text-on-surface md:text-5xl">
            {copy.anchorsTitle}
          </h2>
        </div>
        <p class="text-lg leading-relaxed text-on-surface-muted">{copy.anchorsLead}</p>
      </div>

      {/* Bento grid: 2 rows of md:grid-cols-[7fr_5fr]
          Row 1: Istanbul HQ (left 7) · Abidjan (right 5)
          Row 2: Rotterdam (left 5) · World map (right 7) — visually swapped */}
      <div class="grid grid-cols-1 gap-6 md:grid-cols-[7fr_5fr]">
        {/* Istanbul HQ — large, light, with satellite map overlay */}
        <article class="group relative flex min-h-[340px] flex-col justify-between overflow-hidden bg-surface-lowest p-8 shadow-editorial md:min-h-[380px] md:p-10">
          <div class="relative z-10">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <h3 class="serif-display mb-2 text-2xl font-bold text-on-surface md:text-3xl">
                  {copy.istanbulTitle}
                </h3>
                <address class="not-italic text-sm font-medium leading-relaxed text-on-surface-muted md:max-w-sm">
                  {brand.address.street}<br />
                  {brand.address.postalCode} {brand.address.district}<br />
                  {brand.address.city} / {brand.address.countryName}
                </address>
              </div>
              <span class="eyebrow whitespace-nowrap rounded-full bg-teal-dark px-3 py-1 text-[10px] text-white">
                {copy.istanbulBadge}
              </span>
            </div>
          </div>
          <div class="relative z-10 mt-8">
            <p class="text-xs text-on-surface-subtle">
              <span class="eyebrow text-on-surface-subtle">{copy.legalLabel}:</span>{' '}
              {brand.legalName}
            </p>
            <a
              href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
                brand.address.street + ', ' + brand.address.city,
              )}`}
              target="_blank"
              rel="noopener noreferrer"
              class="eyebrow mt-6 inline-flex items-center text-orange-dark underline-offset-8 hover:underline"
            >
              {copy.istanbulMapLabel}
              <svg class="ms-2 h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M7 17L17 7M17 7H9M17 7V15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
              </svg>
            </a>
          </div>
          {/* Decorative satellite map vignette */}
          <div class="pointer-events-none absolute -end-[10%] -bottom-[10%] opacity-10 transition-opacity duration-500 group-hover:opacity-20">
            <img
              src={istanbulSatelliteImg}
              alt=""
              class="h-72 w-72 rounded-full object-cover md:h-96 md:w-96"
              loading="lazy"
              decoding="async"
              width="400"
              height="400"
            />
          </div>
        </article>

        {/* Abidjan — origin hub with skyline overlay */}
        <article class="group relative flex min-h-[340px] flex-col justify-between overflow-hidden bg-surface-mid p-8 shadow-editorial md:min-h-[380px] md:p-10">
          <div class="relative z-10">
            <h3 class="serif-display mb-2 text-2xl font-bold text-on-surface">
              {copy.abidjanTitle}
            </h3>
            <address class="not-italic text-sm font-medium leading-relaxed text-on-surface-muted">
              {copy.abidjanAddress}
            </address>
          </div>
          <div class="relative z-10">
            <p class="eyebrow mt-3 text-orange-dark">{copy.abidjanTag}</p>
          </div>
          {/* Skyline background layer */}
          <div class="pointer-events-none absolute inset-0 z-0 opacity-30 mix-blend-overlay">
            <img
              src={abidjanSkylineImg}
              alt=""
              class="h-full w-full object-cover grayscale"
              loading="lazy"
              decoding="async"
              width="900"
              height="900"
            />
          </div>
        </article>

        {/* Rotterdam — dark logistics tile */}
        <article class="relative flex min-h-[280px] flex-col justify-between bg-surface-deep p-8 text-white shadow-editorial md:min-h-[320px] md:p-10">
          <div>
            <h3 class="serif-display mb-2 text-2xl font-bold">{copy.rotterdamTitle}</h3>
            <address class="not-italic text-sm font-medium leading-relaxed text-white/60">
              {copy.rotterdamAddress}
            </address>
          </div>
          <div>
            <p class="mt-3 text-xs text-white/40">{copy.rotterdamTag}</p>
          </div>
        </article>

        {/* World map — our network tile */}
        <article class="relative min-h-[280px] overflow-hidden bg-surface-lowest shadow-editorial md:min-h-[320px]">
          <img
            src={worldMapImg}
            alt=""
            class="absolute inset-0 h-full w-full object-cover opacity-60 grayscale"
            loading="lazy"
            decoding="async"
            width="1200"
            height="800"
          />
          <div class="absolute inset-0 bg-teal/5"></div>
          {/* Pulsing dot */}
          <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
            <span aria-hidden="true" class="absolute inline-flex h-4 w-4 animate-ping rounded-full bg-teal opacity-75"></span>
            <span aria-hidden="true" class="relative inline-flex h-4 w-4 rounded-full bg-teal-dark"></span>
          </div>
          <div class="relative z-10 flex h-full flex-col justify-end p-8 md:p-10">
            <span class="eyebrow mb-2 block text-orange-dark">{copy.worldMapEyebrow}</span>
            <h3 class="serif-display mb-2 text-xl font-bold text-on-surface md:text-2xl">
              {copy.worldMapTitle}
            </h3>
            <p class="max-w-xs text-sm text-on-surface-muted">{copy.worldMapLead}</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  {/* ========== 3. REQUEST A CUSTOM QUOTE — intro + form ========== */}
  <section class="px-4 py-20 md:px-8 md:py-28">
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-12 md:grid-cols-[1fr_2fr] md:gap-20">
      {/* Sticky left intro */}
      <div>
        <div class="md:sticky md:top-28">
          <span class="eyebrow mb-4 block text-orange-dark">{copy.formEyebrow}</span>
          <h2 class="serif-display mb-8 text-4xl font-bold leading-tight text-on-surface md:text-5xl">
            {copy.formTitle1}<br />{copy.formTitle2}
          </h2>
          <p class="mb-10 leading-relaxed text-on-surface-muted">{copy.formLead}</p>
          <ul class="space-y-6">
            <li class="flex items-start gap-4">
              <span aria-hidden="true" class="mt-1 inline-flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-teal-dark text-white">
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
                  <path d="M5 12l5 5L20 7" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
              <div>
                <h3 class="mb-1 text-sm font-bold text-on-surface">{copy.feature1Title}</h3>
                <p class="text-sm text-on-surface-muted">{copy.feature1Body}</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <span aria-hidden="true" class="mt-1 inline-flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-orange text-white">
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M13 2L4.5 13h5L11 22l8.5-11h-5L13 2z"></path>
                </svg>
              </span>
              <div>
                <h3 class="mb-1 text-sm font-bold text-on-surface">{copy.feature2Title}</h3>
                <p class="text-sm text-on-surface-muted">{copy.feature2Body}</p>
              </div>
            </li>
          </ul>
        </div>
      </div>

      {/* Form column */}
      <div>
        <form
          action="#"
          method="post"
          aria-label={`${copy.formTitle1} ${copy.formTitle2}`}
          class="space-y-12 bg-surface-low p-6 shadow-editorial md:p-12"
        >
          {/* Step 1 — Entity */}
          <fieldset class="border-0 p-0">
            <legend class="serif-display mb-8 flex w-full items-center border-b border-outline/30 pb-4 text-2xl font-bold text-on-surface">
              <span aria-hidden="true" class="me-4 inline-flex h-8 w-8 items-center justify-center rounded-full bg-teal-dark text-sm font-bold text-white">
                1
              </span>
              {copy.step1}
            </legend>
            <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
              <div class="space-y-2">
                <label for="name" class="eyebrow block text-on-surface-subtle">
                  {copy.fieldName} <span aria-hidden="true" class="text-red">*</span>
                </label>
                <input
                  id="name"
                  name="name"
                  type="text"
                  required
                  autocomplete="name"
                  placeholder={copy.fieldNamePh}
                  class="w-full border-x-0 border-b-2 border-t-0 border-outline bg-transparent px-0 py-2 font-medium text-on-surface placeholder:text-on-surface-subtle focus:border-teal-dark focus:ring-0"
                />
              </div>
              <div class="space-y-2">
                <label for="email" class="eyebrow block text-on-surface-subtle">
                  {copy.fieldEmail} <span aria-hidden="true" class="text-red">*</span>
                </label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  placeholder={copy.fieldEmailPh}
                  class="w-full border-x-0 border-b-2 border-t-0 border-outline bg-transparent px-0 py-2 font-medium text-on-surface placeholder:text-on-surface-subtle focus:border-teal-dark focus:ring-0"
                />
              </div>
            </div>
          </fieldset>

          {/* Step 2 — Product */}
          <fieldset class="border-0 p-0">
            <legend class="serif-display mb-8 flex w-full items-center border-b border-outline/30 pb-4 text-2xl font-bold text-on-surface">
              <span aria-hidden="true" class="me-4 inline-flex h-8 w-8 items-center justify-center rounded-full bg-teal-dark text-sm font-bold text-white">
                2
              </span>
              {copy.step2}
            </legend>
            <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
              <div class="space-y-2">
                <label for="commodity" class="eyebrow block text-on-surface-subtle">
                  {copy.fieldCommodity} <span aria-hidden="true" class="text-red">*</span>
                </label>
                <select
                  id="commodity"
                  name="commodity"
                  required
                  class="w-full border-x-0 border-b-2 border-t-0 border-outline bg-transparent px-0 py-2 font-medium text-on-surface focus:border-teal-dark focus:ring-0"
                >
                  <option value="">{copy.fieldCommodityDefault}</option>
                  <option value="coffee-cocoa">{copy.optCoffee}</option>
                  <option value="nuts">{copy.optNuts}</option>
                  <option value="spices">{copy.optSpices}</option>
                  <option value="ingredients">{copy.optIngredients}</option>
                </select>
              </div>
              <div class="space-y-2">
                <label for="quantity" class="eyebrow block text-on-surface-subtle">
                  {copy.fieldQuantity} <span aria-hidden="true" class="text-red">*</span>
                </label>
                <input
                  id="quantity"
                  name="quantity"
                  type="number"
                  min="1"
                  step="1"
                  required
                  inputmode="numeric"
                  placeholder={copy.fieldQuantityPh}
                  class="w-full border-x-0 border-b-2 border-t-0 border-outline bg-transparent px-0 py-2 font-medium text-on-surface placeholder:text-on-surface-subtle focus:border-teal-dark focus:ring-0"
                />
              </div>
              <div class="space-y-2 md:col-span-2">
                <label for="message" class="eyebrow block text-on-surface-subtle">
                  {copy.fieldMessage} <span aria-hidden="true" class="text-red">*</span>
                </label>
                <textarea
                  id="message"
                  name="message"
                  rows="5"
                  required
                  placeholder={copy.fieldMessagePh}
                  class="w-full rounded-md border border-outline/60 bg-surface-lowest px-4 py-3 font-medium text-on-surface placeholder:text-on-surface-subtle focus:border-teal-dark focus:ring-0"
                ></textarea>
              </div>
            </div>
          </fieldset>

          <div class="pt-2">
            <button
              type="submit"
              class="cta-gradient shadow-editorial flex w-full items-center justify-center gap-3 rounded-md px-8 py-4 text-xs font-bold uppercase tracking-widest text-white transition-transform active:scale-[0.98]"
            >
              {copy.submit}
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"></path>
              </svg>
            </button>
            <p class="mt-6 text-center text-[11px] text-on-surface-subtle">{copy.formNote}</p>
          </div>
        </form>
      </div>
    </div>
  </section>

  {/* ========== 4. VERIFIED CONTACT NOTE ========== */}
  <section class="bg-surface-mid px-4 py-20 md:px-8 md:py-24">
    <div class="mx-auto grid max-w-5xl grid-cols-1 gap-8 border-y border-outline/30 py-12 md:grid-cols-[4fr_8fr] md:items-center">
      <h2 class="serif-display text-3xl font-bold text-on-surface md:text-4xl">{copy.supportTitle}</h2>
      <p class="text-base leading-relaxed text-on-surface-muted md:text-lg">{copy.supportLead}</p>
    </div>
  </section>
</main>

<SiteFooter locale={locale} />
</content>
</invoke>
