---

<SiteHeader locale={locale} currentPath={currentPath} />

<Breadcrumb
  locale={locale}
  items={[{ name: tr.nav.heritage }]}
/>

<main id="main" class="bg-surface">
  {/* Hero — typography-first, small framed portrait, soft halo, no full-bleed */}
  <section class="hero relative overflow-hidden pt-10 pb-16 sm:pt-14 sm:pb-20 md:pt-20 md:pb-28 lg:pt-24 lg:pb-32">
    <div
      aria-hidden="true"
      class="hero-halo pointer-events-none absolute -top-24 left-1/2 h-[640px] w-[1200px] -translate-x-1/2 opacity-50"
    ></div>

    <div class="relative mx-auto grid max-w-7xl grid-cols-1 items-end gap-8 px-5 sm:gap-10 sm:px-6 md:px-8 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-7" data-reveal>
        <span class="eyebrow mb-5 block text-orange">{copy.eyebrow}</span>
        <h1 class="serif-display text-[2rem] font-semibold leading-[1.05] tracking-tight text-on-surface sm:text-[2.5rem] md:text-[3.4rem] lg:text-[4.2rem]">
          {copy.heroTitle}
        </h1>
        <p class="mt-6 max-w-[36rem] text-[15px] leading-[1.7] text-on-surface-muted md:text-lg">
          {copy.heroLead}
        </p>
      </div>

      <div class="lg:col-span-5" data-reveal>
        <figure class="photo-grade photo-grade--warm relative ms-auto overflow-hidden rounded-sm shadow-editorial">
          <img
            src={heroPortraitImg}
            alt=""
            width="800"
            height="1000"
            class="aspect-[4/5] w-full max-w-[14rem] object-cover sm:max-w-[20rem] md:max-w-[24rem] lg:max-w-none"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
        <div class="mt-5 flex items-baseline gap-3 lg:gap-4">
          <span class="serif-display text-3xl font-semibold text-teal md:text-4xl">{copy.statNumber}</span>
          <span class="text-xs leading-snug text-on-surface-subtle md:text-sm">{copy.statLabel}</span>
        </div>
      </div>
    </div>
  </section>

  <AmuletDivider compact />

  {/* Chapter One — sticky asymmetric editorial */}
  <section class="px-5 py-14 sm:px-6 sm:py-16 md:py-24">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-12 md:grid-cols-12 md:gap-10">
      <div class="md:col-span-5 md:sticky md:top-28 md:self-start" data-reveal>
        <span class="eyebrow mb-4 block text-orange">{copy.chapterOne}</span>
        <h2 class="serif-display mb-6 text-3xl font-semibold leading-snug text-on-surface md:text-4xl lg:text-[2.6rem]">
          {copy.chapterOneTitle}
        </h2>
        <div class="space-y-4 text-base leading-[1.7] text-on-surface-muted">
          <p>{copy.chapterOneP1}</p>
          <p>{copy.chapterOneP2}</p>
        </div>
      </div>
      <div class="space-y-8 md:col-span-7" data-reveal>
        <div class="grid grid-cols-2 gap-3 sm:gap-4">
          <figure class="photo-grade overflow-hidden rounded-sm">
            <img
              src={chapterImg1}
              alt=""
              width="800"
              height="1000"
              class="aspect-[4/5] h-full w-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </figure>
          <figure class="photo-grade overflow-hidden rounded-sm sm:translate-y-8 md:translate-y-12">
            <img
              src={chapterImg2}
              alt=""
              width="800"
              height="1000"
              class="aspect-[4/5] h-full w-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </div>
        <blockquote class="border-s-2 border-orange/60 ps-5 sm:ps-6">
          <p class="serif-display mb-5 text-lg italic leading-snug text-on-surface md:text-2xl">
            {copy.chapterOneQuote}
          </p>
          <p class="text-base leading-[1.7] text-on-surface-muted">
            {copy.chapterOneP3}
          </p>
        </blockquote>
      </div>
    </div>
  </section>

  <AmuletDivider />

  {/* Global Network — light editorial, no dark block, stat row */}
  <section class="px-5 py-14 sm:px-6 sm:py-16 md:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="mb-10 flex flex-col items-start justify-between gap-6 md:mb-14 md:flex-row md:items-end" data-reveal>
        <div class="max-w-xl">
          <span class="eyebrow mb-4 block text-orange">{copy.networkEyebrow}</span>
          <h2 class="serif-display text-3xl font-semibold leading-tight text-on-surface md:text-4xl lg:text-[2.6rem]">
            {copy.networkTitle}
          </h2>
        </div>
        <p class="max-w-sm text-base leading-[1.7] text-on-surface-muted md:text-right">
          {copy.networkLead}
        </p>
      </div>

      <div
        class="relative grid grid-cols-2 gap-y-6 border-y border-outline/30 py-8 sm:gap-8 md:grid-cols-4 md:py-10"
        data-reveal
      >
        {copy.networkStats.map((s, i) => (
          <div class:list={['ps-4 sm:ps-5', i > 0 ? 'border-s border-outline/30' : '']}>
            <span class="serif-display text-2xl font-semibold text-teal md:text-3xl">{s.n}</span>
            <p class="eyebrow mt-2 text-[10px] text-on-surface-subtle">{s.l}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <AmuletDivider compact />

  {/* Curatorial Mandate — three editorial rules, light */}
  <section class="px-5 py-14 sm:px-6 sm:py-16 md:py-24">
    <div class="mx-auto max-w-5xl text-center">
      <header class="mb-12 md:mb-16" data-reveal>
        <span class="eyebrow mb-4 block text-orange">{copy.mandateEyebrow}</span>
        <h2 class="serif-display text-3xl font-semibold text-on-surface md:text-4xl lg:text-[2.6rem]">
          {copy.mandateTitle}
        </h2>
      </header>
      <div class="grid grid-cols-1 gap-10 text-start md:grid-cols-3 md:gap-10">
        {copy.mandate.map((m, i) => (
          <article data-reveal style={`transition-delay:${i * 100}ms`}>
            <span class="serif-display mb-3 block text-2xl font-semibold text-orange">{m.n}</span>
            <h3 class="serif-display mb-3 text-xl font-semibold text-on-surface">{m.t}</h3>
            <p class="text-sm leading-[1.7] text-on-surface-muted">{m.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <AmuletDivider />

  {/* Asymmetric gallery — main + side stack, smaller crops */}
  <section class="px-5 py-14 sm:px-6 sm:py-16 md:py-24">
