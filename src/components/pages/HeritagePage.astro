---
import type { Locale } from '@/i18n';
import { localePath } from '@/i18n';
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
import CorpPageHero from '../v3/CorpPageHero.astro';
import CorpSection from '../v3/CorpSection.astro';

interface Props { locale: Locale; currentPath: string }
const { locale, currentPath } = Astro.props;

const copy = {
  tr: {
    eyebrow: 'MİRASIMIZ · İPEK YOLU\'NDAN BUGÜNE',
    heroTitle: 'Bir kıtanın kavşağında.',
    heroLead: 'Türkiye’nin coğrafyası bir tesadüf değil; bir miras. Antep fıstığı 3.500 yıldır bu topraklarda. Karadeniz fındığı M.Ö. 5. yy\'dan beri ticari. Bu derinlik bugünkü B2B disiplinimizin arka planı.',
    timelineEyebrow: 'ZAMAN ÇİZGİSİ',
    timelineTitle: 'Beş bin yıllık', timelineItalic: 'ticaret hafızası.',
    timeline: [
      { y: 'M.Ö. 2000', t: 'İlk gıda yolları', d: 'Anadolu, Mezopotamya, Mısır arasında bal, badem, fıstık, baharat ticareti. Hititler döneminde Antep platosunda fıstık yetiştiriciliği belgelenir.' },
      { y: 'M.Ö. 130', t: 'İpek Yolu açılır', d: 'Anadolu Doğu-Batı arasında baharat, kuruyemiş ve kahve ticaretinde durak. Bursa, Konya, Trabzon ana şehirler.' },
      { y: '1554', t: 'İlk kahvehane', d: 'Tahtakale’de açılan kahvehane Yemen kahvesini Avrupa\'ya tanıştırır. İstanbul kahve kültürünün doğum yeri.' },
      { y: '1664', t: 'Mısır Çarşısı', d: 'Eminönü\'nde açılan Mısır Çarşısı bugün hâlâ baharat ticaretinin merkezi.' },
      { y: '1850', t: 'Giresun fındığı', d: 'Karadeniz fındığı uluslararası ticarete açılır. Avrupa çikolata sanayisinin temeli olur (Lindt 1845, Tobler 1867).' },
      { y: '1923', t: 'Cumhuriyet', d: 'Fiskobirlik (1936), Tariş (1937) ile küçük üreticiler küresel ihracatta organize olur.' },
      { y: '1996', t: 'AB Gümrük Birliği', d: 'Türkiye gıda ihracatı 10 yılda 3 katına çıkar. Antep fıstığı dünya pazarının %20\'sini alır.' },
      { y: '2021', t: 'EU PDO', d: 'Antep fıstığı PDO statüsüne geçer. Giresun fındığı, Maraş pul biber, Urfa isot da tescilli.' },
      { y: '2024', t: 'EUDR uyum', d: 'EU Deforestation Regulation kapsamında geo-trace + farmer-ID ile tam izlenebilirlik.' },
      { y: 'Bugün', t: 'Kısmet masası', d: 'Türkiye merkezli, Avrupa, Orta Doğu ve Asya pazarlarına 5 hattıyla küratör B2B masa.' },
    ],
    quote: '“Türkiye, ticaretin yalnızca mal değil; kültür, güven ve verilen söz olduğunu bilen bir kıta üzerinde durur.”',
    quoteBy: 'Kısmet Foods Kurucu Masası',
    ctaTitle: 'Mirasınızı bizimle taşıyın.',
    ctaLead: 'Hangi sezon, hangi menşe, hangi formula — bu coğrafyanın disiplinini sevkiyatınıza taşıyalım.',
    ctaBtn: 'Tedarik Talebi',
  },
  en: {
    eyebrow: 'OUR HERITAGE · FROM THE SILK ROAD TO TODAY',
    heroTitle: 'At the junction of a continent.',
    heroLead: 'Türkiye’s geography is not a coincidence; it is a heritage. Antep pistachio has lived here for 3,500 years. Black Sea hazelnut entered trade in the 5th century BC. This depth is the backdrop of today’s B2B discipline.',
    timelineEyebrow: 'TIMELINE',
    timelineTitle: 'Five thousand years of', timelineItalic: 'trade memory.',
    timeline: [
      { y: '2000 BC', t: 'First food roads', d: 'Honey, almond, pistachio, spice flowing between Anatolia, Mesopotamia and Egypt. Hittite-era pistachio cultivation documented in the Antep plateau.' },
      { y: '130 BC', t: 'Silk Road opens', d: 'Anatolia becomes a station in spice, nut and coffee trade between East and West. Bursa, Konya, Trabzon as key cities.' },
      { y: '1554', t: 'First coffeehouse', d: 'The Tahtakale coffeehouse introduced Yemeni coffee to Europe. Istanbul as the birthplace of coffee culture.' },
      { y: '1664', t: 'Spice Bazaar', d: 'The Egyptian Bazaar in Eminönü, still the centre of spice trade today.' },
      { y: '1850', t: 'Giresun hazelnut', d: 'Black Sea hazelnut enters international trade — foundation of European chocolate industry (Lindt 1845, Tobler 1867).' },
      { y: '1923', t: 'Republic', d: 'Fiskobirlik (1936) and Tariş (1937) organise smallholders into global export.' },
      { y: '1996', t: 'EU Customs Union', d: 'Türkiye food exports triple in 10 years. Antep pistachio captures 20% of the world market.' },
      { y: '2021', t: 'EU PDO', d: 'Antep pistachio earns PDO status. Giresun hazelnut, Maraş chilli flake and Urfa isot also registered.' },
      { y: '2024', t: 'EUDR compliance', d: 'Full traceability with geo-trace + farmer ID under EU Deforestation Regulation.' },
      { y: 'Today', t: 'Kismet desk', d: 'Türkiye-based curator B2B desk for European, Middle Eastern and Asian markets across 5 lines.' },
    ],
    quote: '“Türkiye stands on a continent that knows trade is not just goods — it is culture, trust and the spoken word.”',
    quoteBy: 'Kismet Foods Founding Desk',
    ctaTitle: 'Carry the heritage with us.',
    ctaLead: 'Whichever season, origin or formula — let’s bring this geography’s discipline to your shipment.',
    ctaBtn: 'Request Supply',
  },
  ar: {
    eyebrow: 'إرثنا · من طريق الحرير إلى اليوم',
    heroTitle: 'عند ملتقى القارات.',
    heroLead: 'جغرافيا تركيا ليست صدفة؛ بل إرث. فستق عنتاب موجود هنا منذ ٣٥٠٠ سنة. بندق البحر الأسود دخل التجارة من القرن الخامس قبل الميلاد.',
    timelineEyebrow: 'الخط الزمني',
    timelineTitle: 'خمسة آلاف سنة من', timelineItalic: 'ذاكرة التجارة.',
    timeline: [
      { y: '٢٠٠٠ ق.م', t: 'أولى طرق الغذاء', d: 'تجارة العسل واللوز والفستق والتوابل بين الأناضول وبلاد الرافدين ومصر.' },
      { y: '١٣٠ ق.م', t: 'افتتاح طريق الحرير', d: 'الأناضول محطة في تجارة التوابل والمكسرات والقهوة.' },
      { y: '١٥٥٤', t: 'أول مقهى', d: 'مقهى تحتقلة قدّم القهوة اليمنية إلى أوروبا.' },
      { y: '١٦٦٤', t: 'سوق التوابل', d: 'البازار المصري في إمينونو لا يزال مركز التوابل.' },
      { y: '١٨٥٠', t: 'بندق غيرسون', d: 'بندق البحر الأسود يدخل التجارة الدولية ويصبح أساس صناعة الشوكولاتة الأوروبية.' },
      { y: '١٩٢٣', t: 'الجمهورية', d: 'Fiskobirlik (١٩٣٦) وTariş (١٩٣٧) تنظم المنتجين الصغار في التصدير.' },
      { y: '١٩٩٦', t: 'الاتحاد الجمركي', d: 'صادرات تركيا الغذائية تتضاعف ٣ مرات في ١٠ سنوات.' },
      { y: '٢٠٢١', t: 'EU PDO', d: 'فستق عنتاب PDO. بندق غيرسون وفلفل مرعش وإيسوت أورفا أيضاً.' },
      { y: '٢٠٢٤', t: 'امتثال EUDR', d: 'تتبع كامل بـgeo-trace + farmer-ID.' },
      { y: 'اليوم', t: 'مكتب كسمت', d: 'مكتب B2B تركي لأوروبا والشرق الأوسط وآسيا.' },
    ],
    quote: '«تركيا تقف على قارة تعرف أن التجارة ليست سلعاً فقط — بل ثقافة وثقة وكلمة منطوقة.»',
    quoteBy: 'مكتب التأسيس',
    ctaTitle: 'احمل الإرث معنا.',
    ctaLead: 'أي موسم، أي منشأ، أي صيغة.',
    ctaBtn: 'طلب توريد',
  },
}[locale];

const heroBg = 'https://images.unsplash.com/photo-1564769625392-651b2c1b1c87?auto=format&fit=crop&w=2400&q=80';
---

<SiteHeader locale={locale} currentPath={currentPath} />

<main id="main">
  <CorpPageHero
    locale={locale}
    eyebrow={copy.eyebrow}
    title={copy.heroTitle}
    lede={copy.heroLead}
    background={heroBg}
    meta={[
      { label: 'Founded', value: '2019' },
      { label: 'Heritage', value: '5,000 yrs' },
      { label: 'PDO/GI', value: '4 active' },
      { label: 'EUDR', value: 'compliant' },
    ]}
  />

  <CorpSection variant="white" eyebrow={copy.timelineEyebrow} title={copy.timelineTitle} italic={copy.timelineItalic}>
    <ol class="hp-tl">
      {copy.timeline.map((it) => (
        <li>
          <span class="co-num hp-tl__y">{it.y}</span>
          <div>
            <h3 class="co-h3">{it.t}</h3>
            <p>{it.d}</p>
          </div>
        </li>
      ))}
    </ol>
  </CorpSection>

  <CorpSection variant="navy" eyebrow="MANIFESTO" title="" >
    <blockquote class="hp-quote">{copy.quote}</blockquote>
    <p class="hp-quote-by">— {copy.quoteBy}</p>
  </CorpSection>

  <CorpSection variant="snow" compact>
    <div class="hp-cta">
      <h2 class="co-h2">{copy.ctaTitle}</h2>
      <p>{copy.ctaLead}</p>
      <a href={localePath('/contact/request-quote/', locale)} class="co-btn co-btn--primary">{copy.ctaBtn} <span aria-hidden="true">→</span></a>
    </div>
  </CorpSection>
</main>

<SiteFooter locale={locale} />

<style>
  .hp-tl { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: 0; border-top: 1px solid var(--co-line); }
  .hp-tl li { display: grid; grid-template-columns: 140px 1fr; gap: 24px; padding: 28px 0; border-bottom: 1px solid var(--co-line); align-items: start; transition: background 200ms ease; }
  .hp-tl li:hover { background: var(--co-snow); }
  .hp-tl__y { font-size: 28px; color: var(--co-amber); line-height: 1; padding-left: 12px; }
  .hp-tl h3 { color: var(--co-ink); margin: 0 0 8px; }
  .hp-tl p { font-family: var(--co-sans); font-size: 15px; color: var(--co-mute); margin: 0; line-height: 1.65; max-width: 70ch; }

  .hp-quote { margin: 0; font-family: var(--co-serif); font-style: italic; font-size: clamp(24px, 2.6vw, 36px); line-height: 1.4; color: var(--co-white); max-width: 60ch; border-left: 4px solid var(--co-amber); padding-left: 28px; }
  .hp-quote-by { margin: 24px 0 0 32px; font-family: var(--co-sans); font-size: 12px; font-weight: 600; letter-spacing: 0.1em; color: var(--co-amber); text-transform: uppercase; }

  .hp-cta { display: flex; flex-direction: column; gap: 18px; align-items: flex-start; max-width: 60ch; }
  .hp-cta h2 { color: var(--co-ink); }
  .hp-cta p { font-family: var(--co-sans); font-size: 17px; color: var(--co-mute); margin: 0; line-height: 1.65; }
</style>
