---

<SiteHeader locale={locale} currentPath={currentPath} />

<Breadcrumb locale={locale} items={[{ name: tr.nav.sustainability }]} />

<main id="main" class="bg-surface">
  {/* Hero — typography-first, small framed photograph, soft halo */}
  <section class="hero relative overflow-hidden pt-10 pb-16 sm:pt-14 sm:pb-20 md:pt-20 md:pb-28 lg:pt-24 lg:pb-32">
    <div
      aria-hidden="true"
      class="hero-halo pointer-events-none absolute -top-24 left-1/2 h-[640px] w-[1200px] -translate-x-1/2 opacity-50"
    ></div>

    <div class="relative mx-auto grid max-w-7xl grid-cols-1 items-end gap-8 px-5 sm:gap-10 sm:px-6 md:px-8 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-7" data-reveal>
        <span class="eyebrow mb-5 block text-orange">{copy.eyebrow}</span>
        <h1 class="serif-display text-[2rem] font-semibold leading-[1.05] tracking-tight text-on-surface sm:text-[2.5rem] md:text-[3.4rem] lg:text-[4.2rem]">
          {copy.heroTitle}
        </h1>
        <p class="mt-6 max-w-[36rem] text-[15px] leading-[1.7] text-on-surface-muted md:text-lg">
          {copy.heroLead}
        </p>
      </div>

      <div class="lg:col-span-5" data-reveal>
        <figure class="photo-grade photo-grade--cool relative ms-auto overflow-hidden rounded-sm shadow-editorial">
          <img
            src={heroImg}
            alt=""
            width="800"
            height="1000"
            class="aspect-[4/5] w-full max-w-[14rem] object-cover sm:max-w-[20rem] md:max-w-[24rem] lg:max-w-none"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <AmuletDivider compact />

  {/* Farmer empowerment — asymmetric editorial */}
  <section class="px-5 py-14 sm:px-6 sm:py-16 md:py-24">
    <div class="mx-auto w-full max-w-7xl">
      <div class="mb-10 grid grid-cols-1 gap-6 md:mb-14 md:grid-cols-[5fr_7fr] md:gap-14" data-reveal>
        <div>
          <span class="eyebrow mb-4 block text-orange">{copy.farmerEyebrow}</span>
          <h2 class="serif-display text-3xl font-semibold leading-tight text-on-surface md:text-4xl lg:text-[2.6rem]">
            {copy.farmerTitle}
          </h2>
        </div>
        <p class="border-s-2 border-orange/60 ps-5 text-base leading-[1.7] text-on-surface-muted sm:ps-6 md:text-lg">
          {copy.farmerLead}
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-12 md:gap-8" data-reveal>
        <figure class="photo-grade photo-grade--warm overflow-hidden rounded-sm md:col-span-8">
