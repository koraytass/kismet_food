  <AmuletDivider />

  {/* Closing — light editorial CTA */}
  <section class="px-5 pb-20 sm:px-6 sm:pb-28 md:pb-36">
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <span class="eyebrow text-orange">Trade · Trust · Kismet</span>
      <h2 class="serif-display mt-4 text-3xl font-semibold leading-[1.1] tracking-tight text-on-surface md:text-[2.4rem]">
        {copy.ctaTitle}
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-base leading-[1.7] text-on-surface-muted md:text-lg">
        {copy.ctaLead}
