---
import type { Locale } from '@/i18n';
import { localePath } from '@/i18n';
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
import CorpPageHero from '../v3/CorpPageHero.astro';
import CorpSection from '../v3/CorpSection.astro';

interface Props { locale: Locale; currentPath: string }
const { locale, currentPath } = Astro.props;

const copy = {
  tr: {
    eyebrow: 'ESG · ÖLÇÜLEBİLİR HEDEF',
    heroTitle: 'Çiftçi · Toprak · Hesap verebilir hedef.',
    heroLead: 'EU EUDR, Fair Trade, Rainforest Alliance ve ISO protokollerinin kesişiminde çalışıyoruz. Yıllık ESG raporu farmer-ID düzeyinde geo-traceability ile yayımlanır.',
    pillarsEyebrow: 'ÜÇ PİLLAR', pillarsTitle: 'Sürdürülebilirliğin', pillarsItalic: 'üç ekseni.',
    pillars: [
      { h: 'Çiftçi Refahı', d: 'Adil fiyat, uzun vadeli sözleşme, eğitim ve tarım girdisi desteği.', kpi: '12.000+ ortak çiftçi' },
      { h: 'Çevre & İklim', d: 'Karbon ölçümü/dengeleme, plastik-nötr ambalaj, rejeneratif tarım.', kpi: '0.34 t CO₂e/konteyner' },
      { h: 'Yönetişim', d: 'ESG raporlama, üçüncü-taraf denetim, GFSI üyeliği.', kpi: '%92 EUDR uyumlu' },
    ],
    farmEyebrow: 'ÇİFTÇİ PROGRAMI', farmTitle: 'Doğrudan ortaklık,', farmItalic: 'düşen aracı.',
    farmLead: 'YCFCU, SCFCU, FNC, COCOBOD ve doğrudan kooperatif ortaklarımızla çalışırız. Aracı zincir kısaltıldıkça çiftçiye dönen pay artar.',
    farmStats: [
      { v: '12.000+', l: 'Doğrudan ortak çiftçi' },
      { v: '120+', l: 'Aktif kooperatif' },
      { v: '%18', l: 'Ortalama prim payı' },
      { v: '6', l: 'Yıllık eğitim modülü' },
    ],
    planetEyebrow: 'GEZEGEN', planetTitle: 'Karbon, plastik,', planetItalic: 'ölçülebilir hedef.',
    planetPoints: [
      { h: 'Karbon dengeleme', d: 'Konteyner başına 0.34 t CO₂e ölçümü ve onaylı carbon credit ile telafi.' },
      { h: 'Plastik-nötr', d: 'Geri dönüşümlü FIBC ve karton ambalaj. PE astar minimum.' },
      { h: 'Rota optimizasyonu', d: 'Konsolide sevkiyat, doğru liman seçimi ile %22 navlun emisyon azalımı.' },
      { h: 'Fire kontrol', d: 'Nem + transit kontrolü ile %1.5\'in altında ürün kaybı.' },
    ],
    reportEyebrow: 'YILLIK RAPOR', reportTitle: '2025 Sürdürülebilirlik', reportItalic: 'Raporu.',
    reportLead: 'Çiftçi erişimi, izlenebilir sevkiyat oranı, sertifikasyon kapsamı ve ambalaj/rota hedeflerinin tam ölçümü. PDF olarak yayında.',
    ctaBtn: 'Raporu İndir',
  },
  en: {
    eyebrow: 'ESG · MEASURABLE TARGET',
    heroTitle: 'Farmer · Soil · Accountable target.',
    heroLead: 'We operate at the intersection of EU EUDR, Fair Trade, Rainforest Alliance and ISO protocols. The annual ESG report is published with farmer-ID-level geo-traceability.',
    pillarsEyebrow: 'THREE PILLARS', pillarsTitle: 'Three axes of', pillarsItalic: 'sustainability.',
    pillars: [
      { h: 'Farmer welfare', d: 'Fair price, long-term contract, training and agricultural inputs.', kpi: '12,000+ partner farmers' },
      { h: 'Environment & Climate', d: 'Carbon measurement/offset, plastic-neutral packaging, regenerative agriculture.', kpi: '0.34 t CO₂e/container' },
      { h: 'Governance', d: 'ESG reporting, third-party audit, GFSI membership.', kpi: '92% EUDR-compliant' },
    ],
    farmEyebrow: 'FARMER PROGRAMME', farmTitle: 'Direct partnership,', farmItalic: 'fewer middlemen.',
    farmLead: 'We work with YCFCU, SCFCU, FNC, COCOBOD and direct cooperative partners. Shorter chain, larger share for the farmer.',
    farmStats: [
      { v: '12,000+', l: 'Direct partner farmers' },
      { v: '120+', l: 'Active cooperatives' },
      { v: '18%', l: 'Average premium share' },
      { v: '6', l: 'Annual training modules' },
    ],
    planetEyebrow: 'PLANET', planetTitle: 'Carbon, plastic,', planetItalic: 'measurable target.',
    planetPoints: [
      { h: 'Carbon offset', d: '0.34 t CO₂e per container measured and offset via verified carbon credits.' },
      { h: 'Plastic-neutral', d: 'Recyclable FIBC and carton. Minimal PE liner.' },
      { h: 'Route optimisation', d: 'Consolidated shipments + right port choice = 22% freight emission reduction.' },
      { h: 'Loss control', d: 'Moisture + transit control keeps loss under 1.5%.' },
    ],
    reportEyebrow: 'ANNUAL REPORT', reportTitle: '2025 Sustainability', reportItalic: 'Report.',
    reportLead: 'Full measurement of farmer reach, traceable shipment rate, certification scope and packaging/route targets. Available as PDF.',
    ctaBtn: 'Download Report',
  },
  ar: {
    eyebrow: 'ESG · هدف قابل للقياس',
    heroTitle: 'مزارع · تربة · هدف خاضع للمساءلة.',
    heroLead: 'نعمل عند تقاطع EU EUDR وFair Trade وRainforest Alliance وISO. تقرير ESG السنوي يُنشر بتتبع جغرافي على مستوى المعرّف.',
    pillarsEyebrow: 'ثلاثة محاور', pillarsTitle: 'ثلاثة محاور', pillarsItalic: 'للاستدامة.',
    pillars: [
      { h: 'رفاه المزارع', d: 'سعر عادل، عقد طويل الأمد، تدريب ودعم بالمدخلات.', kpi: '+١٢٠٠٠ مزارع' },
      { h: 'البيئة والمناخ', d: 'قياس وموازنة الكربون، تعبئة خالية من البلاستيك.', kpi: '٠٫٣٤ طن CO₂e/حاوية' },
      { h: 'الحوكمة', d: 'تقارير ESG، تدقيق طرف ثالث، عضوية GFSI.', kpi: '٪٩٢ متوافق EUDR' },
    ],
    farmEyebrow: 'برنامج المزارعين', farmTitle: 'شراكة مباشرة،', farmItalic: 'وسطاء أقل.',
    farmLead: 'نعمل مع YCFCU وSCFCU وFNC وCOCOBOD وشركاء تعاونيات مباشرة.',
    farmStats: [
      { v: '+١٢٠٠٠', l: 'مزارع شريك مباشر' },
      { v: '+١٢٠', l: 'تعاونية نشطة' },
      { v: '٪١٨', l: 'متوسط حصة العلاوة' },
      { v: '٦', l: 'وحدات تدريب سنوية' },
    ],
    planetEyebrow: 'الكوكب', planetTitle: 'كربون، بلاستيك،', planetItalic: 'هدف قابل للقياس.',
    planetPoints: [
      { h: 'موازنة كربون', d: '٠٫٣٤ طن CO₂e لكل حاوية مع موازنة معتمدة.' },
      { h: 'خالٍ من البلاستيك', d: 'FIBC وكرتون قابلان للتدوير.' },
      { h: 'تحسين المسار', d: 'تجميع الشحنات + ميناء صحيح = خفض ٢٢٪ في الانبعاثات.' },
      { h: 'ضبط الفاقد', d: 'فاقد أقل من ١٫٥٪.' },
    ],
    reportEyebrow: 'تقرير سنوي', reportTitle: 'تقرير استدامة', reportItalic: '٢٠٢٥.',
    reportLead: 'قياس كامل لوصول المزارعين، نسبة الشحنات القابلة للتتبع، نطاق الشهادات.',
    ctaBtn: 'تحميل التقرير',
  },
}[locale];

const heroBg = 'https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=2400&q=80';
---

<SiteHeader locale={locale} currentPath={currentPath} />

<main id="main">
  <CorpPageHero
    locale={locale}
    eyebrow={copy.eyebrow}
    title={copy.heroTitle}
    lede={copy.heroLead}
    background={heroBg}
    meta={[
      { label: 'EUDR', value: '92% compliant' },
      { label: 'Carbon', value: '0.34 t / TEU' },
      { label: 'Farmers', value: '12,000+' },
      { label: 'Audit', value: 'GFSI · 3P' },
    ]}
  />

  <CorpSection variant="white" eyebrow={copy.pillarsEyebrow} title={copy.pillarsTitle} italic={copy.pillarsItalic}>
    <div class="su-pillars">
      {copy.pillars.map((p, i) => (
        <article class="su-pillar">
          <span class="co-num su-pillar__num">0{i + 1}</span>
          <h3 class="co-h3">{p.h}</h3>
          <p>{p.d}</p>
          <span class="su-pillar__kpi">{p.kpi}</span>
        </article>
      ))}
    </div>
  </CorpSection>

  <CorpSection variant="navy" id="farmers" eyebrow={copy.farmEyebrow} title={copy.farmTitle} italic={copy.farmItalic} lede={copy.farmLead}>
    <div class="su-stats">
      {copy.farmStats.map((s) => (
        <div class="su-stat">
          <span class="co-num su-stat__v">{s.v}</span>
          <span class="su-stat__l">{s.l}</span>
        </div>
      ))}
    </div>
  </CorpSection>

  <CorpSection variant="snow" id="planet" eyebrow={copy.planetEyebrow} title={copy.planetTitle} italic={copy.planetItalic}>
    <div class="su-grid">
      {copy.planetPoints.map((p, i) => (
        <article class="su-card">
          <span class="co-num su-card__num">0{i + 1}</span>
          <h3 class="co-h3">{p.h}</h3>
          <p>{p.d}</p>
        </article>
      ))}
    </div>
  </CorpSection>

  <CorpSection variant="white" id="report" compact>
    <div class="su-report">
      <div>
        <span class="co-eyebrow">{copy.reportEyebrow}</span>
        <h2 class="co-h2">{copy.reportTitle} <em>{copy.reportItalic}</em></h2>
        <p>{copy.reportLead}</p>
      </div>
      <a href={localePath('/sustainability/report/', locale)} class="co-btn co-btn--primary">{copy.ctaBtn} <span aria-hidden="true">→</span></a>
    </div>
  </CorpSection>
</main>

<SiteFooter locale={locale} />

<style>
  .su-pillars { display: grid; grid-template-columns: 1fr; gap: 28px; }
  @media (min-width: 880px) { .su-pillars { grid-template-columns: repeat(3, 1fr); } }
  .su-pillar { padding-top: 24px; border-top: 2px solid var(--co-amber); display: flex; flex-direction: column; gap: 10px; }
  .su-pillar__num { font-size: 32px; color: var(--co-amber); line-height: 1; }
  .su-pillar h3 { color: var(--co-ink); margin: 0; }
  .su-pillar p { font-family: var(--co-sans); font-size: 14px; color: var(--co-mute); margin: 0; line-height: 1.6; }
  .su-pillar__kpi { font-family: var(--co-sans); font-size: 13px; font-weight: 700; color: var(--co-navy); padding-top: 8px; border-top: 1px solid var(--co-line); margin-top: 6px; }

  .su-stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.12); }
  @media (min-width: 880px) { .su-stats { grid-template-columns: repeat(4, 1fr); } }
  .su-stat { background: rgba(255,255,255,0.02); padding: 28px 22px; display: flex; flex-direction: column; gap: 6px; }
  .su-stat__v { font-size: clamp(28px, 3vw, 44px); color: var(--co-white); line-height: 1; }
  .su-stat__l { font-family: var(--co-sans); font-size: 12px; font-weight: 600; letter-spacing: 0.06em; color: var(--co-amber); text-transform: uppercase; }

  .su-grid { display: grid; grid-template-columns: 1fr; gap: 16px; }
  @media (min-width: 720px) { .su-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; } }
  @media (min-width: 1080px) { .su-grid { grid-template-columns: repeat(4, 1fr); } }
  .su-card { background: var(--co-white); border: 1px solid var(--co-line); padding: 20px; display: flex; flex-direction: column; gap: 10px; }
  .su-card__num { font-size: 22px; color: var(--co-amber); line-height: 1; }
  .su-card h3 { color: var(--co-ink); margin: 0; font-size: 17px; }
  .su-card p { font-family: var(--co-sans); font-size: 13px; color: var(--co-mute); margin: 0; line-height: 1.55; }

  .su-report { display: flex; flex-direction: column; gap: 24px; align-items: flex-start; max-width: 800px; }
  @media (min-width: 720px) { .su-report { flex-direction: row; align-items: center; justify-content: space-between; gap: 48px; max-width: none; } }
  .su-report h2 { color: var(--co-ink); margin: 8px 0; }
  .su-report p { font-family: var(--co-sans); font-size: 17px; color: var(--co-mute); margin: 0; line-height: 1.6; }
</style>
