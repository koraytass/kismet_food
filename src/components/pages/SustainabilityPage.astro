          </p>
        </div>
      </div>
    </div>
  </section>

  <AmuletDivider compact />

  {/* Certifications — light editorial cards */}
  <section class="px-5 py-14 sm:px-6 sm:py-16 md:py-24">
    <div class="mx-auto max-w-5xl">
      <header class="mb-12 text-center md:mb-16" data-reveal>
        <span class="eyebrow mb-4 block text-orange">{copy.certEyebrow}</span>
        <h2 class="serif-display text-3xl font-semibold text-on-surface md:text-4xl lg:text-[2.6rem]">
          {copy.certTitle}
        </h2>
        <p class="mx-auto mt-5 max-w-2xl text-base leading-[1.7] text-on-surface-muted md:text-lg">
          {copy.certLead}
        </p>
      </header>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-3 md:gap-10">
        {copy.certs.map((c, i) => (
          <article data-reveal style={`transition-delay:${i * 100}ms`}>
