---
/**
 * ProductsPage — faithful to Stitch design (5 editorial sections).
 *
 *   1. Editorial Header — eyebrow + oversized display title + lead,
 *                         right aside with hairline rule and curated label.
 *   2. Category Intro   — "Four Categories, One Standard" split heading.
 *   3. Bento Portfolio  — 4 asymmetric cards mirroring Stitch layout:
 *                           • Coffee & Cocoa        (7fr / 16:10, featured)
 *                           • Spices & Herbs        (5fr / 3:4, offset top)
 *                           • Nuts & Dried Fruits   (5fr / 4:5)
 *                           • Raw Ingredients       (7fr / 16:9, centered CTA,
 *                                                    overlapping negative margin)
 *   4. Traceability     — "The Story Behind Every Shipment" split with stats
 *                         grid and latest-shipment vignette card.
 *   5. CTA              — gradient band, Request Quote anchor.
 *
 * Every Stitch aida-public URL from the source code.html is wrapped in
 * stitchSrc() and placed in its corresponding card.
 */
import type { Locale } from '@/i18n';
import { t, localePath } from '@/i18n';
import { stitchSrc } from '@/lib/stitch';
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
import Breadcrumb from '../Breadcrumb.astro';
import Button from '../Button.astro';
import AmuletDivider from '../AmuletDivider.astro';
import { stockImages } from '@/lib/images';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const tr = t(locale);

