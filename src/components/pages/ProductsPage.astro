<style>
  .hero-halo {
    background:
      radial-gradient(closest-side, rgba(0, 172, 175, 0.08), transparent 70%),
      radial-gradient(closest-side at 70% 60%, rgba(246, 139, 92, 0.07), transparent 70%);
  }
  [data-reveal] {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 800ms cubic-bezier(0.22, 0.72, 0.22, 1),
      transform 800ms cubic-bezier(0.22, 0.72, 0.22, 1);
  }
  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if (items.length) {
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
      );
      items.forEach((el) => io.observe(el));
    } else {
      items.forEach((el) => el.classList.add('is-visible'));
    }
  }
</script>

