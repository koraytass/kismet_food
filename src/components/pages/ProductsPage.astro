---
/**
 * ProductsPage — v3 corporate.
 * 5 ürün hattı kurumsal grid + izlenebilirlik bandı + CTA.
 */
import type { Locale } from '@/i18n';
import { t, localePath } from '@/i18n';
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
import CorpPageHero from '../v3/CorpPageHero.astro';
import CorpSection from '../v3/CorpSection.astro';

interface Props { locale: Locale; currentPath: string }
const { locale, currentPath } = Astro.props;
const tr = t(locale);

const copy = {
  tr: {
    eyebrow: 'KÜRESEL KÜRATÖR',
    heroTitle: 'Ürün Portföyü',
    heroLead: 'Dünyanın en özel ham maddelerini uluslararası pazarlara hassas lojistik ve etik tedarikle taşıyoruz.',
    portfolioEyebrow: 'PORTFÖY', portfolioTitle: 'Beş hat,', portfolioItalic: 'tek standart.',
    portfolioLead: 'Kahve, kakao, kuruyemiş, baharat ve endüstriyel gıda içerikleri — her hat ayrı portföy yöneticisi, ayrı laboratuvar protokolüyle yönetilir.',
    cats: [
      { slug: 'coffee', badge: 'Öne Çıkan', title: 'Kahve', body: 'Etiyopya yaylalarından ve Latin Amerika’nın yüksek rakımlı çiftliklerinden specialty arabica & robusta.', bench: 'ICE NY-C · LIFFE Robusta', cta: 'Kahveyi Keşfet' },
      { slug: 'cocoa', badge: 'Fermente Çekirdek', title: 'Kakao', body: 'Gana Forastero ve Fildişi Sahili kakao çekirdekleri — endüstriyel ve premium üretim için.', bench: 'ICE NY-K · LIFFE-C', cta: 'Kakaoyu Keşfet' },
      { slug: 'nuts', badge: 'Premium Kalibrasyon', title: 'Kuruyemiş & Kuru Meyve', body: 'Antep PDO fıstığı, Giresun fındığı, Malatya kayısısı, Vietnam W320 kaju.', bench: 'spot · Anadolu', cta: 'Kuruyemişi Keşfet' },
      { slug: 'spices', badge: 'Saflık Testli', title: 'Baharat & Otlar', body: 'Hindistan Tellicherry karabiber, Sumatra cassia tarçın, Urfa isot PDO.', bench: 'IPSTA · MCC', cta: 'Baharatları Keşfet' },
      { slug: 'industrial-ingredients', badge: 'Endüstriyel Hacim', title: 'Endüstriyel Gıda İçerikleri', body: 'Konya buğday, Mendoza non-GMO soya, ayçiçek RBD, ICUMSA 45 şeker.', bench: 'MATIF · CME · BMD', cta: 'Toplu Tedarik' },
    ],
    traceEyebrow: 'İZLENEBİLİRLİK', traceTitle: 'Her sevkiyatın', traceItalic: 'belgesi var.',
    traceBody: 'Şeffaflık nihai lükstür. Portföyümüzdeki her ürün; hasattan tesisinize uzanan yolculuğu belgeleyen dijital menşe sertifikası, EUDR geo-trace, akredite üçüncü-taraf lab analizi ve Phytosanitary + CoO + EUR.1 dosyasıyla gelir.',
    stats: [
      { v: '17', l: 'Aktif menşe' },
      { v: '%92', l: 'EUDR uyumlu sevkiyat' },
      { v: '%99,8', l: 'Zamanında teslim' },
      { v: '5', l: 'Kıta operasyonu' },
    ],
    ctaTitle: 'Özel emtia tedariği için masamızla görüşün.', ctaLead: 'Tek bir konteyner ya da yıllık formula sözleşme — ticari masamız 24 saat içinde brief\'i değerlendirir.', ctaBtn: 'Teklif Al',
  },
  en: {
    eyebrow: 'GLOBAL CURATOR',
    heroTitle: 'Product Portfolio',
    heroLead: 'Bridging the world\'s most exceptional raw materials with international markets through precision logistics and ethical sourcing.',
    portfolioEyebrow: 'THE PORTFOLIO', portfolioTitle: 'Five lines,', portfolioItalic: 'one standard.',
    portfolioLead: 'Coffee, cocoa, nuts, spices and industrial food ingredients — each line runs with a dedicated portfolio manager and lab protocol.',
    cats: [
      { slug: 'coffee', badge: 'Featured', title: 'Coffee', body: 'Specialty arabica & robusta from the highlands of Ethiopia and the high-altitude farms of Latin America.', bench: 'ICE NY-C · LIFFE Robusta', cta: 'Explore Coffee' },
      { slug: 'cocoa', badge: 'Fermented Bean', title: 'Cocoa', body: 'Ghana Forastero and Côte d’Ivoire cocoa beans — for industrial and premium production.', bench: 'ICE NY-K · LIFFE-C', cta: 'Explore Cocoa' },
      { slug: 'nuts', badge: 'Premium Calibration', title: 'Nuts & Dried Fruit', body: 'Antep PDO pistachio, Giresun hazelnut, Malatya apricot, Vietnam W320 cashew.', bench: 'spot · Anatolia', cta: 'Explore Nuts' },
      { slug: 'spices', badge: 'Purity Tested', title: 'Spices & Herbs', body: 'Indian Tellicherry pepper, Sumatra cassia, Urfa isot PDO.', bench: 'IPSTA · MCC', cta: 'Explore Spices' },
      { slug: 'industrial-ingredients', badge: 'Industrial Volume', title: 'Industrial Food Ingredients', body: 'Konya wheat, Mendoza non-GMO soy, sunflower RBD, ICUMSA 45 sugar.', bench: 'MATIF · CME · BMD', cta: 'Bulk Supply' },
    ],
    traceEyebrow: 'TRACEABILITY', traceTitle: 'Every shipment', traceItalic: 'has its file.',
    traceBody: 'Transparency is the ultimate luxury. Every product in our portfolio comes with a digital certificate of origin, EUDR geo-trace, accredited third-party lab analysis and Phytosanitary + CoO + EUR.1 file.',
    stats: [
      { v: '17', l: 'Active origins' },
      { v: '92%', l: 'EUDR-compliant shipments' },
      { v: '99.8%', l: 'On-time delivery' },
      { v: '5', l: 'Continent operations' },
    ],
    ctaTitle: 'Discuss a custom commodity supply with our desk.', ctaLead: 'A single container or an annual formula contract — our trade desk evaluates the brief within 24 hours.', ctaBtn: 'Request Quote',
  },
  ar: {
    eyebrow: 'القيّم العالمي',
    heroTitle: 'محفظة المنتجات',
    heroLead: 'نربط أندر المواد الخام في العالم بالأسواق الدولية عبر لوجستيات دقيقة وتوريد أخلاقي.',
    portfolioEyebrow: 'المحفظة', portfolioTitle: 'خمسة خطوط،', portfolioItalic: 'معيار واحد.',
    portfolioLead: 'القهوة والكاكاو والمكسرات والتوابل والمكونات الصناعية — كل خط بمدير محفظة وبروتوكول مختبر منفصل.',
    cats: [
      { slug: 'coffee', badge: 'مميز', title: 'القهوة', body: 'أرابيكا وروبوستا مختصة من مرتفعات إثيوبيا وأمريكا اللاتينية.', bench: 'ICE NY-C · LIFFE Robusta', cta: 'استكشف القهوة' },
      { slug: 'cocoa', badge: 'حبوب مخمَّرة', title: 'الكاكاو', body: 'كاكاو غانا فوراستيرو وساحل العاج — للإنتاج الصناعي والفاخر.', bench: 'ICE NY-K · LIFFE-C', cta: 'استكشف الكاكاو' },
      { slug: 'nuts', badge: 'فرز ممتاز', title: 'مكسرات وفواكه', body: 'فستق عنتاب PDO، بندق غيرسون، مشمش ملاطية، كاجو فيتنام W320.', bench: 'فوري · أناضول', cta: 'استكشف المكسرات' },
      { slug: 'spices', badge: 'اختبار نقاء', title: 'توابل وأعشاب', body: 'فلفل تيليتشيري، قرفة كاسيا، إيسوت أورفا PDO.', bench: 'IPSTA · MCC', cta: 'استكشف التوابل' },
      { slug: 'industrial-ingredients', badge: 'حجم صناعي', title: 'المكونات الغذائية الصناعية', body: 'قمح قونيا، صويا مندوزا، زيت دوار شمس RBD، سكر ICUMSA 45.', bench: 'MATIF · CME · BMD', cta: 'توريد بالجملة' },
    ],
    traceEyebrow: 'إمكانية التتبع', traceTitle: 'لكل شحنة', traceItalic: 'ملفها.',
    traceBody: 'الشفافية هي الترف الأعظم. كل منتج يأتي مع شهادة منشأ رقمية وتتبع جغرافي EUDR وتحليل مختبر طرف ثالث معتمد + ملف Phyto وCoO وEUR.1.',
    stats: [
      { v: '١٧', l: 'منشأ نشط' },
      { v: '٪٩٢', l: 'شحنات متوافقة EUDR' },
      { v: '٪٩٩٫٨', l: 'تسليم في الموعد' },
      { v: '٥', l: 'عمليات قارية' },
    ],
    ctaTitle: 'ناقش توريد سلعة مخصصة مع مكتبنا.', ctaLead: 'حاوية واحدة أو عقد سنوي بصيغة — يقيّم مكتبنا الموجز خلال ٢٤ ساعة.', ctaBtn: 'طلب عرض سعر',
  },
}[locale];

const slugToPath: Record<string, string> = {
  coffee: '/products/coffee-cocoa/',
  cocoa: '/products/coffee-cocoa/',
  nuts: '/products/nuts/',
  spices: '/products/spices/',
  'industrial-ingredients': '/products/ingredients/',
};
const catLink = (slug: string) => localePath(slugToPath[slug] ?? `/products/${slug}/`, locale);

const photos: Record<string, string> = {
  coffee: 'https://images.unsplash.com/photo-1495774856032-8b90bbb32b32?auto=format&fit=crop&w=1600&q=80',
  cocoa: 'https://images.unsplash.com/photo-1606312619070-d48b4c652a52?auto=format&fit=crop&w=1600&q=80',
  nuts: 'https://images.unsplash.com/photo-1599639957043-f3aa5c986398?auto=format&fit=crop&w=1600&q=80',
  spices: 'https://images.unsplash.com/photo-1532336414038-cf19250c5757?auto=format&fit=crop&w=1600&q=80',
  'industrial-ingredients': 'https://images.unsplash.com/photo-1574323347407-f5e1ad6d020b?auto=format&fit=crop&w=1600&q=80',
};
const heroBg = 'https://images.unsplash.com/photo-1559525839-d9acfd1011c4?auto=format&fit=crop&w=2400&q=80';
void tr;
---

<SiteHeader locale={locale} currentPath={currentPath} />

<main id="main">
  <CorpPageHero
    locale={locale}
    eyebrow={copy.eyebrow}
    title={copy.heroTitle}
    lede={copy.heroLead}
    background={heroBg}
    meta={[
      { label: 'Lines', value: '5' },
      { label: 'Origins', value: '17' },
      { label: 'Standard', value: 'ISO · BRC · FT' },
    ]}
  />

  <CorpSection variant="white" eyebrow={copy.portfolioEyebrow} title={copy.portfolioTitle} italic={copy.portfolioItalic} lede={copy.portfolioLead}>
    <div class="pp-grid">
      <a class="pp-card pp-card--featured" href={catLink(copy.cats[0].slug)}>
        <figure><img src={photos[copy.cats[0].slug]} alt={copy.cats[0].title} loading="lazy" decoding="async" /></figure>
        <div>
          <span class="co-eyebrow">{copy.cats[0].bench}</span>
          <h3 class="co-h2">{copy.cats[0].title}</h3>
          <p>{copy.cats[0].body}</p>
          <span class="co-link"><span>{copy.cats[0].cta}</span><span class="co-link__arrow" aria-hidden="true">→</span></span>
        </div>
      </a>

      <div class="pp-rest">
        {copy.cats.slice(1).map((c) => (
          <a class="pp-card" href={catLink(c.slug)}>
            <figure><img src={photos[c.slug]} alt={c.title} loading="lazy" decoding="async" /></figure>
            <div>
              <span class="co-eyebrow">{c.bench}</span>
              <h3 class="co-h3">{c.title}</h3>
              <p>{c.body}</p>
              <span class="co-link"><span>{c.cta}</span><span class="co-link__arrow" aria-hidden="true">→</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </CorpSection>

  <CorpSection variant="navy" eyebrow={copy.traceEyebrow} title={copy.traceTitle} italic={copy.traceItalic} lede={copy.traceBody}>
    <div class="pp-stats">
      {copy.stats.map((s) => (
        <div class="pp-stat">
          <span class="co-num pp-stat__v">{s.v}</span>
          <span class="pp-stat__l">{s.l}</span>
        </div>
      ))}
    </div>
  </CorpSection>

  <CorpSection variant="snow" compact>
    <div class="pp-cta">
      <h2 class="co-h2">{copy.ctaTitle}</h2>
      <p>{copy.ctaLead}</p>
      <a href={localePath('/contact/request-quote/', locale)} class="co-btn co-btn--primary">{copy.ctaBtn} <span aria-hidden="true">→</span></a>
    </div>
  </CorpSection>
</main>

<SiteFooter locale={locale} />

<style>
  .pp-grid { display: grid; grid-template-columns: 1fr; gap: 24px; }
  @media (min-width: 1024px) { .pp-grid { grid-template-columns: 1.5fr 1fr; } }
  .pp-card { display: flex; flex-direction: column; background: var(--co-white); border: 1px solid var(--co-line); text-decoration: none; color: var(--co-text); transition: border-color 220ms ease, box-shadow 220ms ease, transform 220ms ease; overflow: hidden; }
  .pp-card:hover { border-color: var(--co-navy); box-shadow: 0 32px 60px -32px rgba(12,37,69,0.22); transform: translateY(-2px); }
  .pp-card figure { margin: 0; aspect-ratio: 16 / 10; overflow: hidden; background: var(--co-stone); }
  .pp-card figure img { width: 100%; height: 100%; object-fit: cover; transition: transform 700ms cubic-bezier(0.22,0.72,0.22,1); }
  .pp-card:hover figure img { transform: scale(1.04); }
  .pp-card > div { padding: 28px; display: flex; flex-direction: column; gap: 14px; }
  .pp-card h3 { color: var(--co-ink); }
  .pp-card p { font-family: var(--co-sans); font-size: 15px; line-height: 1.65; color: var(--co-mute); margin: 0; }
  .pp-card .co-link { align-self: flex-start; margin-top: 4px; }

  .pp-card--featured figure { aspect-ratio: 4 / 5; }
  .pp-card--featured > div { padding: 36px; gap: 18px; }
  @media (min-width: 1024px) {
    .pp-card--featured { flex-direction: row; }
    .pp-card--featured figure { flex: 1; aspect-ratio: auto; }
    .pp-card--featured > div { flex: 1; justify-content: center; }
  }

  .pp-rest { display: flex; flex-direction: column; gap: 24px; }
  .pp-rest .pp-card { flex-direction: row; }
  .pp-rest figure { width: 40%; aspect-ratio: auto; flex-shrink: 0; }
  .pp-rest > .pp-card > div { padding: 20px 24px; }
  @media (max-width: 760px) {
    .pp-rest .pp-card { flex-direction: column; }
    .pp-rest figure { width: 100%; aspect-ratio: 16 / 10; }
  }

  .pp-stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.12); }
  @media (min-width: 880px) { .pp-stats { grid-template-columns: repeat(4, 1fr); } }
  .pp-stat { background: rgba(255,255,255,0.02); padding: 28px 22px; display: flex; flex-direction: column; gap: 6px; }
  .pp-stat__v { font-size: clamp(28px, 3vw, 44px); color: var(--co-white); line-height: 1; }
  .pp-stat__l { font-family: var(--co-sans); font-size: 12px; font-weight: 600; letter-spacing: 0.06em; color: var(--co-amber); text-transform: uppercase; }

  .pp-cta { display: flex; flex-direction: column; gap: 18px; align-items: flex-start; max-width: 60ch; }
  .pp-cta h2 { color: var(--co-ink); }
  .pp-cta p { font-family: var(--co-sans); font-size: 17px; color: var(--co-mute); margin: 0; line-height: 1.65; }
</style>
