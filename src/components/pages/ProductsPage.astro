/* Slug → URL map.
   ProductsPage gösterimde 5 kart (coffee, cocoa, nuts, spices, industrial)
   tutuyor ama backend yalnızca 4 detay sayfası ile besleniyor:
     • /products/coffee-cocoa/        — birleşik kahve & kakao detayı
     • /products/nuts/                — kuruyemiş & kuru meyve
     • /products/spices/              — baharat & otlar
     • /products/ingredients/         — endüstriyel hammadde
   Bu yüzden coffee + cocoa kartları aynı coffee-cocoa sayfasına,
   industrial-ingredients de ingredients sayfasına yönlendirilir. */
const slugToPath: Record<string, string> = {
  coffee: '/products/coffee-cocoa/',
  cocoa: '/products/coffee-cocoa/',
  nuts: '/products/nuts/',
  spices: '/products/spices/',
  'industrial-ingredients': '/products/ingredients/',
};
const categoryLink = (slug: string) =>
  localePath(slugToPath[slug] ?? `/products/${slug}/`, locale);

/* --- Stitch images (all 4 aida-public URLs from code.html used) --- */
const imgCoffee = stitchSrc(
  'https://lh3.googleusercontent.com/aida-public/AB6AXuCf3xnmI7oq8dt-O3370grjkqFEh9Hw0tWGCewRtc0y0Ajm6AyoKdi4Ylg-IC4TDX-gpyhfKwp7Y3fTiMpkooyEqalk8C0qNFsoateoZKpEGacOtwKjtq1YrF_eOrd88WG85fwG_jjI9n3qGU9d--v9WdjHoDRifcrOY07HwxjDqQcmN1ftTAl2dlrCDV-fMT0Mw5XRi_O7eHMsliXGBpxfzht1coVg8N2I7ANoQ04Q0wBuQgDWiHUrjFMHyc6sNjwAeocCitwz0HQ',
);
const imgSpices = stitchSrc(
  'https://lh3.googleusercontent.com/aida-public/AB6AXuCGph67KssqaQBYqynx742YWlGZY5ajlwVj_BKavqubpzfRKSz-0_fAhASYBcHe_UT-4-MRm7ChbMhmDBG_QQz5z4D1G8tSTqqvsyDnlAYxN59u-PdqDLNd07lofZAU_T_7XsLiCBEyP5-yqcQucSwtb8MSuMz5o8QgO_g2NMjlAh6KKCqxbaIcbdm_aNWKP0eQOq2Q3g0sIAv5jBtWqzaiBM_8EJ8dcyjHVzUY-xf8YApECQ5Ca81hG7pfp85i3eUCLcV2CRDuyUI',
);
const imgNuts = stitchSrc(
  'https://lh3.googleusercontent.com/aida-public/AB6AXuCSmjHeOGh1MFuy6XVXUL3u6SacSmdebSl64nEB8K_3nK_9gVMWCIfh81kyInqPAOMapIAdoY49X2WxwtYQso-6OvIEQJyuuvqxf8cD2YAvLzDJ4-ifja-cXnYJKUpscf1B2zKRvbPoRFIv0Tian_naa3yhQSVXuAWKgN63wuFjvmutjZUN0dUtlTQZ1nxtRQsW-0rMyfyxZzMMV65KA8fTsb1u0J_8eMMLM6km4zRlOjKPAf_4_Nfy-ewBEA3TVfv1_ymVvkeqH_4',
);
const imgRaw = stitchSrc(
  'https://lh3.googleusercontent.com/aida-public/AB6AXuDBkeaLnB2F34KEFWN5OwRrRvzaSepS6ypGxIV5y-G248lKiwoFoEuPAFNUUpCxBSk6MKWVyFlbjXThjZ59cgdUROlZ8r05LDNdFzSBjgAkeSETicPJcT6WvVIifOdjtyrODBasa7Ph5bmogrwqdsr5R9QDCYsXbLx_n1bTS9otxpkTFFhSmZn5CRqjv3mpw4soNyHgqy1l436FNtyP_Q9rxZxvtSaqwA7PekMvwO9FsJ4Pxb6Zf-AT1iSEYNxzosaq2HeFac7Ear0',
);

const categoryAlt: Record<string, string> = {
  coffee:
    locale === 'tr'
      ? 'Yüksek rakım yeşil kahve çekirdekleri'
      : locale === 'ar'
      ? 'حبوب قهوة خضراء من ارتفاعات عالية'
      : 'High-altitude raw green coffee beans',
  cocoa:
    locale === 'tr'
      ? 'Muz yaprağı üstünde fermente kakao çekirdekleri'
      : locale === 'ar'
      ? 'حبوب كاكاو مخمرة على ورق الموز'
      : 'Fermented cocoa beans on banana leaf',
  nuts:
    locale === 'tr'
      ? 'Ceviz, fındık, badem ve kaju karışımı doğal düzen'
      : locale === 'ar'
      ? 'ترتيب طبيعي من الجوز والبندق واللوز والكاجو'
      : 'Walnuts, hazelnuts, almonds and cashews in natural arrangement',
  spices:
    locale === 'tr'
      ? 'Yıldız anason, tarçın, karabiber ve baharat dizilimi'
      : locale === 'ar'
      ? 'مجموعة من التوابل الكاملة'
      : 'Array of whole exotic spices including star anise, cinnamon and peppercorns',
  'industrial-ingredients':
    locale === 'tr'
      ? 'Endüstriyel ölçekte ham tahıl ve bakliyat'
      : locale === 'ar'
      ? 'حبوب وبقوليات خام بحجم صناعي'
      : 'Industrial-scale raw grains and legumes under soft light',
};

/* Image source per slug. coffee-cocoa was a single combined image — split
   into two distinct slots: cocoa uses stockImages.cocoa, others reuse the
   Stitch product photography. */
const imgFor: Record<string, string> = {
  coffee: imgCoffee,
  cocoa: stockImages.cocoa.src,
  nuts: imgNuts,
  spices: imgSpices,
  'industrial-ingredients': imgRaw,
};

/* Featured (first card visually larger) vs the rest — clean editorial grid,
   no upward overlap that previously buried the Spices card under Raw. */
const featured = copy.categories[0];
const rest = copy.categories.slice(1);
---

<SiteHeader locale={locale} currentPath={currentPath} />

<Breadcrumb locale={locale} items={[{ name: tr.nav.products }]} />

<main id="main" class="bg-surface">
  {/* ========== 1. EDITORIAL HEADER ========== */}
  <section class="hero relative overflow-hidden pt-10 pb-12 sm:pt-14 sm:pb-16 md:pt-20 md:pb-20 lg:pt-24">
    <div
      aria-hidden="true"
      class="hero-halo pointer-events-none absolute -top-24 left-1/2 h-[640px] w-[1200px] -translate-x-1/2 opacity-50"
    ></div>

    <div class="relative mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 px-5 sm:px-6 md:flex-row md:items-end md:gap-10 md:px-8" data-reveal>
      <div class="max-w-3xl">
        <span class="eyebrow mb-5 block text-orange">{copy.eyebrow}</span>
        <h1 class="serif-display text-[2.5rem] font-semibold leading-[1.05] tracking-tight text-on-surface sm:text-5xl md:text-6xl lg:text-[4.5rem]">
          {copy.heroTitle1}
        </h1>
        <p class="mt-6 max-w-xl text-[15px] leading-[1.7] text-on-surface-muted md:text-lg">
          {copy.heroLead}
        </p>
      </div>
      <div class="hidden md:block">
        <div class="mb-4 h-px w-24 bg-orange"></div>
        <span class="eyebrow text-on-surface-subtle">{copy.heroAside}</span>
      </div>
    </div>
  </section>

  <AmuletDivider compact />

  {/* ========== 2. CATEGORY INTRO ========== */}
  <section class="px-5 py-10 sm:px-6 sm:py-12 md:py-16">
    <div class="mx-auto max-w-4xl text-center" data-reveal>
      <span class="eyebrow mb-4 block text-orange">{copy.categoriesEyebrow}</span>
      <h2 class="serif-display text-3xl font-semibold leading-[1.1] tracking-tight text-on-surface md:text-[2.6rem] lg:text-[3rem]">
        {copy.categoriesTitle}
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-base leading-[1.7] text-on-surface-muted md:text-lg">
        {copy.categoriesLead}
      </p>
    </div>
  </section>

  {/* ========== 3. CATEGORY CARDS — clean editorial grid, no overlap ========== */}
  <section class="px-5 pb-16 sm:px-6 sm:pb-20 md:pb-28">
    <div class="mx-auto w-full max-w-7xl">
      {/* Featured card — first category (Coffee), full width on md, 8/12 on lg */}
      <article class="group reveal-wrap mb-8 md:mb-10" data-reveal>
        <a
          href={categoryLink(featured.slug)}
          class="block overflow-hidden rounded-sm shadow-editorial"
        >
          <div class="grid grid-cols-1 lg:grid-cols-12">
            <figure class="photo-grade photo-grade--warm relative overflow-hidden lg:col-span-7">
              <img
                src={imgFor[featured.slug]}
                alt={categoryAlt[featured.slug]}
                width="1440"
                height="900"
                class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04] md:aspect-[16/10]"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </figure>
            <div class="flex flex-col justify-center gap-4 bg-surface-lowest p-6 sm:p-8 md:p-10 lg:col-span-5 lg:p-12">
              <span class="eyebrow text-orange">{featured.badge}</span>
              <h3 class="serif-display text-2xl font-semibold leading-tight text-on-surface md:text-3xl lg:text-[2.2rem]">
                {featured.title}
              </h3>
              <p class="text-base leading-[1.7] text-on-surface-muted">
                {featured.body}
              </p>
              <span class="txt-link mt-2 text-[11px] uppercase tracking-[0.18em] text-teal">
                <span>{featured.cta}</span>
                <span class="txt-link__arrow" aria-hidden="true">→</span>
              </span>
            </div>
          </div>
        </a>
      </article>

      {/* Remaining 4 cards — even 2-col grid on md+, 1-col mobile, NO overlap */}
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 md:gap-10">
        {rest.map((cat, i) => (
          <article class="group" data-reveal style={`transition-delay:${i * 80}ms`}>
            <a
              href={categoryLink(cat.slug)}
              class="block overflow-hidden rounded-sm shadow-editorial"
            >
              <figure class="photo-grade overflow-hidden">
                <img
                  src={imgFor[cat.slug]}
                  alt={categoryAlt[cat.slug]}
                  width="900"
                  height="900"
                  class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
              <div class="flex flex-col gap-3 bg-surface-lowest p-6 sm:p-7 md:p-8">
                <span class="eyebrow text-orange">{cat.badge}</span>
                <h3 class="serif-display text-xl font-semibold leading-tight text-on-surface md:text-[1.6rem]">
                  {cat.title}
                </h3>
                <p class="text-sm leading-[1.7] text-on-surface-muted md:text-base">
                  {cat.body}
                </p>
                <span class="txt-link mt-1 text-[11px] uppercase tracking-[0.18em] text-teal">
                  <span>{cat.cta}</span>
                  <span class="txt-link__arrow" aria-hidden="true">→</span>
                </span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <AmuletDivider />

  {/* ========== 4. TRACEABILITY — light editorial 7/5 split ========== */}
