---

<SiteHeader locale={locale} currentPath={currentPath} />

<Breadcrumb
  locale={locale}
  items={[
    { name: tr.nav.origins, href: originsHref },
    { name: copy.heroTitle },
  ]}
/>

<main id="main" class="bg-surface">
  {/* Hero */}
  <section class="px-4 pb-16 pt-8 md:px-8 md:pt-12">
    <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-10 md:grid-cols-2">
      <div class="">
        <span class="eyebrow mb-6 block text-orange-dark">{copy.eyebrow}</span>
        <h1 class="serif-display mb-8 text-5xl font-bold leading-none text-on-surface md:text-7xl lg:text-8xl">
          {copy.heroTitle}
        </h1>
        <p class="max-w-xl text-lg leading-relaxed text-on-surface-muted md:text-xl">
          {copy.heroLead}
        </p>
        <a
          href={originsHref}
          class="eyebrow mt-8 inline-block text-teal-dark hover:text-orange-dark"
        >
          {copy.backBtn}
        </a>
      </div>
      <div class="relative">
        <img
          src={heroImg}
          alt={copy.heroImgAlt}
          class="shadow-editorial aspect-[4/5] w-full object-cover"
          width="1200"
          height="1500"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </section>

  {/* Hazelnuts + Pistachios bento */}
  <section class="bg-surface-low px-4 py-20 md:px-8 md:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="mb-12 text-center">
        <span class="eyebrow mb-4 block text-teal-dark">{copy.heartlandEyebrow}</span>
        <h2 class="serif-display text-3xl font-bold text-on-surface md:text-4xl lg:text-5xl">
          {copy.heartlandTitle}
        </h2>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-12 md:grid-rows-2">
        {/* Giresun */}
        <div class="relative overflow-hidden md:col-span-8 md:row-span-2">
          <img
            src={hazelnutImg}
            alt={copy.giresunImgAlt}
            class="h-full min-h-[320px] w-full object-cover md:min-h-[640px]"
            width="1600"
            height="1200"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-surface-deep/80 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-8">
            <h3 class="serif-display mb-3 text-3xl font-bold text-white md:text-4xl">
              {copy.giresunTitle}
            </h3>
            <p class="max-w-md leading-relaxed text-white/85">{copy.giresunLead}</p>
          </div>
        </div>
        {/* Antep */}
        <div class="relative overflow-hidden md:col-span-4">
          <img
            src={pistachioImg}
            alt={copy.antepImgAlt}
            class="h-full min-h-[280px] w-full object-cover"
            width="800"
            height="800"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-surface-deep/80 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-6">
            <span class="eyebrow mb-2 inline-block bg-orange px-3 py-1 text-white">
              {copy.antepBadge}
            </span>
            <h3 class="serif-display text-2xl font-bold text-white">{copy.antepTitle}</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/85">{copy.antepLead}</p>
          </div>
        </div>
        {/* Stat */}
        <div class="flex flex-col justify-center border-s-2 border-orange bg-surface-lowest p-8 shadow-editorial md:col-span-4">
          <span class="serif-display mb-2 text-4xl font-bold text-teal-dark md:text-5xl">
            {copy.statNumber}
          </span>
          <p class="eyebrow mb-4 text-on-surface-subtle">{copy.statLabel}</p>
          <p class="text-sm leading-relaxed text-on-surface-muted">{copy.statBody}</p>
        </div>
      </div>
    </div>
  </section>

  {/* Aegean + Spices */}
  <section class="px-4 py-20 md:px-8 md:py-24">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-8 md:grid-cols-2">
      <article class="border-t border-outline/30 bg-surface-low p-8 md:p-10">
        <h3 class="serif-display mb-3 text-2xl font-bold text-teal-dark md:text-3xl">
          {copy.aegeanTitle}
        </h3>
        <p class="leading-relaxed text-on-surface-muted">{copy.aegeanLead}</p>
      </article>
      <article class="border-t border-outline/30 bg-surface-low p-8 md:p-10">
        <h3 class="serif-display mb-3 text-2xl font-bold text-orange-dark md:text-3xl">
          {copy.spicesTitle}
        </h3>
        <p class="leading-relaxed text-on-surface-muted">{copy.spicesLead}</p>
      </article>
    </div>
  </section>

  {/* Product dossier */}
  <section class="bg-surface px-4 py-20 md:px-8 md:py-28">
    <div class="mx-auto max-w-7xl">
      <div class="mb-10 grid grid-cols-1 gap-6 md:grid-cols-12 md:items-end">
        <div class="md:col-span-5">
          <span class="eyebrow mb-4 block text-orange-dark">{dossiers.eyebrow}</span>
          <h2 class="serif-display text-3xl font-bold leading-tight text-on-surface md:text-5xl">
            {dossiers.title}
          </h2>
        </div>
        <p class="max-w-2xl text-base leading-[1.8] text-on-surface-muted md:col-span-7 md:text-lg">
          {dossiers.lead}
        </p>
      </div>

      <div class="grid grid-cols-1 border-t border-outline/35 md:grid-cols-2 lg:grid-cols-3">
        {dossiers.items.map((item) => (
          <article class="border-b border-outline/35 py-8 md:px-7 md:first:ps-0">
            <p class="mb-5 font-mono text-[10px] font-bold uppercase tracking-[0.22em] text-teal-dark">{item.label}</p>
            <h3 class="serif-display mb-4 text-2xl font-semibold leading-tight text-on-surface">{item.title}</h3>
            <p class="text-sm leading-[1.82] text-on-surface-muted">{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* Silk Road heritage band */}
  <section class="relative overflow-hidden bg-surface-low px-4 py-20 md:px-8 md:py-24">
    <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-10 md:grid-cols-12 md:gap-14">
      <figure class="photo-grade photo-grade--cool overflow-hidden shadow-editorial md:col-span-5">
        <img
          src={heritageImg}
          alt=""
          class="aspect-[4/5] w-full object-cover"
          width="900"
          height="1100"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="md:col-span-7">
      <h2 class="serif-display mb-6 text-3xl font-bold text-on-surface md:text-4xl lg:text-5xl">
        {copy.silkTitle}
      </h2>
      <p class="max-w-3xl text-lg leading-relaxed text-on-surface-muted">{copy.silkLead}</p>
      </div>
    </div>
  </section>

  {/* Certifications */}
  <section class="px-4 py-20 md:px-8 md:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="flex flex-col items-start gap-12 md:flex-row md:items-center md:gap-16">
        <div class="md:w-1/3">
          <h2 class="serif-display mb-6 text-3xl font-bold text-on-surface md:text-4xl">
            {copy.certsTitle}
          </h2>
          <p class="leading-relaxed text-on-surface-muted">{copy.certsLead}</p>
        </div>
        <div class="grid w-full grid-cols-2 gap-6 md:w-2/3 md:grid-cols-4">
          {copy.certs.map((c) => (
            <div class="flex items-center justify-center border border-outline/20 bg-surface-low p-6 text-center">
              <span class="eyebrow text-on-surface">{c}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* CTA */}
  <section class="bg-surface px-4 py-20 md:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <h2 class="serif-display mb-4 text-3xl font-bold text-on-surface md:text-4xl">{copy.ctaTitle}</h2>
      <p class="mb-8 text-lg leading-relaxed text-on-surface-muted">{copy.ctaLead}</p>
      <a
        href={contactHref}
        class="btn btn--primary"
      >
        {copy.ctaBtn}
      </a>
    </div>
  </section>
</main>

<SiteFooter locale={locale} />
