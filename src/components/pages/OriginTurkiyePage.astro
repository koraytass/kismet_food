---
import type { Locale } from '@/i18n';
import { localePath } from '@/i18n';
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
import CorpPageHero from '../v3/CorpPageHero.astro';
import CorpSection from '../v3/CorpSection.astro';

interface Props { locale: Locale; currentPath: string }
const { locale, currentPath } = Astro.props;

const copy = {
  tr: {
    eyebrow: 'MENŞE ODAK · ANADOLU',
    heroTitle: 'Türkiye',
    heroLead: 'Doğu ile Batı arasındaki köprü. Anadolu mikro iklimi, dünyanın en çok aranan Giresun fındığını, Antep fıstığını ve Ege inciri ile zeytinini yetiştirir. İpek Yolu mirası, modern uzmanlığımızın hâlâ ilk güzergâhıdır.',
    heartlandEyebrow: 'KALP COĞRAFYA', heartlandTitle: 'Fındık & Fıstık', heartlandItalic: '',
    items: [
      { region: 'Giresun', title: 'Giresun Fındığı', body: 'Karadeniz kıyısındaki Giresun’un yüksek yağ oranlı, ince kabuklu fındığı — lüks çikolata üreticilerinin tercih ettiği dünya standardı. AB PDO statüsünde.', spec: 'Yağ %62-65 · Kalibre 11-15 mm', badge: 'PDO' },
      { region: 'Gaziantep', title: 'Antep Fıstığı', body: 'Derin yeşil iç, mor zar, yoğun aroma — Gaziantep terroir-işaretli fıstığı. Premium grade ve izlenebilir menşe. AB PDO 2021.', spec: 'İç %48-52 · 18-22+ mm', badge: 'PDO' },
      { region: 'Aydın', title: 'Ege İnciri & Zeytini', body: 'Aydın Sarılop kuru inciri, Ayvalık zeytinyağı ve sofralık zeytin — Ege’nin yıllık rüzgârıyla olgunlaşan aromatik profil.', spec: 'Sarılop · Lerida classes', badge: '' },
      { region: 'Şanlıurfa', title: 'Anadolu Baharatları', body: 'Urfa isot, Antep pul biber, sumak ve mahlep — İpek Yolu’nun bugünkü mirasçısı olarak, aroma bütünlüğünde taviz yok.', spec: 'PDO Urfa isot · GI Maraş', badge: 'PDO/GI' },
      { region: 'Malatya', title: 'Hacıhaliloğlu Kayısı', body: 'Türkiye dünyanın 1’inci kuru kayısı üreticisi. Kalite sınıfı I-IV; SO₂ veya kükürtsüz organik hat.', spec: 'No1-4 boyutlama · %22-24 nem', badge: '' },
      { region: 'Konya', title: 'Anadolu Tahılı', body: 'Konya, Ankara ve Eskişehir hattı; protein %12-14 sert kırmızı buğday ekmeklik. Bisküvi sanayisi için yumuşak.', spec: 'Hagberg 250+ · gluten %26-30', badge: '' },
    ],
    silkTitle: 'İpek Yolu mirası,', silkItalic: 'modern uzmanlık.',
    silkLead: 'Osmanlı ticaret mirası üzerine inşa edilmiş modern bir operasyon. Ordu’dan Gaziantep’e, İzmir’den İstanbul’a; her bölgede saha-içinden ticaret ekipleri.',
    certsEyebrow: 'STANDART', certsTitle: 'Küresel standartlar,', certsItalic: 'yerel kökler.',
    certsLead: 'Anadolu tesislerinden çıkan her parti hem yerel düzenlemeleri hem de küresel mükemmeliyet işaretlerini karşılamak için titizlikle test edilir.',
    certs: ['ISO 22000', 'BRC GS Food (AA)', 'Helal · GIMDES', 'Kosher', 'USDA Organik', 'EU PDO/GI', 'EUDR uyum', 'Rainforest Alliance'],
    ctaTitle: '2026 Türkiye hasat ayırımınızı şimdi güvence altına alın.',
    ctaLead: 'Fındık, fıstık, incir veya baharat — ticaret uzmanlarımız menşe ve lojistik teklifini kısa süre içinde hazırlar.',
    ctaBtn: 'İletişime Geç',
  },
  en: {
    eyebrow: 'ORIGIN SPOTLIGHT · ANATOLIA',
    heroTitle: 'Türkiye',
    heroLead: 'The bridge between East and West. The Anatolian microclimate grows the world\'s most sought-after Giresun hazelnut, Antep pistachio, and Aegean fig and olive. The Silk Road heritage is still the first route of our modern expertise.',
    heartlandEyebrow: 'THE HEARTLAND', heartlandTitle: 'Hazelnuts & Pistachios', heartlandItalic: '',
    items: [
      { region: 'Giresun', title: 'Giresun Hazelnut', body: 'High-fat content, delicate-skin hazelnuts from the Black Sea — the world standard chosen by luxury chocolate makers. EU PDO.', spec: 'Oil 62-65% · Calibre 11-15 mm', badge: 'PDO' },
      { region: 'Gaziantep', title: 'Antep Pistachio', body: 'Deep-green kernel, purple skin, intense aroma — terroir-marked Gaziantep pistachio. Premium grade. EU PDO 2021.', spec: 'Kernel 48-52% · 18-22+ mm', badge: 'PDO' },
      { region: 'Aydın', title: 'Aegean Figs & Olives', body: 'Aydın Sarılop dried fig, Ayvalık olive oil and table olives — aromatic profile ripened by the Aegean winds.', spec: 'Sarılop · Lerida classes', badge: '' },
      { region: 'Şanlıurfa', title: 'Anatolian Spices', body: 'Urfa isot, Antep red pepper, sumac and mahleb — modern steward of the Silk Road, no compromise on aroma.', spec: 'PDO Urfa isot · GI Maraş', badge: 'PDO/GI' },
      { region: 'Malatya', title: 'Hacıhaliloğlu Apricot', body: 'Türkiye is the world\'s #1 dried apricot producer. Grades I-IV; SO₂ or unsulphured organic line.', spec: 'No1-4 size · 22-24% moisture', badge: '' },
      { region: 'Konya', title: 'Anatolian Grain', body: 'Konya–Ankara–Eskişehir line; 12-14% protein hard red wheat for bread, soft for biscuit industry.', spec: 'Hagberg 250+ · gluten 26-30%', badge: '' },
    ],
    silkTitle: 'Silk Road heritage,', silkItalic: 'modern expertise.',
    silkLead: 'A modern operation built on Ottoman trade heritage. From Ordu to Gaziantep, from İzmir to Istanbul — trade teams on the ground in every region.',
    certsEyebrow: 'STANDARDS', certsTitle: 'Global standards,', certsItalic: 'local roots.',
    certsLead: 'Every batch from our Anatolian facilities undergoes rigorous testing to meet both regional requirements and global excellence markers.',
    certs: ['ISO 22000', 'BRC GS Food (AA)', 'Halal · GIMDES', 'Kosher', 'USDA Organic', 'EU PDO/GI', 'EUDR compliance', 'Rainforest Alliance'],
    ctaTitle: 'Secure your 2026 Türkiye harvest allocation now.',
    ctaLead: 'Hazelnuts, pistachios, figs or spices — our trade experts prepare an origin and logistics proposal with the right commercial context.',
    ctaBtn: 'Contact Us',
  },
  ar: {
    eyebrow: 'نظرة معمّقة · الأناضول',
    heroTitle: 'تركيا',
    heroLead: 'الجسر بين الشرق والغرب. يُنبت المناخ المحلي الأناضولي أكثر أنواع البندق (غيرسون) والفستق (عنتاب) والتين والزيتون الإيجي طلباً في العالم.',
    heartlandEyebrow: 'قلب المنطقة', heartlandTitle: 'البندق والفستق', heartlandItalic: '',
    items: [
      { region: 'غيرسون', title: 'بندق غيرسون', body: 'بندق ذو محتوى دهني عالٍ وقشرة رقيقة — المعيار العالمي للشوكولاتة الفاخرة. PDO.', spec: 'زيت ٦٢-٦٥٪ · ١١-١٥ ملم', badge: 'PDO' },
      { region: 'غازي عنتاب', title: 'فستق عنتاب', body: 'لب أخضر داكن، قشرة بنفسجية، عطر قوي. PDO 2021.', spec: 'لب ٤٨-٥٢٪ · ١٨-٢٢+ ملم', badge: 'PDO' },
      { region: 'أيدِن', title: 'تين وزيتون إيجة', body: 'تين أيدِن ساريلوب وزيت زيتون أيواليك.', spec: 'ساريلوب · Lerida', badge: '' },
      { region: 'أورفا', title: 'توابل الأناضول', body: 'إيسوت أورفا، فلفل عنتاب، سماق ومحلب.', spec: 'PDO إيسوت · GI مرعش', badge: 'PDO/GI' },
      { region: 'ملاطية', title: 'مشمش حاجي حليلوغلو', body: 'تركيا الأولى عالمياً في المشمش المجفف. درجات I-IV.', spec: 'رقم ١-٤ · رطوبة ٢٢-٢٤٪', badge: '' },
      { region: 'قونيا', title: 'حبوب الأناضول', body: 'خط قونيا-أنقرة-إسكي شهير؛ بروتين ١٢-١٤٪ قمح صلب أحمر.', spec: 'Hagberg ٢٥٠+ · غلوتين ٢٦-٣٠٪', badge: '' },
    ],
    silkTitle: 'إرث طريق الحرير،', silkItalic: 'خبرة حديثة.',
    silkLead: 'عملية حديثة مبنية على إرث تجاري عثماني. من أوردو إلى عنتاب، من إزمير إلى إسطنبول.',
    certsEyebrow: 'المعايير', certsTitle: 'معايير عالمية،', certsItalic: 'جذور محلية.',
    certsLead: 'كل دفعة من منشآتنا في الأناضول تخضع لاختبار صارم لتلبية المتطلبات المحلية ومعايير التميز العالمية.',
    certs: ['ISO 22000', 'BRC GS Food (AA)', 'حلال · GIMDES', 'Kosher', 'USDA عضوي', 'EU PDO/GI', 'امتثال EUDR', 'Rainforest Alliance'],
    ctaTitle: 'أمّن حصة حصاد تركيا ٢٠٢٦ الآن.',
    ctaLead: 'بندق، فستق، تين أو توابل — يُعد خبراؤنا عرض المنشأ واللوجستيات بسياق تجاري دقيق.',
    ctaBtn: 'تواصل معنا',
  },
}[locale];

const heroBg = 'https://images.unsplash.com/photo-1604148482093-d55d6fc97cb5?auto=format&fit=crop&w=2400&q=80';
---

<SiteHeader locale={locale} currentPath={currentPath} />

<main id="main">
  <CorpPageHero
    locale={locale}
    eyebrow={copy.eyebrow}
    title={copy.heroTitle}
    lede={copy.heroLead}
    background={heroBg}
    parent={{ label: locale === 'tr' ? 'Menşe' : locale === 'ar' ? 'المنشأ' : 'Origins', href: localePath('/origins/', locale) }}
    meta={[
      { label: 'Cities', value: '6 active' },
      { label: 'PDO/GI', value: 'Antep · Giresun · Urfa · Maraş' },
      { label: 'Continents', value: 'Asia · Europe' },
    ]}
  />

  <CorpSection variant="white" eyebrow={copy.heartlandEyebrow} title={copy.heartlandTitle}>
    <div class="tk-grid">
      {copy.items.map((it, i) => (
        <article class="tk-card">
          <div class="tk-card__num"><span class="co-num">0{i + 1}</span><span class="co-eyebrow">{it.region}</span></div>
          <h3 class="co-h3">{it.title}</h3>
          <p>{it.body}</p>
          <div class="tk-card__foot">
            <span class="tk-card__spec">{it.spec}</span>
            {it.badge && <span class="tk-card__badge">{it.badge}</span>}
          </div>
        </article>
      ))}
    </div>
  </CorpSection>

  <CorpSection variant="navy" eyebrow="MİRASIMIZ" title={copy.silkTitle} italic={copy.silkItalic} lede={copy.silkLead} />

  <CorpSection variant="snow" eyebrow={copy.certsEyebrow} title={copy.certsTitle} italic={copy.certsItalic} lede={copy.certsLead}>
    <ul class="tk-certs">
      {copy.certs.map((c) => <li>{c}</li>)}
    </ul>
  </CorpSection>

  <CorpSection variant="white" compact>
    <div class="tk-cta">
      <h2 class="co-h2">{copy.ctaTitle}</h2>
      <p>{copy.ctaLead}</p>
      <a href={localePath('/contact/', locale)} class="co-btn co-btn--primary">{copy.ctaBtn} <span aria-hidden="true">→</span></a>
    </div>
  </CorpSection>
</main>

<SiteFooter locale={locale} />

<style>
  .tk-grid { display: grid; grid-template-columns: 1fr; gap: 16px; }
  @media (min-width: 720px) { .tk-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; } }
  @media (min-width: 1080px) { .tk-grid { grid-template-columns: repeat(3, 1fr); } }
  .tk-card { background: var(--co-white); border: 1px solid var(--co-line); padding: 24px; display: flex; flex-direction: column; gap: 12px; transition: border-color 220ms ease, box-shadow 220ms ease; }
  .tk-card:hover { border-color: var(--co-navy); box-shadow: 0 24px 48px -28px rgba(12,37,69,0.18); }
  .tk-card__num { display: flex; align-items: baseline; gap: 12px; }
  .tk-card__num .co-num { font-size: 28px; color: var(--co-amber); line-height: 1; }
  .tk-card h3 { color: var(--co-ink); margin: 0; }
  .tk-card p { font-family: var(--co-sans); font-size: 14px; color: var(--co-mute); margin: 0; line-height: 1.6; }
  .tk-card__foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding-top: 12px; margin-top: auto; border-top: 1px solid var(--co-line); }
  .tk-card__spec { font-family: var(--co-sans); font-size: 12px; font-weight: 600; color: var(--co-navy); letter-spacing: 0.02em; }
  .tk-card__badge { font-family: var(--co-sans); font-size: 10px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--co-amber); border: 1px solid var(--co-amber); padding: 3px 8px; }

  .tk-certs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
  @media (min-width: 880px) { .tk-certs { grid-template-columns: repeat(4, 1fr); } }
  .tk-certs li { background: var(--co-white); border: 1px solid var(--co-line); padding: 18px 20px; font-family: var(--co-sans); font-size: 13px; font-weight: 600; letter-spacing: 0.04em; color: var(--co-ink); }

  .tk-cta { display: flex; flex-direction: column; gap: 18px; align-items: flex-start; max-width: 60ch; }
  .tk-cta h2 { color: var(--co-ink); }
  .tk-cta p { font-family: var(--co-sans); font-size: 17px; color: var(--co-mute); margin: 0; line-height: 1.65; }
</style>
