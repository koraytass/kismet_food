---
/**
 * OriginTurkiyePage — Deep-dive on Türkiye origin.
 * Sections: Hero · Hazelnuts/Pistachios bento · Figs/Olives/Spices · Heritage band · CTA
 */
import type { Locale } from '@/i18n';
import { t, localePath } from '@/i18n';
import { stitchSrc } from '@/lib/stitch';
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
import Breadcrumb from '../Breadcrumb.astro';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const tr = t(locale);

const originsHref = localePath('/origins/', locale);
const contactHref = localePath('/contact/', locale);

