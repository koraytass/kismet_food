---
/**
 * SiteFooter — Unified footer across every page.
 * Columns: brand / products / company / contact.
 */
import type { Locale } from '@/i18n';
import { t, localePath } from '@/i18n';
import { brand } from '@/lib/brand';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
---

<footer class="w-full bg-surface-low py-12">
  <div class="mx-auto grid max-w-7xl grid-cols-2 gap-10 px-6 md:grid-cols-4 md:px-8">
    <div class="col-span-2 md:col-span-1">
      <a href={localePath('/', locale)} class="mb-2 inline-flex items-center gap-2">
        <img src="/logos/logo-teal.svg" alt="" width="56" height="56" class="h-14 w-14" />
        <span class="font-serif text-2xl font-bold text-teal">
          Kismet <span class="text-orange">Foods</span>
        </span>
      </a>
      <p class="text-sm leading-relaxed text-on-surface-subtle">
        {tr.footer.tagline}
      </p>
    </div>

    <div>
      <h4 class="eyebrow mb-4 text-on-surface">{tr.nav.products}</h4>
      <ul class="space-y-2.5">
        <li><a href={localePath('/products/', locale)} class="text-sm text-on-surface-subtle hover:text-teal">{tr.categories.coffee}</a></li>
        <li><a href={localePath('/products/', locale)} class="text-sm text-on-surface-subtle hover:text-teal">{tr.categories.nuts}</a></li>
        <li><a href={localePath('/products/', locale)} class="text-sm text-on-surface-subtle hover:text-teal">{tr.categories.spices}</a></li>
        <li><a href={localePath('/products/', locale)} class="text-sm text-on-surface-subtle hover:text-teal">{tr.categories.industrialIngredients}</a></li>
      </ul>
    </div>

    <div>
      <h4 class="eyebrow mb-4 text-on-surface">{tr.footer.companyTitle}</h4>
      <ul class="space-y-2.5">
        <li><a href={localePath('/about/', locale)} class="text-sm text-on-surface-subtle hover:text-teal">{tr.nav.about}</a></li>
        <li><a href={localePath('/heritage/', locale)} class="text-sm text-on-surface-subtle hover:text-teal">{tr.nav.heritage}</a></li>
        <li><a href={localePath('/sustainability/', locale)} class="text-sm text-on-surface-subtle hover:text-teal">{tr.nav.sustainability}</a></li>
        <li><a href={localePath('/insights/', locale)} class="text-sm text-on-surface-subtle hover:text-teal">{tr.nav.insights}</a></li>
        <li><a href={localePath('/careers/', locale)} class="text-sm text-on-surface-subtle hover:text-teal">{tr.nav.careers}</a></li>
      </ul>
    </div>

    <div>
      <h4 class="eyebrow mb-4 text-on-surface">{tr.nav.contact}</h4>
      <ul class="space-y-2.5 text-sm text-on-surface-subtle">
        <li>
          <span>
            {locale === 'tr' && 'E-posta: yakında'}
            {locale === 'en' && 'Email: coming soon'}
            {locale === 'ar' && 'البريد الإلكتروني: قريباً'}
          </span>
        </li>
        <li class="leading-relaxed">
          {brand.address.street}<br />
          {brand.address.postalCode} {brand.address.district}<br />
          {brand.address.city} / {brand.address.countryName}
        </li>
      </ul>
    </div>
  </div>

  <div
    class="mx-auto mt-12 flex max-w-7xl flex-col items-center gap-4 border-t border-outline/20 px-6 pt-6 md:flex-row md:justify-between md:px-8"
  >
    <p class="eyebrow text-on-surface-subtle">
      {tr.footer.copyright}
    </p>
    <div class="flex flex-wrap gap-4 md:gap-6">
      <span class="eyebrow text-[10px] text-on-surface-subtle">ISO 9001</span>
      <span class="eyebrow text-[10px] text-on-surface-subtle">Fair Trade</span>
      <span class="eyebrow text-[10px] text-on-surface-subtle">USDA Organic</span>
      <a href={localePath('/privacy/', locale)} class="eyebrow text-[10px] text-on-surface-subtle hover:text-teal">
        {tr.footer.companyLinkPrivacy}
      </a>
      <a href={localePath('/privacy/', locale)} class="eyebrow text-[10px] text-on-surface-subtle hover:text-teal">
        {tr.footer.companyLinkTerms}
      </a>
    </div>
  </div>
</footer>
