---
/**
 * CoffeeFramePlayer - Full-screen canvas-based frame sequence animation.
 * Auto-plays coffee bean grinder frames in a loop. No scroll interaction.
 *
 * Frames are pre-loaded, then drawn to a canvas at a target FPS.
 * Plays forward then reverse for a seamless ping-pong loop.
 */
interface Props {
  /** Total number of frames */
  frameCount?: number;
  /** Frames per second */
  fps?: number;
  /** Base path to frame images (without trailing slash) */
  basePath?: string;
  /** Frame filename prefix */
  prefix?: string;
}

const {
  frameCount = 21,
  fps = 12,
  basePath = '/frames/coffee-beans',
  prefix = 'coffe-beans-frame',
} = Astro.props;

// Generate frame URLs for preloading
const frameUrls = Array.from({ length: frameCount }, (_, i) => {
  const num = String(i + 1).padStart(3, '0');
  return `${basePath}/${prefix}-${num}.jpg`;
});
---

<div class="coffee-player" data-fps={fps}>
  <canvas class="coffee-canvas"></canvas>
  {/* Preload hint for all frames */}
  {frameUrls.map((url) => <link rel="preload" as="image" href={url} />)}
</div>

<script is:inline define:vars={{ frameUrls, fps }}>
  // Runs client-side
  const container = document.querySelector('.coffee-player');
  const canvas = document.querySelector('.coffee-canvas');
  if (!canvas || !container) throw new Error('Canvas not found');

  const ctx = canvas.getContext('2d');
  const images = [];
  let loaded = 0;
  let currentFrame = 0;
  let direction = 1; // 1 = forward, -1 = reverse (ping-pong)
  let lastFrameTime = 0;
  const frameDuration = 1000 / fps;

  // Resize canvas to fill container
  function resize() {
    const dpr = window.devicePixelRatio || 1;
    const rect = container.getBoundingClientRect();
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    drawFrame(currentFrame);
  }

  // Draw a frame with cover-fit
  function drawFrame(index) {
    const img = images[index];
    if (!img || !img.complete) return;

    const cw = canvas.width / (window.devicePixelRatio || 1);
    const ch = canvas.height / (window.devicePixelRatio || 1);
    const iw = img.naturalWidth;
    const ih = img.naturalHeight;

    // Cover fit
    const scale = Math.max(cw / iw, ch / ih);
    const w = iw * scale;
    const h = ih * scale;
    const x = (cw - w) / 2;
    const y = (ch - h) / 2;

    ctx.clearRect(0, 0, cw, ch);
    ctx.drawImage(img, x, y, w, h);
  }

  // Animation loop
  function animate(timestamp) {
    if (timestamp - lastFrameTime >= frameDuration) {
      lastFrameTime = timestamp;
      drawFrame(currentFrame);

      currentFrame += direction;

      // Ping-pong at boundaries
      if (currentFrame >= images.length) {
        currentFrame = images.length - 2;
        direction = -1;
      } else if (currentFrame < 0) {
        currentFrame = 1;
        direction = 1;
      }
    }
    requestAnimationFrame(animate);
  }

  // Load all frames
  frameUrls.forEach((url, i) => {
    const img = new Image();
    img.src = url;
    img.onload = () => {
      loaded++;
      if (loaded === frameUrls.length) {
        resize();
        requestAnimationFrame(animate);
      }
    };
    images[i] = img;
  });

  window.addEventListener('resize', resize);
</script>

<style>
  .coffee-player {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .coffee-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
