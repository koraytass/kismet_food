---
/**
 * BaseLayout — Corporate (v3, LDC-grade boardroom).
 *
 * - HTML lang/dir + RTL Arapça
 * - Self-hosted fontlar (Inter Tight + Source Serif + Source Sans + Noto Arabic + JetBrains Mono)
 * - Global Tailwind CSS + corporate.css design tokens
 * - Body sınıfı `co` → tüm Corp primitives çalışır
 */
import { localeConfig, type Locale } from '@/i18n';
import '@/styles/global.css';
import '@/styles/corporate.css';

import '@fontsource-variable/inter-tight';
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/source-sans-3';
import '@fontsource-variable/noto-sans-arabic';
import '@fontsource-variable/jetbrains-mono';

interface Props {
  locale: Locale;
  class?: string;
  themeColor?: string;
}

const { locale, class: bodyClass, themeColor } = Astro.props;
const { dir, hreflang } = localeConfig[locale];
---

<!doctype html>
<html lang={hreflang} dir={dir} class={bodyClass}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <link id="favicon" rel="icon" type="image/svg+xml" href="/favicon-teal.svg" />
    <script is:inline>
      (function () {
        const link = document.getElementById('favicon');
        if (!link) return;
        const srcs = ['/favicon-teal.svg', '/favicon-orange.svg'];
        let i = 0;
        setInterval(() => {
          i = (i + 1) % srcs.length;
          link.href = srcs[i];
        }, 3000);
      })();
    </script>
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={themeColor ?? '#0c2545'} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <slot name="head" />
  </head>
  <body class:list={['co flex min-h-dvh flex-col', bodyClass]}>
    <slot />
  </body>
</html>
