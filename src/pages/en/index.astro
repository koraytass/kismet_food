---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SEOHead from '@/components/SEOHead.astro';
import CorpHome from '@/components/v3/CorpHome.astro';
import { t } from '@/i18n';
import { organizationSchema, webSiteSchema } from '@/lib/schema';

const locale = 'en';
const translations = t(locale);
const jsonLd = [organizationSchema(locale), webSiteSchema()];
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <SEOHead
      title={translations.meta.title}
      description={translations.meta.description}
      locale={locale}
      pathname="/en/"
      ogTitle={translations.meta.ogTitle}
      ogDescription={translations.meta.ogDescription}
      jsonLd={jsonLd}
    />
  </Fragment>

  <CorpHome locale={locale} currentPath={Astro.url.pathname} />
</BaseLayout>
