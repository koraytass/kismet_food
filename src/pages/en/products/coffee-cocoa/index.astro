---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SEOHead from '@/components/SEOHead.astro';
import CoffeeCocoaPage from '@/components/pages/CoffeeCocoaPage.astro';
import {
  organizationSchema,
  webSiteSchema,
  webPageSchema,
  breadcrumbSchema,
  productCategorySchema,
} from '@/lib/schema';

const locale = 'en';
const pathname = '/en/products/coffee-cocoa/';
const title = 'Coffee & Cocoa | Kismet Foods — Specialty Arabica & Fermented Cocoa Supply';
const description =
  'Kismet Foods offers years of expertise in coffee and cocoa trade: Ethiopian Sidamo Arabica, Ghanaian Forastero cocoa, ISO-aligned testing and direct-trade relationships.';

const jsonLd = [
  organizationSchema(locale),
  webSiteSchema(),
  webPageSchema({
    locale,
    url: pathname,
    title,
    description,
    keywords: [
      'green coffee beans',
      'specialty coffee',
      'Ethiopian Sidamo',
      'Ghana cocoa',
      'Forastero cocoa',
      'direct trade',
      'fermented cocoa',
      'ISO 6673',
    ],
  }),
  breadcrumbSchema([
    { name: 'Kismet Foods', url: '/en/' },
    { name: 'Products', url: '/en/products/' },
    { name: 'Coffee & Cocoa', url: pathname },
  ]),
  productCategorySchema({
    name: 'Green Arabica Coffee Beans',
    description:
      'Specialty-grade (80+ SCAA) green Arabica from Ethiopian Sidamo, harvested above 1,500 m. Floral, citrusy acidity with a tea-like body.',
    url: pathname,
    category: 'Green Coffee Beans',
    origin: ['Ethiopia', 'Colombia', 'Indonesia'],
  }),
  productCategorySchema({
    name: 'Fermented Cocoa Beans',
    description:
      'Forastero cocoa from Ghana and Côte d’Ivoire. 52–56% fat content, deep chocolate notes, premium quality for industrial and specialty production.',
    url: pathname,
    category: 'Dried Cocoa Beans',
    origin: ['Ghana', 'Côte d’Ivoire'],
  }),
];
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <SEOHead
      title={title}
      description={description}
      locale={locale}
      pathname={pathname}
      ogTitle={title}
      ogDescription={description}
      jsonLd={jsonLd}
    />
  </Fragment>

  <CoffeeCocoaPage locale={locale} currentPath={pathname} />
</BaseLayout>
