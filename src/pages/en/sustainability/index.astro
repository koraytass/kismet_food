---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SEOHead from '@/components/SEOHead.astro';
import SustainabilityPage from '@/components/pages/SustainabilityPage.astro';
import {
  organizationSchema,
  webSiteSchema,
  webPageSchema,
  breadcrumbSchema,
} from '@/lib/schema';

const locale = 'en';
const pathname = '/en/sustainability/';
const title = 'Sustainability & Impact | Kismet Foods';
const description =
  'Kismet Foods sustainability: 5,000+ farmers across 12 countries, plastic-neutral shipping, bio-based packaging, and a 2030 zero-waste target — expertise proven in every product group.';
const jsonLd = [
  organizationSchema(locale),
  webSiteSchema(),
  webPageSchema({ locale, url: pathname, title, description }),
  breadcrumbSchema([
    { name: 'Kismet Foods', url: '/en/' },
    { name: 'Sustainability', url: pathname },
  ]),
];
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <SEOHead
      title={title}
      description={description}
      locale={locale}
      pathname={pathname}
      ogTitle={title}
      ogDescription={description}
      jsonLd={jsonLd}
    />
  </Fragment>

  <SustainabilityPage locale={locale} currentPath={pathname} />
</BaseLayout>
