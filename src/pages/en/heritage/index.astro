---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SEOHead from '@/components/SEOHead.astro';
import HeritagePage from '@/components/pages/HeritagePage.astro';
import {
  organizationSchema,
  webSiteSchema,
  webPageSchema,
  breadcrumbSchema,
} from '@/lib/schema';

const locale = 'en';
const pathname = '/en/heritage/';
const title = 'Heritage & Roots | Kismet Foods';
const description =
  'Kismet Foods is the modern steward of Türkiye’s two-thousand-year Silk Road trading heritage. Decades of accumulated expertise across coffee, cocoa, nuts, spices and raw-food commodities.';
const jsonLd = [
  organizationSchema(locale),
  webSiteSchema(),
  webPageSchema({
    locale,
    url: pathname,
    title,
    description,
    keywords: [
      'Silk Road heritage',
      'Turkish food trade history',
      'Kismet Foods heritage',
      'decades of trade expertise',
      'origin-direct sourcing',
    ],
  }),
  breadcrumbSchema([
    { name: 'Kismet Foods', url: '/en/' },
    { name: 'Heritage', url: pathname },
  ]),
];
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <SEOHead
      title={title}
      description={description}
      locale={locale}
      pathname={pathname}
      ogTitle={title}
      ogDescription={description}
      jsonLd={jsonLd}
    />
  </Fragment>

  <HeritagePage locale={locale} currentPath={pathname} />
</BaseLayout>
