---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SEOHead from '@/components/SEOHead.astro';
import PrivacyPage from '@/components/pages/PrivacyPage.astro';
import {
  organizationSchema,
  webSiteSchema,
  webPageSchema,
  breadcrumbSchema,
} from '@/lib/schema';

const locale = 'en';
const pathname = '/en/privacy/';
const title = 'Privacy & Terms | Kismet Foods';
const description =
  'Kismet Foods privacy policy and terms of service. Years of professional trade practice and deep operational expertise underpin GDPR- and KVKK-compliant data handling.';
const jsonLd = [
  organizationSchema(locale),
  webSiteSchema(),
  webPageSchema({ locale, url: pathname, title, description, keywords: ['privacy', 'GDPR', 'KVKK', 'terms of service'] }),
  breadcrumbSchema([
    { name: 'Kismet Foods', url: '/en/' },
    { name: 'Privacy & Terms', url: pathname },
  ]),
];
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <SEOHead
      title={title}
      description={description}
      locale={locale}
      pathname={pathname}
      ogTitle={title}
      ogDescription={description}
      jsonLd={jsonLd}
    />
  </Fragment>

  <PrivacyPage locale={locale} currentPath={pathname} />
</BaseLayout>
