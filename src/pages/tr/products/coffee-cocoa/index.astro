---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SEOHead from '@/components/SEOHead.astro';
import CoffeeCocoaPage from '@/components/pages/CoffeeCocoaPage.astro';
import {
  organizationSchema,
  webSiteSchema,
  webPageSchema,
  breadcrumbSchema,
  productCategorySchema,
} from '@/lib/schema';

const locale = 'tr';
const pathname = '/tr/products/coffee-cocoa/';
const title = 'Kahve & Kakao | Kısmet Foods — Spesiyalite Arabica ve Fermente Kakao Tedariği';
const description =
  'Kısmet Foods kahve ve kakao ticaretinde yıllara yayılmış uzmanlık sunar: Etiyopya Sidamo Arabica, Gana Forastero, ISO test standartları ve doğrudan ticaret ilişkileri.';

const jsonLd = [
  organizationSchema(locale),
  webSiteSchema(),
  webPageSchema({
    locale,
    url: pathname,
    title,
    description,
    keywords: [
      'yeşil kahve çekirdeği',
      'spesiyalite kahve',
      'Etiyopya Sidamo',
      'Gana kakao',
      'Forastero kakao',
      'doğrudan ticaret',
      'fermente kakao',
      'ISO 6673',
    ],
  }),
  breadcrumbSchema([
    { name: 'Kısmet Foods', url: '/tr/' },
    { name: 'Ürünler', url: '/tr/products/' },
    { name: 'Kahve & Kakao', url: pathname },
  ]),
  productCategorySchema({
    name: 'Yeşil Arabica Kahve Çekirdeği',
    description:
      'Etiyopya Sidamo menşeli, 1.500 metre üzeri rakımlardan hasat edilen spesiyalite sınıfı (80+ SCAA) yeşil Arabica çekirdek. Çiçeksi, narenciye tonlu asidite ve çay gibi gövde.',
    url: pathname,
    category: 'Green Coffee Beans',
    origin: ['Ethiopia', 'Colombia', 'Indonesia'],
  }),
  productCategorySchema({
    name: 'Fermente Kakao Çekirdeği',
    description:
      'Gana ve Fildişi menşeli Forastero kakao. %52–%56 yağ içeriği, derin çikolata notaları, endüstriyel ve spesiyalite üretim için premium kalite.',
    url: pathname,
    category: 'Dried Cocoa Beans',
    origin: ['Ghana', 'Côte d’Ivoire'],
  }),
];
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <SEOHead
      title={title}
      description={description}
      locale={locale}
      pathname={pathname}
      ogTitle={title}
      ogDescription={description}
      jsonLd={jsonLd}
    />
  </Fragment>

  <CoffeeCocoaPage locale={locale} currentPath={pathname} />
</BaseLayout>
