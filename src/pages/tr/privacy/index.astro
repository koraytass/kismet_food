---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SEOHead from '@/components/SEOHead.astro';
import PrivacyPage from '@/components/pages/PrivacyPage.astro';
import {
  organizationSchema,
  webSiteSchema,
  webPageSchema,
  breadcrumbSchema,
} from '@/lib/schema';

const locale = 'tr';
const pathname = '/tr/privacy/';
const title = 'Gizlilik & Şartlar | Kısmet Foods';
const description =
  'Kısmet Foods gizlilik politikası ve kullanım şartları. Yılların birikimiyle şekillenen profesyonel uzmanlığımız GDPR ve KVKK uyumlu veri yönetimini garanti eder.';
const jsonLd = [
  organizationSchema(locale),
  webSiteSchema(),
  webPageSchema({ locale, url: pathname, title, description, keywords: ['gizlilik', 'KVKK', 'GDPR', 'kullanım şartları'] }),
  breadcrumbSchema([
    { name: 'Kısmet Foods', url: '/tr/' },
    { name: 'Gizlilik & Şartlar', url: pathname },
  ]),
];
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <SEOHead
      title={title}
      description={description}
      locale={locale}
      pathname={pathname}
      ogTitle={title}
      ogDescription={description}
      jsonLd={jsonLd}
    />
  </Fragment>

  <PrivacyPage locale={locale} currentPath={pathname} />
</BaseLayout>
