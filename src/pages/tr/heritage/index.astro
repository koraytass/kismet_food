---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SEOHead from '@/components/SEOHead.astro';
import HeritagePage from '@/components/pages/HeritagePage.astro';
import {
  organizationSchema,
  webSiteSchema,
  webPageSchema,
  breadcrumbSchema,
} from '@/lib/schema';

const locale = 'tr';
const pathname = '/tr/heritage/';
const title = 'Mirasımız | Kısmet Foods';
const description =
  'Kısmet Foods; Türkiye’nin iki bin yıllık İpek Yolu ticaret mirasının modern taşıyıcısıdır. Kahveden kakaoya her ürün grubunda yıllara yayılmış uzman kadro ve profesyonel menşe takibi.';
const jsonLd = [
  organizationSchema(locale),
  webSiteSchema(),
  webPageSchema({
    locale,
    url: pathname,
    title,
    description,
    keywords: [
      'İpek Yolu mirası',
      'Türkiye gıda ticareti',
      'Kısmet Foods miras',
      'yıllara yayılmış uzmanlık',
      'kahve kakao tedarik',
    ],
  }),
  breadcrumbSchema([
    { name: 'Kısmet Foods', url: '/tr/' },
    { name: 'Mirasımız', url: pathname },
  ]),
];
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <SEOHead
      title={title}
      description={description}
      locale={locale}
      pathname={pathname}
      ogTitle={title}
      ogDescription={description}
      jsonLd={jsonLd}
    />
  </Fragment>

  <HeritagePage locale={locale} currentPath={pathname} />
</BaseLayout>
