---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SEOHead from '@/components/SEOHead.astro';
import AboutPage from '@/components/pages/AboutPage.astro';
import {
  organizationSchema,
  webSiteSchema,
  aboutPageSchema,
  breadcrumbSchema,
} from '@/lib/schema';

const locale = 'ar';
const pathname = '/ar/about/';
const title = 'من نحن | كسمت فودز';
const description =
  'كسمت فودز شركة دولية لتوريد الأغذية مقرها إسطنبول، تمتلك سنوات من الخبرة التشغيلية العميقة في القهوة والكاكاو والمكسرات والتوابل والمكونات الخام.';
const jsonLd = [
  organizationSchema(locale),
  webSiteSchema(),
  aboutPageSchema({ locale, url: pathname, title, description }),
  breadcrumbSchema([
    { name: 'كسمت فودز', url: '/ar/' },
    { name: 'من نحن', url: pathname },
  ]),
];
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <SEOHead
      title={title}
      description={description}
      locale={locale}
      pathname={pathname}
      ogTitle={title}
      ogDescription={description}
      jsonLd={jsonLd}
    />
  </Fragment>

  <AboutPage locale={locale} currentPath={pathname} />
</BaseLayout>
