---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SEOHead from '@/components/SEOHead.astro';
import PrivacyPage from '@/components/pages/PrivacyPage.astro';
import {
  organizationSchema,
  webSiteSchema,
  webPageSchema,
  breadcrumbSchema,
} from '@/lib/schema';

const locale = 'ar';
const pathname = '/ar/privacy/';
const title = 'الخصوصية والشروط | كسمت فودز';
const description =
  'سياسة خصوصية كسمت فودز وشروط خدمتها. سنوات من الممارسة التجارية الاحترافية والخبرة التشغيلية العميقة تضمن إدارة بيانات متوافقة مع GDPR وKVKK.';
const jsonLd = [
  organizationSchema(locale),
  webSiteSchema(),
  webPageSchema({ locale, url: pathname, title, description, keywords: ['الخصوصية', 'GDPR', 'KVKK', 'شروط الخدمة'] }),
  breadcrumbSchema([
    { name: 'كسمت فودز', url: '/ar/' },
    { name: 'الخصوصية والشروط', url: pathname },
  ]),
];
---

<BaseLayout locale={locale}>
  <Fragment slot="head">
    <SEOHead
      title={title}
      description={description}
      locale={locale}
      pathname={pathname}
      ogTitle={title}
      ogDescription={description}
      jsonLd={jsonLd}
    />
  </Fragment>

  <PrivacyPage locale={locale} currentPath={pathname} />
</BaseLayout>
