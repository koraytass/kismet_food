---
/**
 * 404 — minimal Kismet-styled not-found page.
 *
 * No longer redirects to /tr/soon/ (was an under-construction
 * shortcut that interfered with normal navigation). The
 * production soon-gate lives in vercel.json with a cookie bypass.
 */
export const prerender = true;

const homeHref = '/tr/';
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>404 · Kismet Foods</title>
    <style>
      /* 404 is a prerendered standalone page that does NOT include global.css.
         Token values below mirror src/styles/global.css — keep in sync. */
      :root {
        color-scheme: light;
        --color-surface: #faf9f8;
        --color-on-surface: #1a1c1c;
        --color-on-surface-muted: #3c4949;
        --color-teal: #00acaf;
        --color-orange: #f68b5c;
        --font-sans: 'Source Sans 3 Variable', 'Source Sans 3', 'Helvetica Neue', 'Arial', sans-serif;
        --font-serif: 'Source Serif 4 Variable', 'Source Serif 4', 'Georgia', serif;
      }
      html,
      body {
        margin: 0;
        padding: 0;
        background: var(--color-surface);
        color: var(--color-on-surface);
        font-family: var(--font-sans);
      }
      .wrap {
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
      }
      .card {
        text-align: center;
        max-width: 32rem;
      }
      .eyebrow {
        font-family: var(--font-sans);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.32em;
        text-transform: uppercase;
        color: var(--color-orange);
      }
      h1 {
        font-family: var(--font-serif);
        font-size: clamp(2.25rem, 6vw, 3.5rem);
        margin: 1rem 0 0.5rem;
        letter-spacing: -0.02em;
        line-height: 1.05;
        color: var(--color-teal);
      }
      p {
        color: var(--color-on-surface-muted);
        line-height: 1.6;
        margin: 0 auto 2rem;
        max-width: 28rem;
      }
      a.home {
        display: inline-block;
        padding: 0.85rem 1.5rem;
        font-family: var(--font-sans);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: #fff;
        background: var(--color-teal);
        text-decoration: none;
        transition: background-color 280ms cubic-bezier(0.22, 0.72, 0.22, 1);
      }
      a.home:hover {
        background: var(--color-orange);
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <div class="card">
        <span class="eyebrow">404 · sayfa bulunamadı</span>
        <h1>Aradığın yol burada yok.</h1>
        <p>
          Bağlantı eski olabilir ya da yanlış yazılmış olabilir. Ana sayfaya dönüp tekrar
          deneyebilirsin.
        </p>
        <a class="home" href={homeHref}>Ana Sayfa</a>
      </div>
    </div>
  </body>
</html>
